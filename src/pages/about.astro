---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import AboutGlyph, { type GlyphName } from "../components/AboutGlyph.astro";
import cntl from "cntl";
import bawakaraeng from "../assets/images/landscapes/handika-bawakaraeng.webp";
import napu from "../assets/images/animals/inaturalist_615649674-napu.jpg";
import peromyscus from "../assets/images/animals/handika-peromyscus_sp.webp";
import flyingFrog from "../assets/images/animals/handika-malayan-flying-frog.webp";

import "../styles/global.css";
import "../styles/landing.css";

const sectionClasses = cntl`
  px-6 py-16 sm:py-20
`;

const innerClasses = cntl`
  mx-auto max-w-5xl
`;

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const titleClasses = cntl`
  mt-3 text-3xl sm:text-4xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const leadClasses = cntl`
  mt-4
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const cardClasses = cntl`
  nh-reveal
  rounded-2xl
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-50/70 dark:bg-silver-tree-900/50
  p-6
`;

const cardTitleClasses = cntl`
  text-lg font-semibold
  text-silver-tree-900 dark:text-silver-tree-50
`;

const cardBodyClasses = cntl`
  mt-3 text-sm leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const linkClasses = cntl`
  text-silver-tree-700 dark:text-silver-tree-200
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-900 dark:hover:text-silver-tree-50
`;

const catalogFormats = [
    { name: "Mammalogy", status: "Available" },
    { name: "Ornithology", status: "Available" },
    { name: "Herpetology", status: "Available" },
    { name: "Invertebrate zoology", status: "Beta" },
    { name: "Ichthyology", status: "In development" },
    { name: "Paleontology", status: "In development" },
    { name: "Marine invertebrates", status: "In development" },
];

interface Highlight {
    glyph: GlyphName;
    title: string;
    body: string;
    link?: { href: string; label: string };
}

const mission: Highlight[] = [
    {
        glyph: "fieldwork",
        title: "Simplify complex fieldwork",
        body: "NAHPU is designed with genomic studies and remote fieldwork in mind. It simplifies associating digital assets, such as photographs or audio recordings and features fields to keep track tissue quality. Built with high-performance programming languages and frameworks, NAHPU runs smoothly across a wide range of devices while minimizing battery usage.",
    },
    {
        glyph: "responsible",
        title: "Support responsible and reproducible research",
        body: "NAHPU records detailed information about collected specimens, including their origin, collection date, site, measurements, field personnel, and collection method. Real-time statistics help you monitor collecting activities and make informed decisions to prevent over-collection and collector bias, keeping fieldwork both responsible and reproducible.",
    },
    {
        glyph: "sharing",
        title: "Promote data sharing and collaboration",
        body: "By adhering to open standards, NAHPU enables data sharing and supports automatic pipelines for transferring records from the field to museum databases, and data analytics using standard formats.",
    },
    {
        glyph: "accessible",
        title: "Accessible for everyone",
        body: "NAHPU is free and open source on all major desktop and mobile platforms, and prioritizes usability for collectors and researchers. We are actively working on internationalization, including multi-language and locale support, and welcome contributors of all backgrounds.",
    },
];

const roadmap: Highlight[] = [
    {
        glyph: "taxonomy",
        title: "Wider taxonomic coverage",
        body: "Paleontology and marine invertebrate catalog formats are in active development, and we keep expanding the taxon lists behind every discipline, so field biologists working on other groups can use NAHPU for their own fieldwork.",
    },
    {
        glyph: "machine-learning",
        title: "Analysis as the data arrives",
        body: "Outlier detection, morphometric analysis, and deep learning image processing are in progress, with audio analytics next in line. All of it runs on the device as records are entered, so insights arrive during fieldwork.",
    },
    {
        glyph: "integrations",
        title: "Third-party resources",
        body: "External resources add context on the taxa you study, streamline taxon imports and validation, and support student learning. GenBank, Crossref, and the Mammal Diversity Database are among the resources we plan to integrate.",
        link: {
            href: "https://github.com/nahpu/kanchil",
            label: "Follow Kanchil’s progress on GitHub",
        },
    },
];
---

<Layout
    title="About NAHPU"
    description="Rethinking biodiversity inventories in the digital age."
    overlayNav
>
    <!-- Header -------------------------------------------------------------->
    <section
        class="nh-hero relative flex min-h-[60svh] items-end px-6 pt-32 pb-12"
    >
        <div class="nh-hero-bg" aria-hidden="true">
            <div class="nh-blob nh-blob-teal"></div>
            <div class="nh-blob nh-blob-gold"></div>
            <Image
                src={bawakaraeng}
                alt=""
                widths={[1200, 2400]}
                sizes="100vw"
                class="nh-hero-photo"
                loading="eager"
            />
            <div class="nh-hero-scrim"></div>
        </div>

        <div class={`${innerClasses} w-full`}>
            <p class={kickerClasses}>About the project</p>
            <h1
                class="mt-3 text-4xl font-bold text-silver-tree-950 sm:text-5xl dark:text-silver-tree-50"
            >
                Rethinking biodiversity inventories in the digital age
            </h1>
            <p
                class="mt-5 max-w-2xl text-lg text-silver-tree-800 dark:text-silver-tree-200"
            >
                NAHPU — <strong>NA</strong>tural <strong>H</strong>istory <strong
                    >P</strong
                >roject <strong>U</strong>tility — is a free, open-source
                digital field catalog for natural history collections,
                supporting major desktop and mobile operating systems.
            </p>
            <p
                class="mt-6 text-[11px] tracking-wide text-silver-tree-700 dark:text-silver-tree-400"
            >
                Taken on Mt. Bawakaraeng, Indonesia, by Heru Handika.
            </p>
        </div>
    </section>

    <!-- What it catalogs ----------------------------------------------------->
    <section
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={innerClasses}>
            <div
                class="grid grid-cols-1 gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start"
            >
                <div class="nh-reveal">
                    <p class={kickerClasses}>What NAHPU catalogs</p>
                    <h2 class={titleClasses}>Catalog formats by discipline</h2>
                    <p class={leadClasses}>
                        Specimen fields follow the conventions of each
                        discipline, and a single project can hold more than one
                        format. Three formats ship today, one is in beta,
                        and three more are in active development.
                    </p>

                    <ul class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
                        {
                            catalogFormats.map((format) => (
                                <li class="flex items-center justify-between gap-3 rounded-xl border border-silver-tree-300/70 bg-silver-tree-50/60 px-4 py-2.5 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/50">
                                    <span class="text-sm font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                        {format.name}
                                    </span>
                                    <span
                                        class={`rounded-full px-2.5 py-0.5 text-[11px] font-medium whitespace-nowrap ${
                                            format.status === "Available"
                                                ? "bg-silver-tree-200 text-silver-tree-800 dark:bg-silver-tree-800 dark:text-silver-tree-100"
                                                : format.status === "Beta"
                                                  ? "border border-silver-tree-400/80 text-silver-tree-800 dark:border-silver-tree-600/80 dark:text-silver-tree-100"
                                                  : "bg-golden-grass-100 text-golden-grass-900 dark:bg-golden-grass-950 dark:text-golden-grass-200"
                                        }`}
                                    >
                                        {format.status}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>

                    <h3
                        class="mt-10 text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50"
                    >
                        Etymology
                    </h3>
                    <p class={leadClasses}>
                        The name NAHPU is derived from the Greater Malay
                        Chevrotain, <a
                            class={linkClasses}
                            href="https://www.mammaldiversity.org/taxon/1006357/"
                            ><em>Tragulus napu</em></a
                        >, a small deer of the tropical forests of Southeast
                        Asia.
                    </p>
                </div>

                <figure
                    class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg dark:border-silver-tree-700/60"
                >
                    <Image
                        src={napu}
                        alt="A greater Malay chevrotain standing on the forest floor among fallen branches"
                        widths={[400, 800]}
                        sizes="(min-width: 1024px) 30vw, 92vw"
                        class="aspect-square h-auto w-full object-cover"
                        loading="lazy"
                    />
                    <figcaption
                        class="bg-silver-tree-200/70 px-4 py-2.5 text-xs text-silver-tree-800 dark:bg-silver-tree-900/70 dark:text-silver-tree-200"
                    >
                        Greater Malay Chevrotain, <em>Tragulus napu</em>
                        <span
                            class="mt-1 block text-[11px] text-silver-tree-700 dark:text-silver-tree-300"
                        >
                            © Ivan Neo, <a
                                class={linkClasses}
                                href="https://creativecommons.org/licenses/by-nc/4.0/"
                                >CC BY-NC</a
                            >, via <a
                                class={linkClasses}
                                href="https://www.inaturalist.org/photos/615649674"
                                >iNaturalist</a
                            >
                        </span>
                    </figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- Mission -------------------------------------------------------------->
    <section
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={innerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Our mission</p>
                <h2 class={titleClasses}>Four commitments</h2>
                <p class={leadClasses}>
                    NAHPU complies with the <a
                        class={linkClasses}
                        href="https://dwc.tdwg.org/">Darwin Core</a
                    > standard and follows the <a
                        class={linkClasses}
                        href="https://www.go-fair.org/">FAIR principles</a
                    > and <a
                        class={linkClasses}
                        href="https://frictionlessdata.io/">Frictionless Data</a
                    >. The app uses the <a
                        class={linkClasses}
                        href="https://m3.material.io/">Material Design</a
                    > system for a consistent interface across platforms and accommodates
                    users visual impairments and color blindness.
                </p>
            </header>

            <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
                {
                    mission.map((item, index) => (
                        <article
                            class={cardClasses}
                            style={`transition-delay: ${index * 60}ms`}
                        >
                            <AboutGlyph name={item.glyph} />
                            <h3 class={`${cardTitleClasses} mt-3`}>
                                {item.title}
                            </h3>
                            <p class={cardBodyClasses}>{item.body}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Roadmap -------------------------------------------------------------->
    <section
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={innerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Looking ahead</p>
                <h2 class={titleClasses}>Development roadmap for 2026</h2>
            </header>

            <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
                {
                    roadmap.map((item, index) => (
                        <article
                            class={cardClasses}
                            style={`transition-delay: ${index * 60}ms`}
                        >
                            <AboutGlyph name={item.glyph} />
                            <h3 class={`${cardTitleClasses} mt-3`}>
                                {item.title}
                            </h3>
                            <p class={cardBodyClasses}>{item.body}</p>
                            {item.link && (
                                <p class="mt-3 text-sm">
                                    <a
                                        class={linkClasses}
                                        href={item.link.href}
                                    >
                                        {item.link.label}
                                    </a>
                                </p>
                            )}
                        </article>
                    ))
                }
            </div>

            <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <figure
                    class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg sm:col-span-2 dark:border-silver-tree-700/60"
                >
                    <Image
                        src={peromyscus}
                        alt="A deer mouse on a branch, whiskers lit by the sun"
                        widths={[400, 800]}
                        sizes="(min-width: 640px) 60vw, 92vw"
                        class="aspect-[3/2] w-full object-cover"
                        loading="lazy"
                    />
                </figure>
                <figure
                    class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg dark:border-silver-tree-700/60"
                >
                    <Image
                        src={flyingFrog}
                        alt="A green flying frog gripping a thin branch at night"
                        widths={[400, 800]}
                        sizes="(min-width: 640px) 30vw, 92vw"
                        class="aspect-[3/2] w-full object-cover sm:aspect-auto sm:h-full"
                        loading="lazy"
                    />
                </figure>
            </div>
            <p
                class="mt-4 text-xs text-silver-tree-600 dark:text-silver-tree-400"
            >
                Photographs by Heru Handika.
            </p>
        </div>
    </section>
</Layout>

<script>
    const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
        revealed.forEach((element) => element.classList.add("nh-in"));
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("nh-in");
                    observer.unobserve(entry.target);
                });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );
        revealed.forEach((element) => observer.observe(element));
    }
</script>
