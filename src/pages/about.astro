---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import AboutGlyph, { type GlyphName } from "../components/AboutGlyph.astro";
import AboutLayers from "../components/AboutLayers.astro";
import cntl from "cntl";
import bawakaraeng from "../assets/images/landscapes/handika-bawakaraeng.webp";
import napu from "../assets/images/animals/inaturalist_615649674-napu.jpg";
import peromyscus from "../assets/images/animals/handika-peromyscus_sp.webp";
import flyingFrog from "../assets/images/animals/handika-malayan-flying-frog.webp";

import "../styles/global.css";
import "../styles/landing.css";

const sectionClasses = cntl`
  px-6 py-16 sm:py-20
`;

const innerClasses = cntl`
  mx-auto max-w-5xl
`;

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const titleClasses = cntl`
  mt-3 text-3xl sm:text-4xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const leadClasses = cntl`
  mt-4
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const cardClasses = cntl`
  nh-reveal
  rounded-2xl
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-50/70 dark:bg-silver-tree-900/50
  p-6
`;

const cardTitleClasses = cntl`
  text-lg font-semibold
  text-silver-tree-900 dark:text-silver-tree-50
`;

const cardBodyClasses = cntl`
  mt-3 text-sm leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const linkClasses = cntl`
  text-silver-tree-700 dark:text-silver-tree-200
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-900 dark:hover:text-silver-tree-50
`;

const catalogFormats = [
  { name: "Mammalogy", status: "Available" },
  { name: "Ornithology", status: "Available" },
  { name: "Herpetology", status: "Beta" },
  { name: "Invertebrate zoology", status: "Beta" },
  { name: "Ichthyology", status: "Beta" },
  { name: "Paleontology", status: "In development" },
];

interface Highlight {
  glyph: GlyphName;
  title: string;
  body: string;
  link?: { href: string; label: string };
  contact?: EmailContact;
}

// The address is stored reversed and split, then assembled in the browser, so
// it never appears whole in the source or the generated HTML.
interface EmailContact {
  label: string;
  user: string;
  domain: string;
}

const mission: Highlight[] = [
  {
    glyph: "fieldwork",
    title: "Simplify complex fieldwork",
    body: "NAHPU is designed with genomic studies, parasite surveillance of non-model organisms, and remote fieldwork in mind. It simplifies associating digital assets, such as photographs or audio recordings and features fields to keep track tissue quality and symbiont information. Built with high-performance programming languages and frameworks, NAHPU runs smoothly across a wide range of devices while minimizing battery usage.",
  },
  {
    glyph: "responsible",
    title: "Support responsible and reproducible research",
    body: "NAHPU records detailed information about collected specimens, including sites, collection dates, measurements, associated specimen parts and preservation, field personnel, and collection methods. Real-time statistics help you monitor collecting activities and make informed decisions to prevent over-collection and collector bias. Shareable controlled vocabularies and app configurations keep every device, collaborator, and data user on the same standards. Together, these features support responsible and reproducible research.",
  },
  {
    glyph: "sharing",
    title: "Promote data sharing and protect privacy",
    body: "By adhering to open standards, NAHPU enables data sharing and supports pipelines you can run to transfer records from the field to museum databases, and data analytics using standard formats. NAHPU works fully offline and keeps your data on your device. Nothing is shared or merged unless you choose to export, share, or merge it.",
  },
  {
    glyph: "accessible",
    title: "Accessible for everyone",
    body: "NAHPU is free and open source on all major desktop and mobile platforms, and prioritizes usability for collectors and researchers. We are actively working on internationalization, including multi-language and locale support, and welcome contributors of all backgrounds.",
  },
];

const philosophy: Highlight[] = [
  {
    glyph: "field-first",
    title: "Fieldwork First",
    body: "Grounded in decades of experience in both field biology and software development, NAHPU incorporates expert input to design catalog formats and workflows tailored to different biological collections.",
  },
  {
    glyph: "purpose",
    title: "Design with Purpose",
    body: "Thoughtful aesthetics reduce visual fatigue, improve clarity, and ensure the most important information stands out first.",
  },
  {
    glyph: "performance",
    title: "Performance by Design",
    body: "We make deliberate engineering choices to maximize performance, resource efficiency, and long-term maintainability, even when they require sophisticated technical solutions.",
  },
];

const appLayers = [
  {
    number: "1",
    title: "User interface",
    tag: "Flutter",
    accent: "teal",
    body: "The screens, forms, maps, and controls shared across phones, tablets, and desktops, designed for clarity and low visual fatigue in the field.",
  },
  {
    number: "2",
    title: "Application workflows",
    tag: "Dart",
    accent: "teal",
    body: "Coordinates data entry, validation, and relationships across sites, collecting events, specimens, and media without requiring a network connection.",
  },
  {
    number: "3",
    title: "Core engine",
    tag: "Rust · NAHPU API",
    accent: "gold",
    body: "Handles computationally intensive tasks—Darwin Core exports, GIS conversions, PDF generation, archives, and upcoming on-device analytics—efficiently while conserving battery life.",
  },
  {
    number: "4",
    title: "Local storage",
    tag: "SQLite & files",
    accent: "teal",
    body: "Keeps the project database, media, and backups directly on the device, ensuring offline reliability and straightforward handoff to institutional collections.",
  },
];

const roadmap: Highlight[] = [
  {
    glyph: "taxonomy",
    title: "Wider taxonomic coverage",
    body: "The paleontology catalog format is in active development, and invertebrate zoology is expanding from terrestrial and freshwater taxa to marine invertebrates. If you are an expert in a taxon group NAHPU does not yet cover and would like to support its development, please reach out to us.",
    link: {
      href: "/teams",
      label: "Meet the NAHPU team",
    },
    contact: {
      label: "Email the project maintainer",
      user: "akidnahh",
      domain: "ude.lfu",
    },
  },
  {
    glyph: "machine-learning",
    title: "Real-time analytics",
    body: "Outlier detection, morphometric analysis, and deep learning image processing are in progress, with audio analytics next in line. All of it runs on the device as records are entered, so insights arrive during fieldwork.",
  },
  {
    glyph: "integrations",
    title: "Integrated resources",
    body: "Integrate external resources linked to the collected taxon, streamline taxon imports and validation, and support student learning. GenBank, Crossref, and the Mammal Diversity Database are among the resources we plan to integrate.",
    link: {
      href: "https://github.com/nahpu/kanchil",
      label: "Follow Kanchil’s progress on GitHub",
    },
  },
];

interface Milestone {
  date: Date;
  title: string;
  body: string;
  released: boolean;
}

// Planned entries list only work that has already started.
const timeline: Milestone[] = [
  {
    date: new Date(2022, 6, 18),
    title: "First commit",
    body: "Development of NAHPU begins on GitHub.",
    released: true,
  },
  {
    date: new Date(2026, 8, 7),
    title: "NAHPU v1.0.0",
    body: "First stable release, codename Tropical Mountains.",
    released: true,
  },
  {
    date: new Date(2026, 9, 18),
    title: "NAHPU v1.1.0",
    body: "Ichthyology catalog format for fish specimens, in beta.",
    released: true,
  },
  {
    date: new Date(2026, 9, 25),
    title: "NAHPU v1.2.0",
    body: "Data table view, batch import, tissue curation, and beta translations.",
    released: true,
  },
  {
    date: new Date(2026, 10, 8),
    title: "NAHPU v1.3.0",
    body: "Symbiont support with Darwin Core interaction types and resizable table columns.",
    released: true,
  },
  {
    date: new Date(2027, 0, 1),
    title: "Integrated resources",
    body: "Links to GenBank, Crossref, and the Mammal Diversity Database.",
    released: false,
  },
  {
    date: new Date(2027, 1, 1),
    title: "Morphometric analyses",
    body: "On-device analysis of specimen measurements.",
    released: false,
  },
  {
    date: new Date(2027, 2, 1),
    title: "Paleontology support",
    body: "Catalog format for fossil specimens.",
    released: false,
  },
  {
    date: new Date(2027, 3, 1),
    title: "Phenomic analyses",
    body: "Trait analyses using deep learning.",
    released: false,
  },
];

// Released milestones show the exact day ("18 Jul 2022"); planned ones only a
// target month ("Jan 2027").
const formatDate = (item: Milestone) => {
  const month = item.date.toLocaleDateString("en-US", { month: "short" });
  const monthYear = `${month} ${item.date.getFullYear()}`;
  return item.released ? `${item.date.getDate()} ${monthYear}` : monthYear;
};

const formatIsoDate = (item: Milestone) => {
  const month = `${item.date.getFullYear()}-${String(item.date.getMonth() + 1).padStart(2, "0")}`;
  return item.released
    ? `${month}-${String(item.date.getDate()).padStart(2, "0")}`
    : month;
};

const [firstCommit, stableRelease] = timeline;
const developmentMonths =
  (stableRelease.date.getFullYear() - firstCommit.date.getFullYear()) * 12 +
  stableRelease.date.getMonth() -
  firstCommit.date.getMonth();
const developmentYears = Math.floor(developmentMonths / 12);
const developmentRemainder = developmentMonths % 12;
const developmentSpan = [
  `${developmentYears} year${developmentYears === 1 ? "" : "s"}`,
  developmentRemainder > 0 &&
    `${developmentRemainder} month${developmentRemainder === 1 ? "" : "s"}`,
]
  .filter(Boolean)
  .join(", ");
const releasedMilestones = timeline.filter((item) => item.released);
const plannedMilestones = timeline.filter((item) => !item.released);
---

<Layout
  title="About NAHPU"
  description="Rethinking biodiversity inventories in the digital age."
  overlayNav
>
  <!-- Header -------------------------------------------------------------->
  <section
    class="nh-hero relative flex min-h-[60svh] items-end px-6 pt-32 pb-12"
  >
    <div class="nh-hero-bg" aria-hidden="true">
      <div class="nh-blob nh-blob-teal"></div>
      <div class="nh-blob nh-blob-gold"></div>
      <Image
        src={bawakaraeng}
        alt=""
        widths={[1200, 2400]}
        sizes="100vw"
        class="nh-hero-photo"
        loading="eager"
      />
      <div class="nh-hero-scrim"></div>
    </div>

    <div class={`${innerClasses} w-full`}>
      <p class={kickerClasses}>About the project</p>
      <h1
        class="mt-3 text-4xl font-bold text-silver-tree-950 sm:text-5xl dark:text-silver-tree-50"
      >
        Rethinking biodiversity inventories in the digital age
      </h1>
      <p
        class="mt-5 max-w-2xl text-lg text-silver-tree-800 dark:text-silver-tree-200"
      >
        NAHPU — <strong>NA</strong>tural <strong>H</strong>istory <strong
          >P</strong
        >roject <strong>U</strong>tility — is a free, open-source digital field
        catalog for natural history collections, supporting major desktop and
        mobile operating systems.
      </p>
      <p
        class="mt-6 text-[11px] tracking-wide text-silver-tree-700 dark:text-silver-tree-400"
      >
        Taken on Mt. Bawakaraeng, Indonesia, by Heru Handika.
      </p>
    </div>
  </section>

  <!-- What it catalogs ----------------------------------------------------->
  <section
    class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
  >
    <div class={innerClasses}>
      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start"
      >
        <div class="nh-reveal">
          <p class={kickerClasses}>What NAHPU catalogs</p>
          <h2 class={titleClasses}>Supported catalog formats</h2>
          <p class={leadClasses}>
            Specimen fields follow the conventions of each discipline, and a
            single project can hold more than one format. Two stable format are
            field tested, three are in beta, and one more is in active
            development. Invertebrate zoology currently focuses on terrestrial
            and freshwater taxa, and we are expanding it to marine
            invertebrates.
          </p>

          <ul class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {
              catalogFormats.map((format) => (
                <li class="flex items-center justify-between gap-3 rounded-xl border border-silver-tree-300/70 bg-silver-tree-50/60 px-4 py-2.5 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/50">
                  <span class="text-sm font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                    {format.name}
                  </span>
                  <span
                    class={`rounded-full px-2.5 py-0.5 text-[11px] font-medium whitespace-nowrap ${
                      format.status === "Available"
                        ? "bg-silver-tree-200 text-silver-tree-800 dark:bg-silver-tree-800 dark:text-silver-tree-100"
                        : format.status === "Beta"
                          ? "border border-silver-tree-400/80 text-silver-tree-800 dark:border-silver-tree-600/80 dark:text-silver-tree-100"
                          : "bg-golden-grass-100 text-golden-grass-900 dark:bg-golden-grass-950 dark:text-golden-grass-200"
                    }`}
                  >
                    {format.status}
                  </span>
                </li>
              ))
            }
          </ul>

          <h3
            class="mt-10 text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50"
          >
            Etymology
          </h3>
          <p class={leadClasses}>
            The name NAHPU is derived from the Greater Malay Chevrotain, <a
              class={linkClasses}
              href="https://www.mammaldiversity.org/taxon/1006357/"
              ><em>Tragulus napu</em></a
            >, a small deer of the tropical forests of Southeast Asia.
          </p>
          <p class={leadClasses}>
            NAHPU v1’s codename, &ldquo;Tropical Mountains,&rdquo; comes from
            NAHPU’s first real-world field test on Mt. Gede in West Java,
            Indonesia. The mountain also exemplifies the importance of
            biodiversity inventories, and the need for tools like NAHPU that aim
            to accelerate the discovery and documentation of biodiversity.
            Despite the mountain’s close proximity to Jakarta, <a
              class={linkClasses}
              href="https://www.theguardian.com/world/2025/nov/27/jakarta-overtakes-tokyo-most-populous-city-world"
              target="_blank"
              rel="noopener noreferrer">the world’s most populous city</a
            >, and to Indonesia’s largest natural history museum, <a
              class={linkClasses}
              href="https://brin.go.id/en/news/125996/home-to-millions-of-specimens-the-bogor-zoological-museum-preserves-southeast-asias-largest-faunal-collection"
              target="_blank"
              rel="noopener noreferrer">MZB</a
            >, undescribed species continue to be discovered there (noted in <a
              class={linkClasses}
              href="https://doi.org/10.1644/13-MAMM-A-215"
              target="_blank"
              rel="noopener noreferrer">Esselstyn et al., 2014</a
            > and <a
              class={linkClasses}
              href="https://doi.org/10.1093/jmammal/gyw183"
              target="_blank"
              rel="noopener noreferrer">Demos et al., 2017</a
            >).
          </p>
        </div>

        <figure
          class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg dark:border-silver-tree-700/60"
        >
          <Image
            src={napu}
            alt="A greater Malay chevrotain standing on the forest floor among fallen branches"
            widths={[400, 800]}
            sizes="(min-width: 1024px) 30vw, 92vw"
            class="aspect-square h-auto w-full object-cover"
            loading="lazy"
          />
          <figcaption
            class="bg-silver-tree-200/70 px-4 py-2.5 text-xs text-silver-tree-800 dark:bg-silver-tree-900/70 dark:text-silver-tree-200"
          >
            Greater Malay Chevrotain, <em>Tragulus napu</em>
            <span
              class="mt-1 block text-[11px] text-silver-tree-700 dark:text-silver-tree-300"
            >
              © Ivan Neo, <a
                class={linkClasses}
                href="https://creativecommons.org/licenses/by-nc/4.0/"
                >CC BY-NC</a
              >, via <a
                class={linkClasses}
                href="https://www.inaturalist.org/photos/615649674"
                >iNaturalist</a
              >
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Mission -------------------------------------------------------------->
  <section
    class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
  >
    <div class={innerClasses}>
      <header class="nh-reveal max-w-3xl">
        <p class={kickerClasses}>Our mission</p>
        <h2 class={titleClasses}>Four commitments</h2>
        <p class={leadClasses}>
          NAHPU complies with the <a
            class={linkClasses}
            href="https://dwc.tdwg.org/">Darwin Core</a
          > standard and follows the <a
            class={linkClasses}
            href="https://www.go-fair.org/">FAIR principles</a
          > and <a class={linkClasses} href="https://frictionlessdata.io/"
            >Frictionless Data</a
          >. The app uses the <a
            class={linkClasses}
            href="https://m3.material.io/">Material Design</a
          > system for a consistent interface across platforms and accommodates users
          visual impairments and color blindness.
        </p>
      </header>

      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          mission.map((item, index) => (
            <article
              class={cardClasses}
              style={`transition-delay: ${index * 60}ms`}
            >
              <AboutGlyph name={item.glyph} />
              <h3 class={`${cardTitleClasses} mt-3`}>{item.title}</h3>
              <p class={cardBodyClasses}>{item.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Development philosophy -->
      <header class="nh-reveal mt-16 max-w-3xl">
        <p class={kickerClasses}>How we build</p>
        <h2 class={titleClasses}>Development philosophy</h2>
      </header>

      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          philosophy.map((item, index) => (
            <article
              class={cardClasses}
              style={`transition-delay: ${index * 60}ms`}
            >
              <AboutGlyph name={item.glyph} />
              <h3 class={`${cardTitleClasses} mt-3`}>{item.title}</h3>
              <p class={cardBodyClasses}>{item.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Built in layers -->
      <header class="nh-reveal mt-16 max-w-3xl">
        <p class={kickerClasses}>Architecture</p>
        <h2 class={titleClasses}>Built in layers</h2>
        <p class={leadClasses}>
          Much like a layered cake—such as tres leches, where the sponge, milk
          soak, and topping each serve a distinct role—NAHPU is structured into
          separate layers that operate together as one application. We work
          across every layer to maintain performance and efficiency, and this
          clear separation supports interdisciplinary training.
        </p>
      </header>

      <div
        class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr_1fr] lg:items-center"
      >
        <div
          class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/80 p-5 sm:p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50"
        >
          <AboutLayers />
        </div>

        <ol class="flex flex-col gap-3">
          {
            appLayers.map((layer, index) => (
              <li
                class="nh-reveal flex items-start gap-3.5 rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/70 p-4 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/50"
                style={`transition-delay: ${index * 60}ms`}
              >
                <span
                  class={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold ${
                    layer.accent === "gold"
                      ? "bg-golden-grass-600 text-white dark:bg-golden-grass-400 dark:text-golden-grass-950"
                      : "bg-silver-tree-700 text-silver-tree-50 dark:bg-silver-tree-400 dark:text-silver-tree-950"
                  }`}
                >
                  {layer.number}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <h3 class="text-sm font-semibold text-silver-tree-950 dark:text-silver-tree-50">
                      {layer.title}
                    </h3>
                    <span class="rounded-full bg-silver-tree-200/80 px-2 py-0.5 text-[11px] font-medium text-silver-tree-800 dark:bg-silver-tree-800 dark:text-silver-tree-200">
                      {layer.tag}
                    </span>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                    {layer.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <article class={cardClasses}>
          <h3 class={cardTitleClasses}>
            Performance and efficiency at every layer
          </h3>
          <p class={cardBodyClasses}>
            We actively work on every layer—from interface responsiveness on
            modest field hardware, to native processing in Rust, to how records
            are stored on disk. Addressing efficiency throughout the stack keeps
            NAHPU fast, dependable, and conservative with battery power during
            extended fieldwork.
          </p>
        </article>

        <article class={cardClasses} style="transition-delay: 60ms">
          <h3 class={cardTitleClasses}>
            Interdisciplinary training and experimentation
          </h3>
          <p class={cardBodyClasses}>
            Clear boundaries between layers allow biologists, museum curators,
            designers, and computer science students to collaborate and train on
            real scientific software. Students also use a dedicated scratch
            repository to practice workflows, experiment with new ideas, and
            prototype features without affecting the stability of the main
            application.
          </p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            <a class={linkClasses} href="/en/contributing/"
              >Become a contributor</a
            >
            <a class={linkClasses} href="/en/contributing/code/architecture/"
              >Technical architecture</a
            >
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Roadmap -------------------------------------------------------------->
  <section
    class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
  >
    <div class={innerClasses}>
      <header class="nh-reveal max-w-3xl">
        <p class={kickerClasses}>Looking ahead</p>
        <h2 class={titleClasses}>Development roadmap</h2>
      </header>

      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          roadmap.map((item, index) => (
            <article
              class={cardClasses}
              style={`transition-delay: ${index * 60}ms`}
            >
              <AboutGlyph name={item.glyph} />
              <h3 class={`${cardTitleClasses} mt-3`}>{item.title}</h3>
              <p class={cardBodyClasses}>{item.body}</p>
              {item.link && (
                <p class="mt-3 text-sm">
                  <a class={linkClasses} href={item.link.href}>
                    {item.link.label}
                  </a>
                </p>
              )}
              {item.contact && (
                <p class="mt-3 text-sm">
                  <a
                    class={`${linkClasses} nh-email`}
                    href="#"
                    data-user={item.contact.user}
                    data-domain={item.contact.domain}
                  >
                    {item.contact.label}
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </div>

      <!-- Timeline -->
      <header class="nh-reveal mt-16 max-w-3xl">
        <p class={kickerClasses}>Timeline</p>
        <h2 class={titleClasses}>From first commit to what comes next</h2>
      </header>

      <div class="nh-timeline-wrap nh-reveal mt-10 max-w-3xl lg:max-w-none">
        <div class="nh-timeline-band nh-timeline-band-released">
          <ol class="nh-timeline nh-timeline-released">
            {
              releasedMilestones.map((item) => (
                <>
                  <li class="nh-tl-row nh-tl-released">
                    <time
                      class="nh-tl-when nh-tl-date"
                      datetime={formatIsoDate(item)}
                    >
                      {formatDate(item)}
                    </time>
                    <span class="nh-tl-axis">
                      <span class="nh-tl-dot" />
                    </span>
                    <div class="nh-tl-body">
                      <h3 class={cardTitleClasses}>{item.title}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                        {item.body}
                      </p>
                    </div>
                  </li>
                  {item === firstCommit && (
                    <li class="nh-tl-row nh-tl-span">
                      <span class="nh-tl-when" />
                      <span class="nh-tl-axis" />
                      <p class="nh-tl-span-label">
                        {developmentSpan} of development
                      </p>
                    </li>
                  )}
                </>
              ))
            }
          </ol>
          <div class="nh-tl-curve-top" aria-hidden="true">
            <span class="nh-tl-today-badge">Today</span>
          </div>
        </div>

        <div class="nh-tl-row nh-tl-today nh-tl-today-mobile" aria-hidden="true">
          <span class="nh-tl-when">Today</span>
          <span class="nh-tl-axis" />
          <span class="nh-tl-rule" />
        </div>

        <div class="nh-timeline-band nh-timeline-band-planned">
          <ol class="nh-timeline nh-timeline-planned">
            {
              plannedMilestones.map((item) => (
                <li class="nh-tl-row nh-tl-planned">
                  <time
                    class="nh-tl-when nh-tl-date"
                    datetime={formatIsoDate(item)}
                  >
                    {formatDate(item)}
                  </time>
                  <span class="nh-tl-axis">
                    <span class="nh-tl-dot" />
                  </span>
                  <div class="nh-tl-body">
                    <h3 class={cardTitleClasses}>{item.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                      {item.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="nh-tl-curve-bottom" aria-hidden="true" />
        </div>
      </div>

      <p
        class="nh-reveal mt-8 flex items-start gap-2.5 text-sm text-silver-tree-700 dark:text-silver-tree-300"
      >
        <svg
          class="mt-0.5 h-4 w-4 flex-none text-golden-grass-600 dark:text-golden-grass-400"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <circle
            cx="8"
            cy="8"
            r="7"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></circle>
          <path
            d="M8 4.5v4.2M8 10.8v.7"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
        <span>
          Planned dates are targets, not guarantees, and may change. We list
          only features already in development.
        </span>
      </p>

      <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <figure
          class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg sm:col-span-2 dark:border-silver-tree-700/60"
        >
          <Image
            src={peromyscus}
            alt="A deer mouse on a branch, whiskers lit by the sun"
            widths={[400, 800]}
            sizes="(min-width: 640px) 60vw, 92vw"
            class="aspect-3/2 w-full object-cover"
            loading="lazy"
          />
        </figure>
        <figure
          class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg dark:border-silver-tree-700/60"
        >
          <Image
            src={flyingFrog}
            alt="A green flying frog gripping a thin branch at night"
            widths={[400, 800]}
            sizes="(min-width: 640px) 30vw, 92vw"
            class="aspect-3/2 w-full object-cover sm:aspect-auto sm:h-full"
            loading="lazy"
          />
        </figure>
      </div>
      <p class="mt-4 text-xs text-silver-tree-600 dark:text-silver-tree-400">
        Photographs by Heru Handika.
      </p>
    </div>
  </section>
</Layout>

<script>
  const reverse = (value: string) => [...value].reverse().join("");
  document.querySelectorAll<HTMLAnchorElement>(".nh-email").forEach((link) => {
    const { user, domain } = link.dataset;
    if (!user || !domain) return;
    link.href = `mailto:${reverse(user)}@${reverse(domain)}`;
  });

  const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealed.forEach((element) => element.classList.add("nh-in"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("nh-in");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );
    revealed.forEach((element) => observer.observe(element));
  }
</script>
