---
import Layout from "../layouts/Layout.astro";
import HeroBackdrop from "../components/landing/HeroBackdrop.astro";
import Pillars from "../components/landing/Pillars.astro";
import AppShowcase from "../components/landing/AppShowcase.astro";
import CatalogFormats from "../components/landing/CatalogFormats.astro";
import FieldGallery from "../components/landing/FieldGallery.astro";
import cntl from "cntl";

import "../styles/global.css";
import "../styles/landing.css";

const heroClasses = cntl`
  nh-hero
  flex flex-col items-center justify-center
  min-h-svh
  px-6 pt-16 pb-12
  text-center
`;

const eyebrowClasses = cntl`
  inline-flex items-center gap-2
  rounded-full
  border border-silver-tree-400/60 dark:border-silver-tree-600/60
  bg-silver-tree-50/60 dark:bg-silver-tree-900/50
  backdrop-blur-sm
  px-4 py-1.5
  text-xs font-medium tracking-widest uppercase
  text-silver-tree-800 dark:text-silver-tree-200
`;

const wordmarkClasses = cntl`
  mt-8
  text-6xl sm:text-7xl lg:text-8xl
  font-bold tracking-[0.14em]
  text-silver-tree-950 dark:text-silver-tree-50
`;

const taglineClasses = cntl`
  mx-auto mt-6 max-w-3xl
  text-xl sm:text-2xl lg:text-3xl
  font-light leading-snug
  text-silver-tree-900 dark:text-silver-tree-100
`;

const heroBodyClasses = cntl`
  mx-auto mt-6 max-w-2xl
  text-base leading-relaxed
  text-silver-tree-800 dark:text-silver-tree-300
`;

const mainBtnClasses = cntl`
  rounded-xl
  px-6 py-3.5
  bg-linear-to-r from-silver-tree-700 to-silver-tree-600
  dark:from-silver-tree-400 dark:to-silver-tree-300
  text-silver-tree-50 dark:text-silver-tree-950
  font-semibold no-underline
  shadow-lg shadow-silver-tree-700/20
  transition-transform duration-300
  hover:-translate-y-0.5
`;

const secondaryBtnClasses = cntl`
  rounded-xl
  px-6 py-3.5
  border border-silver-tree-700/70 dark:border-silver-tree-400/70
  text-silver-tree-800 dark:text-silver-tree-200
  font-semibold no-underline
  backdrop-blur-sm
  transition-colors duration-300
  hover:bg-silver-tree-700 hover:text-silver-tree-50
  dark:hover:bg-silver-tree-400 dark:hover:text-silver-tree-950
`;

const sectionClasses = cntl`
  px-6 py-20 sm:py-24
`;

const sectionInnerClasses = cntl`
  mx-auto max-w-6xl
`;

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const sectionTitleClasses = cntl`
  mt-3 text-3xl sm:text-4xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const sectionLeadClasses = cntl`
  mt-4 max-w-2xl
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const heroFacts = [
    { label: "Works offline", detail: "No network needed in the field" },
    { label: "Cross-platform", detail: "Desktop, tablet, and phone" },
    { label: "Open standards", detail: "Darwin Core and FAIR principles" },
];

const capabilities = [
    {
        color: "#2f9e7d",
        title: "Digital asset management",
        desc: "Attach photos, audio, and videos of specimens, habitats, and field notes directly to your collection records.",
    },
    {
        color: "#3f9fd6",
        title: "Multi-taxon support",
        desc: "Mix taxa in a single project or separate in multiple projects. Each specimen gets a catalog format tailored to its taxon.",
    },
    {
        color: "#7c72d8",
        title: "Write a site once, use it everywhere",
        desc: "Create rich site profiles with unlimited coordinates and reuse them across specimens and events.",
    },
    {
        color: "#e0913a",
        title: "Collecting events",
        desc: "Document collection date, method, effort, and personnel, then link them to multiple specimens.",
    },
    {
        color: "#3c8fa8",
        title: "Tissue sample management",
        desc: "Track large sample sets with barcode and QR scanning via the device camera.",
    },
    {
        color: "#b07a56",
        title: "Real-time statistics",
        desc: "Monitor activity to make decision on collecting strategy, avoid collector bias, and prevent over-collection at a glance.",
    },
    {
        color: "#e2685f",
        title: "Advanced sharing",
        desc: "Share data with collaborators or bulk import it into a museum database.",
    },
    {
        color: "var(--color-golden-grass-500)",
        title: "Open source and open standards",
        desc: "Built on open-source stacks and data records and exports follow Darwin Core, FAIR principles, and Frictionless Data.",
    },
];

const linkClasses = cntl`
  text-silver-tree-800 dark:text-silver-tree-100
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-950 dark:hover:text-silver-tree-50
`;

interface Funder {
    kind: string;
    name: string;
    detail: string;
    links?: { label: string; href: string }[];
}

const funders: Funder[] = [
    {
        kind: "Federal research grant",
        name: "National Science Foundation",
        detail: "Funding for this project was provided under two awards.",
        links: [
            {
                label: "DEB-1754393",
                href: "https://www.nsf.gov/awardsearch/showAward?AWD_ID=1754393",
            },
            {
                label: "DEB-2244754",
                href: "https://www.nsf.gov/awardsearch/showAward?AWD_ID=2244754",
            },
        ],
    },
    {
        kind: "Endowed fund",
        name: "Alfred L. Gardner and Mark S. Hafner Mammalogy Fund",
        detail: "Additional funding for this project managed at LSU Museum of Natural Science.",
    },
    {
        kind: "Logistical support",
        name: "Human-Augmented Analytics Group",
        detail: "Provided logistical support for collaboration and development at the Georgia Institute of Technology.",
        links: [
            {
                label: "Visit the group",
                href: "https://sites.gatech.edu/human-augmented-analytics-group/",
            },
        ],
    },
];

const spreadsheetSteps = [
    {
        title: "Start where the spreadsheet was",
        desc: "Enter records in NAHPU instead of a sheet and export a tabular file whenever you need one. Everything downstream of the export carries on unchanged.",
    },
    {
        title: "Associations come with the record",
        desc: "A specimen already points at its site, collecting event, personnel, parts, and photographs. No lookup formulas, no locality text copied between sheets, no coordinate flips, and no row that quietly refers to the wrong site.",
    },
    {
        title: "One project instead of many sheets",
        desc: "Sites, specimens, tissue samples, and digital asset records stop living in separate files that drift apart between field seasons. They stay associated in the same catalog.",
    },
];
---

<Layout
    title="NAHPU — A digital field catalog for natural history collections"
    description="Leveraging emerging digital technologies to accelerate biodiversity inventories."
    overlayNav
>
    <!-- Hero ---------------------------------------------------------------->
    <section class={heroClasses}>
        <HeroBackdrop />

        <span class={eyebrowClasses}>Free · Open source · Field ready</span>

        <h1 class={wordmarkClasses}>
            {
                "NAHPU".split("").map((letter, index) => (
                    <span
                        class="nh-letter"
                        style={`animation-delay: ${index * 0.09}s`}
                    >
                        {letter}
                    </span>
                ))
            }
        </h1>
        <p
            class="mt-3 text-sm tracking-[0.3em] uppercase text-silver-tree-700 dark:text-silver-tree-400"
        >
            Natural History Project Utility
        </p>

        <p class={taglineClasses}>
            Rethinking biodiversity inventories in the digital age, from the
            field to the museum and beyond.
        </p>

        <p class={heroBodyClasses}>
            NAHPU is a cross-platform (mobile and desktop) digital field catalog
            for natural history collections. Specimens, sites, collecting
            events, tissue samples, and field photographs live in one project
            file, and easily share exact same of data among collaborators.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a href="/en/installation" class={mainBtnClasses}>Install NAHPU</a>
            <a href="/en" class={secondaryBtnClasses}>Read the documentation</a>
        </div>

        <dl
            class="mt-16 grid w-full max-w-3xl grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4"
        >
            {
                heroFacts.map((fact) => (
                    <div class="flex flex-col gap-1">
                        <dt class="text-sm font-semibold text-silver-tree-900 dark:text-silver-tree-100">
                            {fact.label}
                        </dt>
                        <dd class="m-0 text-xs text-silver-tree-700 dark:text-silver-tree-400">
                            {fact.detail}
                        </dd>
                    </div>
                ))
            }
        </dl>

        <p
            class="absolute inset-x-0 bottom-4 px-6 text-[11px] tracking-wide text-silver-tree-700 sm:inset-x-auto sm:right-6 sm:px-0 dark:text-silver-tree-400"
        >
            Background photograph taken on Mt. Bandahara, Indonesia, by Heru
            Handika.
        </p>

        <a
            href="#field-work"
            aria-label="Skip to the overview"
            class="mt-14 text-silver-tree-700 no-underline dark:text-silver-tree-400"
        >
            <svg
                class="h-6 w-6 animate-bounce"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M12 5v14M6 13l6 6 6-6"></path>
            </svg>
        </a>
    </section>

    <!-- What NAHPU is for --------------------------------------------------->
    <section
        id="field-work"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Why it exists</p>
                <h2 class={sectionTitleClasses}>
                    Inventories are limited by what gets written down
                </h2>
                <p class={sectionLeadClasses}>
                    Field notebooks, camera cards, and spreadsheets rarely
                    reconcile cleanly once an expedition ends. NAHPU keeps the
                    record complete and internally consistent from the moment
                    the specimen is in hand.
                </p>
            </header>

            <div class="mt-12">
                <Pillars />
            </div>
        </div>
    </section>

    <!-- Screens ------------------------------------------------------------->
    <section
        id="screens"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Inside the catalog</p>
                <h2 class={sectionTitleClasses}>Example views</h2>
                <p class={sectionLeadClasses}>
                    One project seen from the specimen, site, map, media
                    library, statistics, narrative, and export interfaces. NAHPU
                    features a single, unified system to collect as much
                    information possible. The forest you survey today, may be
                    gone tomorrow. Not trying to be overly dramatic. It's is a
                    reality, and one reason natural history works are so
                    important.
                </p>
            </header>

            <div class="nh-reveal mt-12">
                <AppShowcase />
            </div>

            <p
                class="nh-reveal mt-8 max-w-3xl border-l-2 border-silver-tree-400/60 pl-4 text-xs leading-relaxed text-silver-tree-600 dark:border-silver-tree-600/60 dark:text-silver-tree-400"
            >
                The records shown in these screens are for illustrative purposes
                only and do not reflect real field data.
            </p>
        </div>
    </section>

    <!-- Catalog formats ----------------------------------------------------->
    <section
        id="catalog-formats"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Catalog formats</p>
                <h2 class={sectionTitleClasses}>
                    Fields that match the discipline
                </h2>
                <p class={sectionLeadClasses}>
                    Each format is fine-tuned for its discipline, and a single
                    project can hold more than one format. You can add custom
                    fields to any format, and the app will remember them for the
                    next specimen of that taxon.
                </p>
            </header>

            <div class="mt-12">
                <CatalogFormats />
            </div>
        </div>
    </section>

    <!-- Field gallery ------------------------------------------------------->
    <section
        id="from-the-field"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>From the field</p>
                <h2 class={sectionTitleClasses}>Where every record begins</h2>
                <p class={sectionLeadClasses}>
                    Behind each catalog number is an animal, a locality, and a
                    night of fieldwork. NAHPU keeps the photographs with the
                    specimen data they belong to. You can also record audio and
                    videos directly in the app, and attach them to the record
                    they document.
                </p>
            </header>

            <div class="mt-12">
                <FieldGallery />
            </div>
        </div>
    </section>

    <!-- Capabilities -------------------------------------------------------->
    <section
        id="capabilities"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Capabilities</p>
                <h2 class={sectionTitleClasses}>What comes with the catalog</h2>
            </header>

            <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
                {
                    capabilities.map((item, index) => (
                        <div
                            class="nh-reveal flex gap-4 border-t border-silver-tree-300/70 pt-5 dark:border-silver-tree-700/70"
                            style={`transition-delay: ${index * 50}ms`}
                        >
                            <span
                                class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full"
                                style={`background:${item.color}`}
                            />
                            <div>
                                <h3 class="text-base font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                    {item.title}
                                </h3>
                                <p class="mt-1 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                                    {item.desc}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Spreadsheet replacement --------------------------------------------->
    <section
        id="spreadsheet"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Not all at once</p>
                <h2 class={sectionTitleClasses}>
                    Or start as a spreadsheet replacement
                </h2>
                <p class={sectionLeadClasses}>
                    Moving your collection workflows to a digital catalog does
                    not have to be all or nothing. If you are not ready to
                    convert everything, use NAHPU where the spreadsheet used to
                    sit and keep the associations it gives you for free.
                </p>
            </header>

            <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
                {
                    spreadsheetSteps.map((item, index) => (
                        <article
                            class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/70 p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/50"
                            style={`transition-delay: ${index * 60}ms`}
                        >
                            <h3 class="text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                {item.title}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                                {item.desc}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Collaboration -------------------------------------------------------->
    <section
        id="collaboration"
        class={`${sectionClasses} bg-silver-tree-50 dark:bg-silver-tree-800`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Collaboration</p>
                <h2 class={sectionTitleClasses}>
                    We are the users of our own software
                </h2>
                <p class={sectionLeadClasses}>
                    NAHPU is built by the people who carry it into the field.
                    From the humidity, unpredictable weather, and lack of
                    electricity in the mountains of Southeast Asia to the tall
                    Andes and the riverine habitat deep in the Amazon in South
                    America, and the dry climate of the North American desert,
                    we poured this experience into building NAHPU. It is
                    designed for fieldwork of any complexity across humid and
                    cold, to hot and dry climates, and everything in between.
                </p>
            </header>

            <div
                class="nh-reveal mt-6 rounded-2xl border border-silver-tree-300/70 bg-silver-tree-100/70 p-6 sm:p-8 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50"
            >
                <div
                    class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_auto] lg:items-center"
                >
                    <div>
                        <p class={kickerClasses}>Interdisciplinary by design</p>
                        <h3
                            class="mt-3 text-xl font-semibold text-silver-tree-900 sm:text-2xl dark:text-silver-tree-50"
                        >
                            Field experience meets software industry practice
                        </h3>
                        <p
                            class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300"
                        >
                            Through collaboration with the <a
                                class={linkClasses}
                                href="https://sites.gatech.edu/human-augmented-analytics-group/"
                                target="_blank"
                                rel="noopener noreferrer"
                                >Human Augmented Analytics Group</a
                            >, we brought software industry experience to NAHPU,
                            and develop it into interdisciplinary research and
                            training project with real-world application.
                        </p>
                    </div>

                    <a href="/teams" class={secondaryBtnClasses}
                        >Meet the team</a
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Call to action ------------------------------------------------------>
    <section
        class="relative overflow-hidden px-6 py-24 bg-silver-tree-100 dark:bg-silver-tree-950"
    >
        <div
            class="nh-blob nh-blob-teal pointer-events-none opacity-30"
            aria-hidden="true"
        >
        </div>
        <div class="relative mx-auto max-w-3xl text-center">
            <h2 class={sectionTitleClasses}>Take it to the field</h2>
            <p class={`${sectionLeadClasses} mx-auto`}>
                NAHPU is free to install and free to use. Start with the
                installation guide, or follow the walkthrough that builds a
                project from the first site to the first exported record set.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <a href="/en/installation" class={mainBtnClasses}
                    >Install NAHPU</a
                >
                <a href="/get-started" class={secondaryBtnClasses}
                    >Get started</a
                >
                <a
                    href="https://github.com/nahpu"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={secondaryBtnClasses}>Source on GitHub</a
                >
            </div>
        </div>
    </section>
    <!-- Funding ------------------------------------------------------------->
    <section
        id="funding"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Funding and support</p>
                <h2 class={sectionTitleClasses}>Who makes this possible</h2>
                <p class={sectionLeadClasses}>
                    NAHPU is free and open source, developed with the support of
                    public research funding, a dedicated mammalogy fund, and
                    institutional collaboration.
                </p>
            </header>

            <ul
                class="mt-12 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3"
            >
                {
                    funders.map((funder, index) => (
                        <li
                            class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-100/70 p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50"
                            style={`transition-delay: ${index * 60}ms`}
                        >
                            <p class="text-[11px] font-semibold tracking-widest text-silver-tree-600 uppercase dark:text-silver-tree-400">
                                {funder.kind}
                            </p>
                            <h3 class="mt-4 text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                {funder.name}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                                {funder.detail}
                            </p>
                            {funder.links && (
                                <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                                    {funder.links.map((link) => (
                                        <a
                                            class={linkClasses}
                                            href={link.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {link.label}
                                        </a>
                                    ))}
                                </p>
                            )}
                        </li>
                    ))
                }
            </ul>

            <div class="nh-reveal mt-8 max-w-3xl">
                <p
                    class="text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300"
                >
                    Various other funding sources may have supported this
                    project through the work of the contributors.
                </p>
                <p
                    class="mt-4 border-l-2 border-silver-tree-400/60 pl-4 text-xs leading-relaxed text-silver-tree-600 dark:border-silver-tree-600/60 dark:text-silver-tree-400"
                >
                    Any opinions, findings, and conclusions or recommendations
                    expressed in this material are those of the authors and do
                    not necessarily reflect the views of the funders.
                </p>
            </div>
        </div>
    </section>
</Layout>

<script>
    const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
        revealed.forEach((element) => element.classList.add("nh-in"));
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("nh-in");
                    observer.unobserve(entry.target);
                });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );
        revealed.forEach((element) => observer.observe(element));
    }
</script>
