---
import Layout from "../layouts/Layout.astro";
import HeroBackdrop from "../components/landing/HeroBackdrop.astro";
import Pillars from "../components/landing/Pillars.astro";
import AppShowcase from "../components/landing/AppShowcase.astro";
import CatalogFormats from "../components/landing/CatalogFormats.astro";
import FieldGallery from "../components/landing/FieldGallery.astro";
import cntl from "cntl";

import "../styles/global.css";
import "../styles/landing.css";

const heroClasses = cntl`
  nh-hero
  flex flex-col items-center justify-center
  min-h-svh
  px-6 pt-16 pb-12
  text-center
`;

const eyebrowClasses = cntl`
  inline-flex items-center gap-2
  rounded-full
  border border-silver-tree-400/60 dark:border-silver-tree-600/60
  bg-silver-tree-50/60 dark:bg-silver-tree-900/50
  backdrop-blur-sm
  px-4 py-1.5
  text-xs font-medium tracking-widest uppercase
  text-silver-tree-800 dark:text-silver-tree-200
`;

const wordmarkClasses = cntl`
  mt-8
  text-6xl sm:text-7xl lg:text-8xl
  font-bold tracking-[0.14em]
  text-silver-tree-950 dark:text-silver-tree-50
`;

const taglineClasses = cntl`
  mx-auto mt-6 max-w-3xl
  text-xl sm:text-2xl lg:text-3xl
  font-light leading-snug
  text-silver-tree-900 dark:text-silver-tree-100
`;

const heroBodyClasses = cntl`
  mx-auto mt-6 max-w-3xl
  text-base leading-relaxed
  text-silver-tree-800 dark:text-silver-tree-300
`;

const mainBtnClasses = cntl`
  rounded-xl
  px-6 py-4
  bg-linear-to-r from-silver-tree-700 to-silver-tree-600
  dark:from-silver-tree-400 dark:to-silver-tree-300
  text-silver-tree-50 dark:text-silver-tree-950
  font-semibold no-underline
  shadow-lg shadow-silver-tree-700/20
  transition-transform duration-300
  hover:-translate-y-0.5
`;

const secondaryBtnClasses = cntl`
  rounded-xl
  px-6 py-4
  border border-silver-tree-700/70 dark:border-silver-tree-400/70
  text-silver-tree-800 dark:text-silver-tree-200
  font-semibold no-underline
  backdrop-blur-sm
  transition-colors duration-300
  hover:bg-silver-tree-700 hover:text-silver-tree-50
  dark:hover:bg-silver-tree-400 dark:hover:text-silver-tree-950
`;

const sectionClasses = cntl`
  px-6 py-20 sm:py-24
`;

const sectionInnerClasses = cntl`
  mx-auto max-w-6xl
`;

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const sectionTitleClasses = cntl`
  mt-3 text-3xl sm:text-4xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const sectionLeadClasses = cntl`
  mt-4 max-w-2xl
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const heroFacts = [
    { label: "Works offline", detail: "No network needed in the field" },
    { label: "Cross-platform", detail: "Desktop, tablet, and phone" },
    {
        label: "Open standards",
        detail: "Darwin Core, Frictionless, and FAIR",
    },
];

const capabilities = [
    {
        color: "#2f9e7d",
        title: "Digital asset management",
        desc: "Attach photos, audio, and video of specimens, habitats, and field notes to collection records.",
    },
    {
        color: "#3f9fd6",
        title: "Multi-taxon support",
        desc: "Keep several taxa in one project or in separate projects. Each specimen uses a catalog format suited to its taxon.",
    },
    {
        color: "#7c72d8",
        title: "Reusable site records",
        desc: "Create site records with any number of coordinates and reuse them across specimens and events.",
    },
    {
        color: "#e0913a",
        title: "Collecting events",
        desc: "Record collection date, method, effort, and personnel, and link each event to multiple specimens.",
    },
    {
        color: "#3c8fa8",
        title: "Tissue sample management",
        desc: "Track large sample sets with barcode and QR code scanning through the device camera.",
    },
    {
        color: "#b07a56",
        title: "Real-time statistics",
        desc: "Summaries of collecting activity help guide collecting strategy, reduce collector bias, and avoid over-collection.",
    },
    {
        color: "#e2685f",
        title: "Data sharing",
        desc: "Share records with collaborators or prepare them for bulk import into a museum database.",
    },
    {
        color: "var(--color-golden-grass-500)",
        title: "Open source and open standards",
        desc: "Built with open-source software. Records and exports follow Darwin Core, the FAIR principles, and Frictionless Data.",
    },
];

const linkClasses = cntl`
  text-silver-tree-800 dark:text-silver-tree-100
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-950 dark:hover:text-silver-tree-50
`;

interface Funder {
    kind: string;
    name: string;
    detail: string;
    links?: { label: string; href: string }[];
}

const funders: Funder[] = [
    {
        kind: "Federal research grant",
        name: "National Science Foundation",
        detail: "Funding for this project was provided under two awards.",
        links: [
            {
                label: "DEB-1754393",
                href: "https://www.nsf.gov/awardsearch/showAward?AWD_ID=1754393",
            },
            {
                label: "DEB-2244754",
                href: "https://www.nsf.gov/awardsearch/showAward?AWD_ID=2244754",
            },
        ],
    },
    {
        kind: "Endowed fund",
        name: "Alfred L. Gardner and Mark S. Hafner Mammalogy Fund",
        detail: "Provided additional funding, managed by the LSU Museum of Natural Science.",
        links: [
            {
                label: "Visit LSUMNS Mammalogy Fund page",
                href: "https://www.lsu.edu/mns/research-and-collections/collections/mammalogy.php",
            },
        ],
    },
    {
        kind: "Logistical support",
        name: "Human-Augmented Analytics Group",
        detail: "Provided logistical support for collaboration and development at the Georgia Institute of Technology.",
        links: [
            {
                label: "Visit the group",
                href: "https://sites.gatech.edu/human-augmented-analytics-group/",
            },
        ],
    },
];

const spreadsheetSteps = [
    {
        title: "Start where the spreadsheet was",
        desc: "Enter records in NAHPU instead of a spreadsheet and export a tabular file when needed. Workflows that use the exported file do not need to change.",
    },
    {
        title: "Associations come with the record",
        desc: "Each specimen links to its site, collecting event, personnel, parts, and photographs. Lookup formulas and locality text copied between sheets are not needed.",
    },
    {
        title: "One project instead of many sheets",
        desc: "Sites, specimens, tissue samples, and digital assets are kept in one catalog rather than in separate files that can diverge between field seasons.",
    },
];

const manuscript = {
    title: "NAHPU: An integrated approach to natural history data acquisition and management in the extended specimen era",
    authors: "Handika, H., Moncrieff, A., Henderson, C., Dadaian, A., Gordon, C., Canton, R., Chipps, A., Inayah, N., Chornelia, A., Rego, M., Pérez-Amaya, N., Gan, L., Jaiswal, A., Lee, D., Yu, J., Aravind, A., Evangelista, D., Rutledge, S., Elías, D., Troyer, E., Silva de Miranda, G., Vonnahme, L., Shi, B., Nations, J., Del-Rio, G., Thom, G., Porto, A., & Esselstyn, J.",
    year: 2026,
    venue: "EcoEvoRxiv",
    doi: "10.32942/X21M6D",
};

const manuscriptUrl = `https://doi.org/${manuscript.doi}`;

const bibtex = `@misc{Handika_2026,
  title = {${manuscript.title}},
  author = {Handika, Heru and Moncrieff, Andre and Henderson, Cody and Dadaian, Alain and Gordon, Caleb and Canton, Roberta and Chipps, Austin and Inayah, Nurul and Chornelia, Ada and Rego, Marco and P{\\'e}rez-Amaya, Natalia and Gan, Lawrence and Jaiswal, Aakanksha and Lee, Daeun and Yu, Jia and Aravind, Ashmitha and Evangelista, Dante and Rutledge, Samantha and El{\\'i}as, Diego and Troyer, Emily and Silva de Miranda, Gustavo and Vonnahme, Lauren and Shi, Breanna and Nations, Jonathan and Del-Rio, Glaucia and Thom, Gregory and Porto, Arthur and Esselstyn, Jacob},
  year = {${manuscript.year}},
  publisher = {${manuscript.venue}},
  doi = {${manuscript.doi}},
  url = {${manuscriptUrl}}
}`;
---

<Layout
    title="NAHPU — A digital field catalog for natural history collections"
    description="A cross-platform digital catalog for natural history collections."
    overlayNav
>
    <!-- Hero ---------------------------------------------------------------->
    <section class={heroClasses}>
        <HeroBackdrop />

        <span class={eyebrowClasses}>Free · Open source · Field ready</span>

        <h1 class={wordmarkClasses}>
            {"NAHPU".split("").map((letter, index) => (
                <span
                    class="nh-letter"
                    style={`animation-delay: ${index * 0.09}s`}
                >
                    {letter}
                </span>
            ))}
        </h1>
        <p class="mt-3 text-sm tracking-[0.3em] uppercase text-silver-tree-700 dark:text-silver-tree-400">
            Natural History Project Utility
        </p>

        <p class={taglineClasses}>
            Digital catalog for the extended specimen era
        </p>

        <p class={heroBodyClasses}>
            NAHPU is a cross-platform digital catalog for natural history
            collections. It simplifies recording detailed information in the
            field while preserving the integrity of the data and its
            associations.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a href="/get-started" class={mainBtnClasses}>
                Install NAHPU
            </a>
            <a href="/en" class={secondaryBtnClasses}>
                Read the documentation
            </a>
        </div>

        <dl class="mt-16 grid w-full max-w-3xl grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
            {heroFacts.map((fact) => (
                <div class="flex flex-col gap-1">
                    <dt class="text-sm font-semibold text-silver-tree-900 dark:text-silver-tree-100">
                        {fact.label}
                    </dt>
                    <dd class="m-0 text-xs text-silver-tree-700 dark:text-silver-tree-400">
                        {fact.detail}
                    </dd>
                </div>
            ))}
        </dl>

        <p class="absolute inset-x-0 bottom-4 px-6 text-[11px] tracking-wide text-silver-tree-700 sm:inset-x-auto sm:right-6 sm:px-0 dark:text-silver-tree-400">
            Background photograph taken on Mt. Bandahara, Indonesia, by Heru
            Handika.
        </p>

        <a
            href="#field-work"
            aria-label="Skip to the overview"
            class="mt-12 text-silver-tree-700 no-underline dark:text-silver-tree-400"
        >
            <svg
                class="h-6 w-6 animate-bounce"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M12 5v14M6 13l6 6 6-6"></path>
            </svg>
        </a>
    </section>

    <!-- What NAHPU is for --------------------------------------------------->
    <section
        id="field-work"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Why it exists</p>
                <h2 class={sectionTitleClasses}>
                    Modern field expeditions need a modern catalog
                </h2>
                <p class={sectionLeadClasses}>
                    Field notebooks, camera cards, and spreadsheets are often
                    difficult to reconcile after an expedition. NAHPU keeps
                    records complete and consistent from the time the specimen
                    is collected.
                </p>
            </header>

            <div class="mt-12">
                <Pillars />
            </div>
        </div>
    </section>

    <!-- Screens ------------------------------------------------------------->
    <section
        id="screens"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Inside the catalog</p>
                <h2 class={sectionTitleClasses}>
                    Rich features for comprehensive data management
                </h2>
                <p class={sectionLeadClasses}>
                    NAHPU provides a single system for recording as much
                    information as possible during fieldwork. Habitats surveyed
                    today may change or disappear, and records made at the time
                    of collection may be the only documentation that remains.
                </p>
            </header>

            <div class="nh-reveal mt-12">
                <AppShowcase />
            </div>

            <p class="nh-reveal mt-8 max-w-3xl border-l-2 border-silver-tree-400/60 pl-4 text-xs leading-relaxed text-silver-tree-600 dark:border-silver-tree-600/60 dark:text-silver-tree-400">
                The records shown in these screens are for illustrative purposes
                only and do not reflect real field data.
            </p>
        </div>
    </section>

    <!-- Catalog formats ----------------------------------------------------->
    <section
        id="catalog-formats"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Catalog formats</p>
                <h2 class={sectionTitleClasses}>
                    A growing list of supported disciplines
                </h2>
                <p class={sectionLeadClasses}>
                    Each format includes fields specific to its discipline, and
                    a single project can use more than one format. Custom
                    fields can be added to any format.
                </p>
            </header>

            <div class="mt-12">
                <CatalogFormats />
            </div>
        </div>
    </section>

    <!-- Media --------------------------------------------------------------->
    <section
        id="media"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Media</p>
                <h2 class={sectionTitleClasses}>Manage and associate media</h2>
                <p class={sectionLeadClasses}>
                    Photographs, audio, and video are linked to the specimen,
                    site, collecting event, or narrative they document. Audio
                    and video can be recorded directly in the app, so each file
                    is linked to its record from the start.
                </p>
            </header>

            <div class="mt-12">
                <FieldGallery />
            </div>
        </div>
    </section>

    <!-- Capabilities -------------------------------------------------------->
    <section
        id="capabilities"
        class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Capabilities</p>
                <h2 class={sectionTitleClasses}>What comes with the catalog</h2>
            </header>

            <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
                {capabilities.map((item, index) => (
                    <div
                        class="nh-reveal flex gap-4 border-t border-silver-tree-300/70 pt-5 dark:border-silver-tree-700/70"
                        style={`transition-delay: ${index * 50}ms`}
                    >
                        <span
                            class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full"
                            style={`background:${item.color}`}
                        />
                        <div>
                            <h3 class="text-base font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                {item.title}
                            </h3>
                            <p class="mt-1 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                                {item.desc}
                            </p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Spreadsheet replacement --------------------------------------------->
    <section
        id="spreadsheet"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Not all at once</p>
                <h2 class={sectionTitleClasses}>
                    Or start as a spreadsheet replacement
                </h2>
                <p class={sectionLeadClasses}>
                    Moving collection workflows to a digital catalog can happen
                    in stages. NAHPU can replace the spreadsheet alone while
                    still keeping the associations between records.
                </p>
            </header>

            <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
                {spreadsheetSteps.map((item, index) => (
                    <article
                        class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/70 p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/50"
                        style={`transition-delay: ${index * 60}ms`}
                    >
                        <h3 class="text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                            {item.title}
                        </h3>
                        <p class="mt-3 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                            {item.desc}
                        </p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- Collaboration -------------------------------------------------------->
    <section
        id="collaboration"
        class={`${sectionClasses} bg-silver-tree-50 dark:bg-silver-tree-800`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Collaboration</p>
                <h2 class={sectionTitleClasses}>
                    Developed by field researchers
                </h2>
                <p class={sectionLeadClasses}>
                    NAHPU is developed by researchers who use it in their own
                    fieldwork, including montane forests in Southeast Asia, the
                    Andes, the Amazon basin, and deserts in North America. It is
                    designed for a range of field conditions, from humid and
                    cold to hot and dry, with unpredictable weather and limited
                    access to electricity.
                </p>
            </header>

            <div class="nh-reveal mt-6 rounded-2xl border border-silver-tree-300/70 bg-silver-tree-100/70 p-6 sm:p-8 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div>
                        <p class={kickerClasses}>Interdisciplinary by design</p>
                        <h3 class="mt-3 text-xl font-semibold text-silver-tree-900 sm:text-2xl dark:text-silver-tree-50">
                            Field research and software engineering
                        </h3>
                        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                            NAHPU is developed in collaboration with the{" "}
                            <a
                                class={linkClasses}
                                href="https://sites.gatech.edu/human-augmented-analytics-group/"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Human-Augmented Analytics Group
                            </a>
                            , which contributes software engineering practice
                            and makes the project an interdisciplinary research
                            and training effort.
                        </p>
                    </div>

                    <a href="/teams" class={secondaryBtnClasses}>
                        Meet the team
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Manuscript ---------------------------------------------------------->
    <section
        id="cite"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Publication</p>
                <h2 class={sectionTitleClasses}>Read and cite the manuscript</h2>
                <p class={sectionLeadClasses}>
                    The manuscript describes the design and features of NAHPU
                    and its testing in the field, including 115 days on Sumatra
                    without on-site electricity. If you use NAHPU in your
                    research, please cite the manuscript. Citations document
                    how NAHPU is used and support its continued development.
                </p>
            </header>

            <figure class="nh-reveal mt-10 m-0 rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/70 p-6 sm:p-8 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50">
                <blockquote class="m-0 text-sm leading-relaxed text-silver-tree-800 dark:text-silver-tree-200">
                    {manuscript.authors} ({manuscript.year}).{" "}
                    <span class="font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                        {manuscript.title}
                    </span>
                    . <em>{manuscript.venue}</em>.{" "}
                    <a
                        class={linkClasses}
                        href={manuscriptUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {manuscriptUrl}
                    </a>
                </blockquote>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href={manuscriptUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={mainBtnClasses}
                    >
                        Read the manuscript
                    </a>
                    <button
                        type="button"
                        id="nh-copy-bibtex"
                        data-bibtex={bibtex}
                        class={`${secondaryBtnClasses} cursor-pointer bg-transparent`}
                    >
                        Copy BibTeX
                    </button>
                </div>
            </figure>
        </div>
    </section>

    <!-- Call to action ------------------------------------------------------>
    <section class="relative overflow-hidden px-6 py-24 bg-silver-tree-100 dark:bg-silver-tree-950">
        <div
            class="nh-blob nh-blob-teal pointer-events-none opacity-30"
            aria-hidden="true"
        ></div>
        <div class="relative mx-auto max-w-3xl text-center">
            <h2 class={sectionTitleClasses}>Get started</h2>
            <p class={`${sectionLeadClasses} mx-auto`}>
                NAHPU is free to install and use. See the Get Started page, or
                follow the walkthrough that builds a project from the first site
                to the first exported record set.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <a href="/get-started" class={mainBtnClasses}>
                    Install NAHPU
                </a>
                <a href="/en/installation" class={secondaryBtnClasses}>
                    Installation guide
                </a>
                <a
                    href="https://github.com/nahpu"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={secondaryBtnClasses}
                >
                    Source on GitHub
                </a>
            </div>
        </div>
    </section>
    <!-- Funding ------------------------------------------------------------->
    <section
        id="funding"
        class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
    >
        <div class={sectionInnerClasses}>
            <header class="nh-reveal max-w-3xl">
                <p class={kickerClasses}>Funding and support</p>
                <h2 class={sectionTitleClasses}>Who makes this possible</h2>
                <p class={sectionLeadClasses}>
                    NAHPU is free and open source. Its development has been
                    supported by public research funding, a mammalogy fund, and
                    institutional collaboration.
                </p>
            </header>

            <ul class="mt-12 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3">
                {funders.map((funder, index) => (
                    <li
                        class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-100/70 p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/50"
                        style={`transition-delay: ${index * 60}ms`}
                    >
                        <p class="text-[11px] font-semibold tracking-widest text-silver-tree-600 uppercase dark:text-silver-tree-400">
                            {funder.kind}
                        </p>
                        <h3 class="mt-4 text-lg font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                            {funder.name}
                        </h3>
                        <p class="mt-3 text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                            {funder.detail}
                        </p>
                        {funder.links && (
                            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                                {funder.links.map((link) => (
                                    <a
                                        class={linkClasses}
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {link.label}
                                    </a>
                                ))}
                            </p>
                        )}
                    </li>
                ))}
            </ul>

            <div class="nh-reveal mt-8 max-w-3xl">
                <p class="text-sm leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                    Other funding sources may have supported this project
                    through the work of individual contributors.
                </p>
                <p class="mt-4 border-l-2 border-silver-tree-400/60 pl-4 text-xs leading-relaxed text-silver-tree-600 dark:border-silver-tree-600/60 dark:text-silver-tree-400">
                    Any opinions, findings, and conclusions or recommendations
                    expressed in this material are those of the authors and do
                    not necessarily reflect the views of the funders.
                </p>
            </div>
        </div>
    </section>
</Layout>

<script>
    const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
        revealed.forEach((element) => element.classList.add("nh-in"));
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("nh-in");
                    observer.unobserve(entry.target);
                });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );
        revealed.forEach((element) => observer.observe(element));
    }

    const copyButton = document.getElementById("nh-copy-bibtex");
    copyButton?.addEventListener("click", async () => {
        const label = copyButton.textContent;
        try {
            await navigator.clipboard.writeText(copyButton.dataset.bibtex ?? "");
            copyButton.textContent = "Copied";
        } catch {
            copyButton.textContent = "Copy failed";
        }
        setTimeout(() => (copyButton.textContent = label), 2000);
    });
</script>
