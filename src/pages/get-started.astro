---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import TropicalMountains from "../components/landing/TropicalMountains.astro";
import cntl from "cntl";
import mtGede from "../assets/images/landscapes/handika-mtgede.webp";

import "../styles/global.css";
import "../styles/landing.css";

const sectionClasses = cntl`
  px-6 py-14 sm:py-16
`;

const innerClasses = cntl`
  mx-auto max-w-5xl
`;

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const titleClasses = cntl`
  mt-2 text-2xl sm:text-3xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const leadClasses = cntl`
  mt-3
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const mainBtnClasses = cntl`
  inline-flex items-center justify-center
  rounded-xl
  px-5 py-3
  bg-linear-to-r from-silver-tree-700 to-silver-tree-600
  dark:from-silver-tree-400 dark:to-silver-tree-300
  text-silver-tree-50 dark:text-silver-tree-950
  text-sm font-semibold no-underline
  shadow-lg shadow-silver-tree-700/20
  transition-transform duration-300
  hover:-translate-y-0.5
`;

const secondaryBtnClasses = cntl`
  inline-flex items-center justify-center
  rounded-xl
  px-5 py-3
  border border-silver-tree-700/70 dark:border-silver-tree-400/70
  text-silver-tree-800 dark:text-silver-tree-200
  text-sm font-semibold no-underline
  backdrop-blur-sm
  transition-colors duration-300
  hover:bg-silver-tree-700 hover:text-silver-tree-50
  dark:hover:bg-silver-tree-400 dark:hover:text-silver-tree-950
`;

const cardClasses = cntl`
  nh-reveal
  flex flex-col
  rounded-2xl
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-50/70 dark:bg-silver-tree-900/50
  p-6
`;

const cardTitleClasses = cntl`
  text-lg font-semibold
  text-silver-tree-900 dark:text-silver-tree-50
`;

const labelClasses = cntl`
  text-[11px] font-semibold uppercase tracking-widest
  text-silver-tree-600 dark:text-silver-tree-400
`;

const bodyTextClasses = cntl`
  text-sm leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const linkClasses = cntl`
  text-silver-tree-700 dark:text-silver-tree-200
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-900 dark:hover:text-silver-tree-50
`;

const commandClasses = cntl`
  mt-2 flex items-center gap-2
  rounded-lg
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-100 dark:bg-silver-tree-950/70
  py-1 pr-1 pl-3
`;

const commandTextClasses = cntl`
  min-w-0 flex-1 break-all
  py-1.5
  font-mono text-xs
  text-silver-tree-900 dark:text-silver-tree-100
`;

const copyBtnClasses = cntl`
  shrink-0
  rounded-md
  px-2.5 py-1
  bg-silver-tree-700 dark:bg-silver-tree-400
  text-xs font-semibold
  text-silver-tree-50 dark:text-silver-tree-950
  cursor-pointer
  transition-colors duration-200
  hover:bg-silver-tree-800 dark:hover:bg-silver-tree-300
`;

const stepNumberClasses = cntl`
  mt-0.5 flex h-6 w-6 shrink-0
  items-center justify-center
  rounded-full
  bg-silver-tree-200 text-silver-tree-800
  dark:bg-silver-tree-800 dark:text-silver-tree-100
  text-xs font-semibold
`;

interface PlatformLink {
  label: string;
  href: string;
}

/// A step's text is rendered as HTML so it can carry inline `code` and
/// emphasis. A step with a command shows it in its own copyable block.
type Step = string | { text: string; code: string };

interface Platform {
  id: string;
  color: string;
  name: string;
  devices: string;
  requirements: string[];
  steps: Step[];
  cta: PlatformLink;
  links: PlatformLink[];
  note?: string;
}

const journeySteps = [
  {
    number: "1",
    title: "Install NAHPU",
    desc: "Pick your device and download the app",
    href: "#install",
  },
  {
    number: "2",
    title: "Set up & Day 1",
    desc: "Configure the app and learn the data model",
    href: "#after-install",
  },
  {
    number: "3",
    title: "Follow a tutorial",
    desc: "Practice with real field data, teams, and exports",
    href: "#tutorials",
  },
];

const platforms: Platform[] = [
  {
    id: "android",
    color: "#2f9e7d",
    name: "Android",
    devices: "Phone and tablet",
    requirements: ["Android 7.0 (Nougat) or later"],
    steps: [
      "Open the Google Play listing with the button below.",
      "Tap <strong>Install</strong> and wait for the download to finish.",
      "Open NAHPU from your app drawer or home screen.",
    ],
    cta: {
      label: "Get it on Google Play",
      href: "https://play.google.com/store/apps/details?id=com.hhandika.nahpu",
    },
    links: [],
  },
  {
    id: "apple",
    color: "#3f9fd6",
    name: "Apple devices",
    devices: "iPhone, iPad, and Mac",
    requirements: [
      "iOS 15.6 or later",
      "iPadOS 15.6 or later",
      "macOS 12.4 or later (arm64 and x86_64)",
    ],
    note: "One App Store listing serves iPhone, iPad, and Mac. Apple detects and installs the version for your device.",
    steps: [
      "Open the App Store listing with the button below on your iPhone, iPad, or Mac.",
      "Tap or click <strong>Get</strong> and wait for the download to finish.",
      "Open NAHPU from your home screen, or on a Mac from the Applications folder or Launchpad.",
    ],
    cta: {
      label: "Download on the App Store",
      href: "https://apps.apple.com/us/app/nahpu/id1661448584?itscg=30200&itsct=apps_box_link&mttnsubad=1661448584",
    },
    links: [
      {
        label: "Oldest supported macOS devices",
        href: "https://support.apple.com/en-us/102861",
      },
      {
        label: "Device support for iOS and iPadOS",
        href: "https://iosref.com/ios",
      },
    ],
  },
  {
    id: "linux",
    color: "#e0913a",
    name: "Linux",
    devices: "Desktop and laptop",
    requirements: [
      "An x86_64 or arm64 (aarch64) distribution with GLIBC 2.35 or later, such as Ubuntu 22.04, Debian 12, Fedora 36, or RHEL and Rocky Linux 9",
    ],
    steps: [
      {
        text: "Run the install script in a terminal. It picks the right package for your distribution and processor, and when the Snap Store has NAHPU for your system, it asks whether you want the Snap, which updates itself.",
        code: "curl -fsSL https://nahpu.app/install.sh | bash",
      },
      "Open NAHPU from your application menu, or run <code>nahpu</code> in a terminal.",
    ],
    cta: {
      label: "Get it from the Snap Store",
      href: "https://snapcraft.io/nahpu",
    },
    links: [
      {
        label:
          "Linux installation guide: packages, signing key, and portable archive",
        href: "/en/installation/",
      },
    ],
  },
  {
    id: "windows",
    color: "#7c72d8",
    name: "Windows",
    devices: "Desktop and laptop",
    requirements: ["Windows 10 version 1809 (build 17763) or later (x64)"],
    steps: [
      "Download the NAHPU installer from Microsoft with the button below, or search for NAHPU in the Microsoft Store app.",
      "Open the downloaded installer, or select <strong>Get</strong> in the Microsoft Store app, and wait for the installation to finish.",
      "Open NAHPU from the Start menu.",
    ],
    cta: {
      label: "Download from the Microsoft Store",
      href: "https://get.microsoft.com/installer/download/9nx3z8p3nsml?referrer=appbadge",
    },
    links: [],
  },
];

const nextSteps = [
  {
    title: "Run the setup wizard",
    desc: "The setup wizard on the home screen walks you through field identifiers and the controlled vocabularies your team uses. Setup is done once and can be shared across devices.",
    links: [
      { label: "App setup best practices", href: "/en/best-practices/app-setup/" },
    ],
  },
  {
    title: "Read the Day 1 guide",
    desc: "Learn how projects, sites, collecting events, narratives, and specimens fit together. The same guide is bundled offline inside NAHPU under Cookbook in the menu drawer.",
    links: [{ label: "Open Day 1 guide", href: "/en/day-one/" }],
  },
  {
    title: "Prepare for fieldwork",
    desc: "Review backup habits, device care, and team workflows before heading out—or read the migration guide if you are transitioning from paper catalogs.",
    links: [
      { label: "Best Practices", href: "/en/best-practices/" },
      { label: "Switch to NAHPU", href: "/en/switch/" },
    ],
  },
];

const tutorials = [
  {
    badge: "9 lessons · ~2 hours",
    title: "Basic tutorials",
    desc: "Follow a real 2014 Mt. Tujuh small-mammal paper catalog and field journal from project creation, sites, events, specimens, and tissue curation to a Darwin Core Archive.",
    href: "/en/tutorials/basic/paper-catalog/",
    cta: "Start Basic tutorials",
  },
  {
    badge: "7 lessons · ~1 hour",
    title: "Teamwork tutorials",
    desc: "Practice multi-device fieldwork: share projects, sites, and collecting events by QR code, catalog in parallel across two devices, and merge catalogs cleanly.",
    href: "/en/tutorials/teamwork/plan-and-set-up/",
    cta: "Start Teamwork tutorials",
  },
  {
    badge: "4 tutorials",
    title: "Export tutorials",
    desc: "Build custom tabular export presets for museum databases like Specify, reshape NAHPU Data Packages with R or Python, and design printable two-sided voucher tags.",
    href: "/en/tutorials/export/specify-export-preset/",
    cta: "Explore Export tutorials",
  },
];
---

<Layout
  title="Get Started"
  description="Install NAHPU on Android, Apple devices, Linux, or Windows, set up your first project, and follow hands-on tutorials."
  overlayNav
>
  <!-- Header -------------------------------------------------------------->
  <section
    class="nh-hero relative flex min-h-[46svh] items-end px-6 pt-28 pb-10"
  >
    <div class="nh-hero-bg" aria-hidden="true">
      <div class="nh-blob nh-blob-teal"></div>
      <div class="nh-blob nh-blob-gold"></div>
      <Image
        src={mtGede}
        alt=""
        widths={[1200, 2400]}
        sizes="100vw"
        class="nh-hero-photo"
        loading="eager"
      />
      <div class="nh-hero-scrim"></div>
      <div class="nh-hero-fade"></div>
    </div>

    <div class={`${innerClasses} w-full`}>
      <p class={kickerClasses}>Get started</p>
      <h1
        class="mt-3 text-4xl font-bold text-silver-tree-950 sm:text-5xl dark:text-silver-tree-50"
      >
        Install NAHPU and learn the workflow
      </h1>
      <p
        class="mt-4 max-w-2xl text-lg text-silver-tree-800 dark:text-silver-tree-200"
      >
        NAHPU is free, open source, and runs offline on Android, Apple devices,
        Linux, and Windows. Follow three steps to install the app, learn the
        basics, and practice with real field data.
      </p>

      <!-- Three-step roadmap visible above the fold -->
      <nav
        aria-label="Getting started steps"
        class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-3"
      >
        {
          journeySteps.map((step) => (
            <a
              href={step.href}
              class="group flex items-start gap-3 rounded-xl border border-silver-tree-300/80 bg-silver-tree-50/80 p-4 no-underline backdrop-blur-sm transition-colors duration-200 hover:border-silver-tree-500 hover:bg-silver-tree-50 dark:border-silver-tree-700/80 dark:bg-silver-tree-900/70 dark:hover:border-silver-tree-400 dark:hover:bg-silver-tree-900"
            >
              <span class={stepNumberClasses}>{step.number}</span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-silver-tree-950 group-hover:text-silver-tree-700 dark:text-silver-tree-50 dark:group-hover:text-silver-tree-200">
                  {step.title}
                </span>
                <span class="mt-0.5 block text-xs leading-relaxed text-silver-tree-700 dark:text-silver-tree-300">
                  {step.desc}
                </span>
              </span>
            </a>
          ))
        }
      </nav>

      <p
        class="mt-5 text-[11px] tracking-wide text-silver-tree-700 dark:text-silver-tree-400"
      >
        Taken at Mt. Gede by Heru Handika.
      </p>
    </div>
  </section>

  <!-- Latest release ------------------------------------------------------->
  <section
    class="relative isolate overflow-hidden bg-silver-tree-100 px-6 py-10 sm:py-12 dark:bg-silver-tree-950"
  >
    <TropicalMountains />

    <div class={innerClasses}>
      <div
        class="nh-reveal rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/90 p-5 backdrop-blur-sm sm:p-6 dark:border-silver-tree-700/70 dark:bg-silver-tree-900/80"
      >
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
        >
          <div class="max-w-3xl">
            <p class={labelClasses}>Latest release</p>
            <h2
              class="mt-2 text-lg font-semibold text-silver-tree-900 sm:text-xl dark:text-silver-tree-50"
            >
              NAHPU v1.3.0 is out
            </h2>
            <p class={`${bodyTextClasses} mt-2`}>
              Version 1.3.0 adds support for symbionts, expanding the previously
              supported parasite-only records with an interaction type that
              exports to Darwin Core. Data table columns now resize by dragging,
              and the column picker can search fields.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-x-4 gap-y-2 text-sm sm:flex-col sm:items-end">
            <a
              class={linkClasses}
              href="https://github.com/nahpu/nahpu/releases"
              target="_blank"
              rel="noopener noreferrer">All release notes</a
            >
            <a
              class={linkClasses}
              href="https://github.com/nahpu/nahpu/issues"
              target="_blank"
              rel="noopener noreferrer">Report an issue</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 1: Installation ------------------------------------------------->
  <section
    id="install"
    class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
  >
    <div class={innerClasses}>
      <header class="nh-reveal max-w-3xl">
        <p class={kickerClasses}>Step 1 of 3</p>
        <h2 class={titleClasses}>Install NAHPU</h2>
        <p class={leadClasses}>
          Every platform installs the same catalog and reads the same project
          files, so you can start on a phone and continue on a desktop.
          Downloads always point at the latest release.
        </p>
      </header>

      <!-- Platform switcher tabs -->
      <div
        role="tablist"
        aria-label="Choose your platform"
        class="nh-reveal mt-6 flex flex-wrap gap-2"
      >
        {
          platforms.map((platform, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${platform.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${platform.id}`}
              data-platform-tab={platform.id}
              class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-silver-tree-300/80 bg-silver-tree-50/70 px-4 py-2.5 text-sm font-semibold text-silver-tree-800 transition-colors duration-200 hover:border-silver-tree-500 aria-selected:border-silver-tree-700 aria-selected:bg-silver-tree-700 aria-selected:text-silver-tree-50 dark:border-silver-tree-700/80 dark:bg-silver-tree-950/50 dark:text-silver-tree-200 dark:hover:border-silver-tree-500 dark:aria-selected:border-silver-tree-400 dark:aria-selected:bg-silver-tree-400 dark:aria-selected:text-silver-tree-950"
            >
              <span
                class="block h-2.5 w-2.5 shrink-0 rounded-full"
                style={`background:${platform.color}`}
                aria-hidden="true"
              />
              <span>{platform.name}</span>
              <span
                data-current-badge
                class="hidden rounded-full bg-silver-tree-200/90 px-2 py-0.5 text-[10px] font-semibold text-silver-tree-900 dark:bg-silver-tree-800 dark:text-silver-tree-100"
              >
                This device
              </span>
            </button>
          ))
        }
      </div>

      <!-- Active platform panel -->
      <div class="mt-4">
        {
          platforms.map((platform, index) => (
            <article
              id={`panel-${platform.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${platform.id}`}
              data-platform-panel={platform.id}
              hidden={index !== 0}
              class="rounded-2xl border border-silver-tree-300/70 bg-silver-tree-50/90 p-6 sm:p-8 dark:border-silver-tree-700/70 dark:bg-silver-tree-950/60"
            >
              <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.25fr_1fr]">
                <div>
                  <div class="flex items-center gap-2">
                    <span
                      class="block h-2.5 w-2.5 rounded-full"
                      style={`background:${platform.color}`}
                      aria-hidden="true"
                    />
                    <span class={labelClasses}>{platform.devices}</span>
                  </div>
                  <h3 class="mt-2 text-xl font-semibold text-silver-tree-950 dark:text-silver-tree-50">
                    {platform.name}
                  </h3>

                  <p class={`${labelClasses} mt-5`}>Installation steps</p>
                  <ol class="mt-3 flex flex-col gap-3">
                    {platform.steps.map((step, stepIndex) => {
                      const { text, code } =
                        typeof step === "string"
                          ? { text: step, code: undefined }
                          : step;
                      return (
                        <li class="flex gap-3">
                          <span class={stepNumberClasses}>{stepIndex + 1}</span>
                          <div class="min-w-0 flex-1">
                            <span class={bodyTextClasses} set:html={text} />
                            {code && (
                              <div class={commandClasses}>
                                <code class={commandTextClasses}>{code}</code>
                                <button
                                  type="button"
                                  class={copyBtnClasses}
                                  data-copy={code}
                                  aria-label={`Copy command: ${code}`}
                                >
                                  Copy
                                </button>
                              </div>
                            )}
                          </div>
                        </li>
                      );
                    })}
                  </ol>
                </div>

                <div class="flex flex-col justify-between rounded-xl border border-silver-tree-300/60 bg-silver-tree-100/70 p-5 dark:border-silver-tree-700/60 dark:bg-silver-tree-900/60">
                  <div>
                    <p class={labelClasses}>Requirements</p>
                    <ul class="mt-2 flex flex-col gap-1">
                      {platform.requirements.map((requirement) => (
                        <li class={bodyTextClasses}>{requirement}</li>
                      ))}
                    </ul>

                    {platform.note && (
                      <p class={`${bodyTextClasses} mt-3`}>{platform.note}</p>
                    )}

                    {platform.links.length > 0 && (
                      <ul class="mt-4 flex flex-col gap-1">
                        {platform.links.map((link) => (
                          <li class={bodyTextClasses}>
                            <a
                              class={linkClasses}
                              href={link.href}
                              {...(link.href.startsWith("http")
                                ? {
                                    target: "_blank",
                                    rel: "noopener noreferrer",
                                  }
                                : {})}
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>

                  <div class="mt-6">
                    <a
                      class={`${mainBtnClasses} w-full`}
                      href={platform.cta.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-download-cta
                    >
                      {platform.cta.label}
                    </a>
                    <p class="mt-3 text-center text-xs text-silver-tree-700 dark:text-silver-tree-300">
                      Next while it installs:{" "}
                      <a class={linkClasses} href="#after-install">
                        Step 2 (Day 1)
                      </a>{" "}
                      or{" "}
                      <a class={linkClasses} href="#tutorials">
                        Step 3 (Tutorials)
                      </a>
                    </p>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Highlighted banner revealed after a user clicks a download button or copies the install command -->
      <div
        id="post-download-banner"
        class="mt-4 hidden rounded-2xl border border-silver-tree-500/70 bg-silver-tree-50 p-5 shadow-md dark:border-silver-tree-400/60 dark:bg-silver-tree-950/80"
        role="status"
      >
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <p class={labelClasses}>While NAHPU installs</p>
            <p
              class="mt-1 text-sm font-medium text-silver-tree-950 dark:text-silver-tree-50"
            >
              Do not stop here—learn the core workflow in the Day 1 guide or
              follow the Basic tutorials with real field data.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-3">
            <a href="/en/day-one/" class={mainBtnClasses}>Read Day 1 guide</a>
            <a href="/en/tutorials/basic/paper-catalog/" class={secondaryBtnClasses}
              >Start Basic tutorials</a
            >
          </div>
        </div>
      </div>

      <p class={`${bodyTextClasses} nh-reveal mt-5`}>
        Looking for an older build or portable Linux packages? See the <a
          class={linkClasses}
          href="https://github.com/nahpu/nahpu/releases"
          target="_blank"
          rel="noopener noreferrer">NAHPU releases page</a
        > or the <a class={linkClasses} href="/en/installation/"
          >full installation documentation</a
        >.
      </p>
    </div>
  </section>

  <!-- Step 2: After you install -------------------------------------------->
  <section
    id="after-install"
    class={`${sectionClasses} bg-silver-tree-100 dark:bg-silver-tree-950`}
  >
    <div class={innerClasses}>
      <header class="nh-reveal max-w-3xl">
        <p class={kickerClasses}>Step 2 of 3</p>
        <h2 class={titleClasses}>Set up and learn the basics</h2>
        <p class={leadClasses}>
          Once NAHPU is open, take a few minutes to configure your workspace and
          walk through the <a class={linkClasses} href="/en/day-one/"
            >Day 1 guide</a
          > before relying on it in the field.
        </p>
      </header>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          nextSteps.map((item, index) => (
            <article
              class={cardClasses}
              style={`transition-delay: ${index * 60}ms`}
            >
              <span class={stepNumberClasses}>{index + 1}</span>
              <h3 class={`${cardTitleClasses} mt-3`}>{item.title}</h3>
              <p class={`${bodyTextClasses} mt-2`}>{item.desc}</p>
              <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-sm">
                {item.links.map((link) => (
                  <a class={linkClasses} href={link.href}>
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Step 3: Hands-on tutorials ------------------------------------------->
  <section
    id="tutorials"
    class={`${sectionClasses} bg-silver-tree-200/60 dark:bg-silver-tree-900`}
  >
    <div class={innerClasses}>
      <header class="nh-reveal max-w-3xl">
        <p class={kickerClasses}>Step 3 of 3</p>
        <h2 class={titleClasses}>Practice with hands-on tutorials</h2>
        <p class={leadClasses}>
          You do not have to invent practice data. Work through a complete field
          survey from paper notes to museum-ready exports, or practice
          multi-device teamwork with a colleague.
        </p>
      </header>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          tutorials.map((tutorial, index) => (
            <article
              class={cardClasses}
              style={`transition-delay: ${index * 60}ms`}
            >
              <p class={labelClasses}>{tutorial.badge}</p>
              <h3 class={`${cardTitleClasses} mt-2`}>{tutorial.title}</h3>
              <p class={`${bodyTextClasses} mt-2`}>{tutorial.desc}</p>
              <div class="mt-auto pt-5">
                <a class={secondaryBtnClasses} href={tutorial.href}>
                  {tutorial.cta}
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="nh-reveal mt-8 flex flex-wrap items-center gap-4">
        <a href="/en/tutorials/basic/paper-catalog/" class={mainBtnClasses}
          >Start the Basic tutorials</a
        >
        <a href="/en/#quick-start" class={secondaryBtnClasses}
          >Read the full Quick Start</a
        >
      </div>
    </div>
  </section>
</Layout>

<script>
  const platformIds = ["android", "apple", "linux", "windows"];

  /// Detect the visitor's operating system so their platform tab opens first.
  /// Android is matched before Linux because Android user agents also carry
  /// the word "Linux".
  const detectPlatformId = (): string | null => {
    const agent = navigator.userAgent;
    const uaData = (
      navigator as Navigator & { userAgentData?: { platform?: string } }
    ).userAgentData;
    const hint = `${uaData?.platform ?? ""} ${agent}`;

    // ChromeOS installs the Android build rather than the Linux archive.
    if (/Android|CrOS/i.test(hint)) return "android";
    // iPadOS reports a Macintosh user agent, so both land on Apple anyway.
    if (/iPhone|iPad|iPod|Macintosh|Mac OS X|macOS/i.test(hint)) {
      return "apple";
    }
    if (/Windows/i.test(hint)) return "windows";
    if (/Linux|X11/i.test(hint)) return "linux";
    return null;
  };

  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-platform-tab]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-platform-panel]"),
  );

  const selectPlatform = (platformId: string, focusTab = false) => {
    tabs.forEach((tab) => {
      const selected = tab.dataset.platformTab === platformId;
      tab.setAttribute("aria-selected", selected ? "true" : "false");
      tab.tabIndex = selected ? 0 : -1;
      if (selected && focusTab) tab.focus();
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.platformPanel !== platformId;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.platformTab;
      if (id) selectPlatform(id);
    });

    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      const delta = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(index + delta + tabs.length) % tabs.length];
      const nextId = next?.dataset.platformTab;
      if (nextId) selectPlatform(nextId, true);
    });
  });

  const detectedId = detectPlatformId();
  if (detectedId) {
    const detectedTab = tabs.find(
      (tab) => tab.dataset.platformTab === detectedId,
    );
    detectedTab
      ?.querySelector("[data-current-badge]")
      ?.classList.remove("hidden");
  }

  const hashPlatform = window.location.hash.replace(/^#/, "");
  const initialPlatform = platformIds.includes(hashPlatform)
    ? hashPlatform
    : (detectedId ?? "android");
  selectPlatform(initialPlatform);

  if (platformIds.includes(hashPlatform)) {
    document.getElementById("install")?.scrollIntoView();
  }

  const revealPostDownload = () => {
    document
      .getElementById("post-download-banner")
      ?.classList.remove("hidden");
  };

  document
    .querySelectorAll<HTMLAnchorElement>("[data-download-cta]")
    .forEach((link) => {
      link.addEventListener("click", revealPostDownload);
    });

  /// Copy a step's command. When the clipboard is unavailable, select the
  /// command so the visitor can copy it themselves.
  document
    .querySelectorAll<HTMLButtonElement>("button[data-copy]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const command = button.dataset.copy ?? "";
        revealPostDownload();
        try {
          await navigator.clipboard.writeText(command);
          button.textContent = "Copied";
          setTimeout(() => (button.textContent = "Copy"), 2000);
        } catch {
          const code = button.previousElementSibling;
          if (code) window.getSelection()?.selectAllChildren(code);
        }
      });
    });

  const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealed.forEach((element) => element.classList.add("nh-in"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("nh-in");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );
    revealed.forEach((element) => observer.observe(element));
  }
</script>
