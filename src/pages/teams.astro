---
import Layout from "../layouts/Layout.astro";
import TeamMember from "../components/TeamMember.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import cntl from "cntl";
import gymnure from "../assets/images/animals/handika-gymnure.webp";
import { byName, byOrderThenName, primaryUrl } from "../data/team";
import { acknowledgments } from "../data/acknowledgments";

import "../styles/global.css";
import "../styles/landing.css";

const kickerClasses = cntl`
  text-xs font-semibold uppercase tracking-[0.2em]
  text-silver-tree-600 dark:text-silver-tree-400
`;

const sectionTitleClasses = cntl`
  mt-3 text-3xl sm:text-4xl font-semibold
  text-silver-tree-950 dark:text-silver-tree-50
`;

const sectionLeadClasses = cntl`
  mt-4 max-w-2xl
  text-base leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
`;

const inlineLinkClasses = cntl`
  text-silver-tree-800 dark:text-silver-tree-100
  underline underline-offset-2
  decoration-silver-tree-400
  hover:text-silver-tree-950 dark:hover:text-silver-tree-50
`;

const members = await getCollection("team");
const past = members
    .filter((member) => member.data.group === "past")
    .sort(byName);

/// Markdown bodies render asynchronously, so resolve them before the template.
const core = await Promise.all(
    members
        .filter((member) => member.data.group === "core")
        .sort(byOrderThenName)
        .map(async (member) => ({
            ...member,
            Bio: (await render(member)).Content,
        })),
);
---

<Layout
    title="NAHPU Team"
    description="Meet the team behind the NAHPU project."
    overlayNav
>
    <!-- Header -------------------------------------------------------------->
    <section
        class="nh-hero relative flex min-h-[46svh] items-end px-6 pt-32 pb-12"
    >
        <div class="nh-hero-bg" aria-hidden="true">
            <div class="nh-blob nh-blob-teal"></div>
            <div class="nh-blob nh-blob-gold"></div>
            <div class="nh-blob nh-blob-deep"></div>
            <div class="nh-hero-scrim"></div>
        </div>

        <div class="mx-auto w-full max-w-6xl">
            <p class={kickerClasses}>The people behind it</p>
            <h1
                class="mt-3 text-4xl font-bold text-silver-tree-950 sm:text-5xl dark:text-silver-tree-50"
            >
                NAHPU Team
            </h1>
            <p
                class="mt-5 max-w-2xl text-lg text-silver-tree-800 dark:text-silver-tree-200"
            >
                {core.length} curators, collection managers, field biologists, and
                software engineers building NAHPU across museums and universities.
            </p>
        </div>
    </section>

    <!-- Core members --------------------------------------------------------->
    <section
        class="px-6 py-16 sm:py-20 bg-silver-tree-100 dark:bg-silver-tree-950"
    >
        <div class="mx-auto max-w-6xl">
            <div
                class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-3"
            >
                {
                    core.map(({ data, Bio }) => (
                        <TeamMember data={data}>
                            <Bio />
                        </TeamMember>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Past members --------------------------------------------------------->
    <section
        class="px-6 py-16 sm:py-20 bg-silver-tree-200/60 dark:bg-silver-tree-900"
    >
        <div class="mx-auto max-w-6xl">
            <header class="nh-reveal">
                <p class={kickerClasses}>Credit where it is due</p>
                <h2 class={sectionTitleClasses}>
                    Past members and key contributors
                </h2>
                <p class={sectionLeadClasses}>
                    People who sustained their contribution to build NAHPU,
                    through feedback and code that is still part of the app
                    today.
                </p>
            </header>

            <dl
                class="nh-reveal mt-10 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3"
            >
                {
                    past.map((member) => {
                        const href = primaryUrl(member.data);
                        return (
                            <div class="border-t border-silver-tree-300/70 pt-4 dark:border-silver-tree-700/70">
                                <dt class="text-base font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                                    {href ? (
                                        <a
                                            href={href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-silver-tree-900 no-underline transition-colors hover:text-silver-tree-600 dark:text-silver-tree-50 dark:hover:text-silver-tree-300"
                                        >
                                            {member.data.name}
                                        </a>
                                    ) : (
                                        member.data.name
                                    )}
                                </dt>
                                <dd class="mt-1 ml-0 text-sm text-silver-tree-700 dark:text-silver-tree-300">
                                    {member.data.institution}
                                </dd>
                            </div>
                        );
                    })
                }
            </dl>
        </div>
    </section>

    <!-- Acknowledgments ------------------------------------------------------>
    <section
        class="px-6 py-16 sm:py-20 bg-silver-tree-100 dark:bg-silver-tree-950"
    >
        <div class="mx-auto max-w-6xl">
            <header class="nh-reveal">
                <p class={kickerClasses}>Acknowledgments</p>
                <h2 class={sectionTitleClasses}>Thank you for the feedback</h2>
                <p class={sectionLeadClasses}>
                    NAHPU is a collaborative project among museum and computer
                    scientists. Many thanks to the following people for their
                    contributions and feedback:
                </p>
            </header>

            <p
                class="nh-reveal mt-6 max-w-4xl text-base leading-loose text-silver-tree-700 dark:text-silver-tree-300"
            >
                {
                    acknowledgments.map((person, index) => (
                        <>
                            {index > 0 && ", "}
                            {person.url ? (
                                <a
                                    href={person.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={inlineLinkClasses}
                                >
                                    {person.name}
                                </a>
                            ) : (
                                person.name
                            )}
                        </>
                    ))
                }.
            </p>
        </div>
    </section>

    <!-- Join ----------------------------------------------------------------->
    <section
        class="px-6 py-16 sm:py-20 bg-silver-tree-200/60 dark:bg-silver-tree-900"
    >
        <div class="mx-auto max-w-6xl">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
                <div class="nh-reveal">
                    <p class={kickerClasses}>Contribute</p>
                    <h2
                        class="mt-3 text-3xl font-semibold text-silver-tree-950 sm:text-4xl dark:text-silver-tree-50"
                    >
                        The team is open
                    </h2>
                    <p
                        class="mt-4 max-w-xl text-base leading-relaxed text-silver-tree-700 dark:text-silver-tree-300"
                    >
                        NAHPU grows through collaboration with curators,
                        collection managers, and developers. New taxon formats,
                        translations, documentation, and code contributions are
                        all welcome — as is a conversation about what your
                        collection needs.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <a
                            href="/en/contributing"
                            class="rounded-xl bg-linear-to-r from-silver-tree-700 to-silver-tree-600 px-6 py-3.5 font-semibold text-silver-tree-50 no-underline shadow-lg shadow-silver-tree-700/20 transition-transform duration-300 hover:-translate-y-0.5 dark:from-silver-tree-400 dark:to-silver-tree-300 dark:text-silver-tree-950"
                            >How to contribute</a
                        >
                        <a
                            href="https://github.com/nahpu"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="rounded-xl border border-silver-tree-700/70 px-6 py-3.5 font-semibold text-silver-tree-800 no-underline transition-colors duration-300 hover:bg-silver-tree-700 hover:text-silver-tree-50 dark:border-silver-tree-400/70 dark:text-silver-tree-200 dark:hover:bg-silver-tree-400 dark:hover:text-silver-tree-950"
                            >Source on GitHub</a
                        >
                    </div>
                </div>

                <figure
                    class="nh-reveal nh-tile overflow-hidden rounded-2xl border border-silver-tree-300/60 shadow-lg dark:border-silver-tree-700/60"
                >
                    <Image
                        src={gymnure}
                        alt="A short-tailed gymnure feeding on an earthworm in green moss"
                        widths={[400, 800]}
                        sizes="(min-width: 800px) 45vw, 92vw"
                        class="aspect-[3/2] h-auto w-full object-cover"
                        loading="lazy"
                    />
                    <figcaption
                        class="flex items-center bg-silver-tree-200/70 px-4 py-2.5 text-xs text-silver-tree-800 dark:bg-silver-tree-900/70 dark:text-silver-tree-200"
                    >
                        <span
                            >Short-tailed gymnure, photographed by Heru Handika</span
                        >
                    </figcaption>
                </figure>
            </div>
        </div>
    </section>
</Layout>

<script>
    const revealed = document.querySelectorAll<HTMLElement>(".nh-reveal");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
        revealed.forEach((element) => element.classList.add("nh-in"));
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add("nh-in");
                    observer.unobserve(entry.target);
                });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        revealed.forEach((element) => observer.observe(element));
    }
</script>
