---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Screen = "large" | "small";

interface Pin {
  id: string;
  screen: Screen;
  x: number;
  y: number;
  label: string;
}

interface Props {
  /// Path under `src/assets/images/`, such as `app-screenshots/usage/sites-large.webp`.
  large: string;
  small: string;
  largeAlt: string;
  smallAlt: string;
  /// Collected from child `{% pin /%}` tags by the Markdoc transform.
  pins?: Pin[];
}

const { large, small, largeAlt, smallAlt, pins = [] } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

function resolveImage(path: string): ImageMetadata {
  const image = images[`/src/assets/images/${path}`];
  if (!image) {
    throw new Error(`Screenshot not found in src/assets/images: ${path}`);
  }
  return image.default;
}

const screenLabels: Record<string, Record<Screen | "key", string>> = {
  en: { large: "Large screen", small: "Small screen", key: "Screenshot key" },
  pt: { large: "Tela grande", small: "Tela pequena", key: "Legenda das capturas" },
  es: { large: "Pantalla grande", small: "Pantalla pequeña", key: "Leyenda de las capturas" },
  id: { large: "Layar besar", small: "Layar kecil", key: "Keterangan tangkapan layar" },
};
const locale = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "en";
const labels = screenLabels[locale] ?? screenLabels.en;

const screens: { screen: Screen; src: ImageMetadata; alt: string; width: number }[] = [
  { screen: "large", src: resolveImage(large), alt: largeAlt, width: 1200 },
  { screen: "small", src: resolveImage(small), alt: smallAlt, width: 420 },
];
---

<div class="nh-shots not-content" id="usage-screenshots">
  <div class="nh-shots__pair">
    {
      screens.map(({ screen, src, alt, width }) => (
        <figure class:list={["nh-shots__screen", `nh-shots__screen--${screen}`]}>
          <div class="nh-shots__frame">
            <Image src={src} alt={alt} width={width} densities={[1.5, 2]} quality="high" />
            {pins
              .filter((pin) => pin.screen === screen)
              .map((pin) => (
                <a
                  class="nh-shots__pin"
                  href={`#shot-ref-${pin.id}`}
                  data-shot-ref={pin.id}
                  style={`left:${pin.x}%;top:${pin.y}%`}
                  aria-label={`${pin.id}: ${pin.label}`}
                >
                  {pin.id}
                </a>
              ))}
          </div>
          <figcaption>{labels[screen]}</figcaption>
        </figure>
      ))
    }
  </div>
  {
    pins.length > 0 && (
      <ul class="nh-shots__key" aria-label={labels.key}>
        {pins.map((pin) => (
          <li>
            <a href={`#shot-ref-${pin.id}`} data-shot-ref={pin.id}>
              <span class="nh-shots__chip">{pin.id}</span>
              <span class="nh-shots__label">{pin.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .nh-shots {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem 2rem;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
  }

  .nh-shots__pair {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: end;
  }

  .nh-shots__screen {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
  }

  .nh-shots__screen figcaption {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nh-shots__frame {
    position: relative;
    container-type: inline-size;
  }

  .nh-shots__frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.625rem;
  }

  .nh-shots__pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: clamp(1.05rem, 5cqw, 1.625rem);
    height: clamp(1.05rem, 5cqw, 1.625rem);
    transform: translate(-50%, -50%);
    border: 2px solid var(--sl-color-bg);
    border-radius: 0.45rem;
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
    font-size: clamp(0.62rem, 3cqw, 0.8rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .nh-shots__key {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
    list-style: none;
    font-size: var(--sl-text-sm);
  }

  .nh-shots__key a {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding-block: 0.125rem;
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .nh-shots__key a:hover .nh-shots__label,
  .nh-shots__key a:focus-visible .nh-shots__label {
    text-decoration: underline;
  }

  .nh-shots__chip {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.3rem;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .nh-shots__pin:hover,
  .nh-shots__pin:focus-visible,
  .nh-shots__pin:global(.is-active) {
    transform: translate(-50%, -50%) scale(1.25);
    background: var(--sl-color-orange);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--sl-color-orange) 30%, transparent);
    outline: none;
  }

  .nh-shots__key a:hover .nh-shots__chip,
  .nh-shots__key a:focus-visible .nh-shots__chip,
  .nh-shots__chip:global(.is-active) {
    background: var(--sl-color-orange);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-orange) 30%, transparent);
  }

  @media (max-width: 40rem) {
    .nh-shots__pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .nh-shots__screen--small {
      width: min(100%, 16rem);
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nh-shots__pin,
    .nh-shots__chip {
      transition: none;
    }
  }
</style>

<script>
  const figure = document.getElementById("usage-screenshots");
  const refs = [...document.querySelectorAll<HTMLElement>(".nh-shot-ref[data-shot-ref]")];
  const smooth = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

  // The first mention of each letter in the text becomes the target of its pin and key entry.
  for (const ref of refs) {
    const target = `shot-ref-${ref.dataset.shotRef}`;
    if (!document.getElementById(target)) ref.id = target;
  }

  const highlightTargets = (id: string) =>
    document.querySelectorAll<HTMLElement>(
      `.nh-shots__pin[data-shot-ref="${id}"], .nh-shots__key [data-shot-ref="${id}"] .nh-shots__chip, .nh-shot-ref[data-shot-ref="${id}"]`,
    );

  const setActive = (id: string, active: boolean) =>
    highlightTargets(id).forEach((el) => el.classList.toggle("is-active", active));

  const flash = (id: string) => {
    setActive(id, true);
    setTimeout(() => setActive(id, false), 1600);
  };

  const linked = document.querySelectorAll<HTMLElement>("[data-shot-ref]");
  for (const el of linked) {
    const id = el.dataset.shotRef;
    if (!id) continue;
    el.addEventListener("mouseenter", () => setActive(id, true));
    el.addEventListener("mouseleave", () => setActive(id, false));
    el.addEventListener("focus", () => setActive(id, true));
    el.addEventListener("blur", () => setActive(id, false));
    el.addEventListener("click", (event) => {
      event.preventDefault();
      const toFigure = el.classList.contains("nh-shot-ref");
      const destination = toFigure ? figure : document.getElementById(`shot-ref-${id}`);
      destination?.scrollIntoView({ behavior: smooth, block: toFigure ? "start" : "center" });
      flash(id);
    });
  }
</script>
