---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Screen = "large" | "small";
type Slot = "large" | "large2" | "small" | "small2";
type Placement = [number, number];

interface Pin {
  id: string;
  label: string;
  large?: Placement;
  large2?: Placement;
  small?: Placement;
  small2?: Placement;
}

interface Props {
  /// Path under `src/assets/images/`, such as `app-screenshots/usage/sites-large.webp`.
  large: string;
  largeAlt: string;
  large2?: string;
  large2Alt?: string;
  small: string;
  smallAlt: string;
  small2?: string;
  small2Alt?: string;
  /// Collected from child `{% pin /%}` tags by the Markdoc transform. Every pin is placed
  /// on at least one capture of each screen size.
  pins?: Pin[];
}

const props = Astro.props;
const pins = props.pins ?? [];

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

function resolveImage(path: string): ImageMetadata {
  const image = images[`/src/assets/images/${path}`];
  if (!image) {
    throw new Error(`Screenshot not found in src/assets/images: ${path}`);
  }
  return image.default;
}

const screenLabels: Record<string, Record<Screen | "key" | "switch", string>> = {
  en: {
    large: "Large screen",
    small: "Small screen",
    key: "Screenshot key",
    switch: "Screen size",
  },
  pt: {
    large: "Tela grande",
    small: "Tela pequena",
    key: "Legenda das capturas",
    switch: "Tamanho da tela",
  },
  es: {
    large: "Pantalla grande",
    small: "Pantalla pequeña",
    key: "Leyenda de las capturas",
    switch: "Tamaño de pantalla",
  },
  id: {
    large: "Layar besar",
    small: "Layar kecil",
    key: "Keterangan tangkapan layar",
    switch: "Ukuran layar",
  },
};
const locale = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "en";
const labels = screenLabels[locale] ?? screenLabels.en;

const slotsByScreen: Record<Screen, Slot[]> = {
  large: ["large", "large2"],
  small: ["small", "small2"],
};
const widths: Record<Screen, number> = { large: 1200, small: 420 };

const panels = (["large", "small"] as const).map((screen) => ({
  screen,
  shots: slotsByScreen[screen]
    .filter((slot) => props[slot])
    .map((slot) => ({
      slot,
      src: resolveImage(props[slot] as string),
      alt: props[`${slot}Alt`] as string,
      pins: pins.flatMap((pin) => {
        const placement = pin[slot];
        return placement ? [{ ...pin, x: placement[0], y: placement[1] }] : [];
      }),
    })),
}));
---

<div class="nh-shots not-content" id="usage-screenshots">
  <div class="nh-shots__switch" role="group" aria-label={labels.switch} hidden>
    {
      panels.map(({ screen }) => (
        <button type="button" data-screen={screen} aria-pressed="false">
          {labels[screen]}
        </button>
      ))
    }
  </div>
  {
    panels.map(({ screen, shots }) => (
      <section
        class:list={["nh-shots__panel", `nh-shots__panel--${screen}`]}
        data-screen={screen}
        data-count={shots.length}
        aria-label={labels[screen]}
      >
        <p class="nh-shots__caption">{labels[screen]}</p>
        <div class="nh-shots__row">
          {shots.map(({ src, alt, pins: shotPins }) => (
            <figure class="nh-shots__screen">
              <div class="nh-shots__frame">
                <Image
                  src={src}
                  alt={alt}
                  width={widths[screen]}
                  densities={[1.5, 2]}
                  quality="high"
                />
                {shotPins.map((pin) => (
                  <a
                    class="nh-shots__pin"
                    href={`#shot-ref-${pin.id}`}
                    data-shot-ref={pin.id}
                    style={`left:${pin.x}%;top:${pin.y}%`}
                    aria-label={`${pin.id}: ${pin.label}`}
                  >
                    {pin.id}
                  </a>
                ))}
              </div>
            </figure>
          ))}
        </div>
      </section>
    ))
  }
  {
    pins.length > 0 && (
      <ul class="nh-shots__key" aria-label={labels.key}>
        {pins.map((pin) => (
          <li>
            <a href={`#shot-ref-${pin.id}`} data-shot-ref={pin.id}>
              <span class="nh-shots__chip">{pin.id}</span>
              <span class="nh-shots__label">{pin.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .nh-shots {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem 2rem;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
  }

  .nh-shots__switch {
    display: inline-flex;
    justify-self: start;
    padding: 0.1875rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
  }

  .nh-shots__switch[hidden] {
    display: none;
  }

  .nh-shots__switch button {
    padding: 0.3rem 0.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .nh-shots__switch button[aria-pressed="true"] {
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
  }

  .nh-shots__switch button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .nh-shots__panel {
    display: grid;
    gap: 0.375rem;
  }

  /* With the switch active, only the chosen screen size is shown. */
  .nh-shots.is-switchable .nh-shots__panel:not(.is-current) {
    display: none;
  }

  .nh-shots.is-switchable .nh-shots__caption {
    display: none;
  }

  .nh-shots__caption {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Large captures stack at full width so their text stays legible; phone captures sit side by
     side. */
  .nh-shots__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .nh-shots__panel--small .nh-shots__row {
    grid-template-columns: repeat(var(--nh-shot-count, 1), minmax(0, 16rem));
    justify-content: center;
  }

  .nh-shots__panel--small[data-count="2"] {
    --nh-shot-count: 2;
  }

  .nh-shots__screen {
    min-width: 0;
    margin: 0;
  }

  .nh-shots__frame {
    position: relative;
    container-type: inline-size;
  }

  .nh-shots__frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.625rem;
  }

  .nh-shots__pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: clamp(1.05rem, 5cqw, 1.625rem);
    height: clamp(1.05rem, 5cqw, 1.625rem);
    transform: translate(-50%, -50%);
    border: 2px solid var(--sl-color-bg);
    border-radius: 0.45rem;
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
    font-size: clamp(0.62rem, 3cqw, 0.8rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .nh-shots__panel--small .nh-shots__pin {
    width: clamp(1.05rem, 9cqw, 1.625rem);
    height: clamp(1.05rem, 9cqw, 1.625rem);
    font-size: clamp(0.62rem, 5.5cqw, 0.8rem);
  }

  .nh-shots__key {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
    list-style: none;
    font-size: var(--sl-text-sm);
  }

  .nh-shots__key a {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding-block: 0.125rem;
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .nh-shots__key a:hover .nh-shots__label,
  .nh-shots__key a:focus-visible .nh-shots__label {
    text-decoration: underline;
  }

  .nh-shots__chip {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.3rem;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .nh-shots__pin:hover,
  .nh-shots__pin:focus-visible,
  .nh-shots__pin:global(.is-active) {
    transform: translate(-50%, -50%) scale(1.25);
    background: var(--sl-color-orange);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--sl-color-orange) 30%, transparent);
    outline: none;
  }

  .nh-shots__key a:hover .nh-shots__chip,
  .nh-shots__key a:focus-visible .nh-shots__chip,
  .nh-shots__chip:global(.is-active) {
    background: var(--sl-color-orange);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-orange) 30%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nh-shots__pin,
    .nh-shots__chip {
      transition: none;
    }
  }
</style>

<script>
  const figure = document.getElementById("usage-screenshots");
  const refs = [...document.querySelectorAll<HTMLElement>(".nh-shot-ref[data-shot-ref]")];
  const smooth = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
  const storageKey = "nahpu-docs:screenshot-size";

  // Show one screen size at a time. The choice follows the reader across pages; the first
  // visit starts from the size that matches their viewport.
  if (figure) {
    const switcher = figure.querySelector<HTMLElement>(".nh-shots__switch");
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>(".nh-shots__switch button")];
    const panels = [...figure.querySelectorAll<HTMLElement>(".nh-shots__panel")];

    const readSaved = () => {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };

    const show = (screen: string, save: boolean) => {
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.screen === screen));
      }
      for (const panel of panels) {
        panel.classList.toggle("is-current", panel.dataset.screen === screen);
      }
      if (!save) return;
      try {
        localStorage.setItem(storageKey, screen);
      } catch {
        // Storage can be unavailable; the switch still works for this page.
      }
    };

    const saved = readSaved();
    const initial =
      saved === "large" || saved === "small"
        ? saved
        : matchMedia("(max-width: 40rem)").matches
          ? "small"
          : "large";
    show(initial, false);
    figure.classList.add("is-switchable");
    switcher?.removeAttribute("hidden");
    for (const button of buttons) {
      button.addEventListener("click", () => show(button.dataset.screen ?? "large", true));
    }
  }

  // The first mention of each letter in the text becomes the target of its pin and key entry.
  for (const ref of refs) {
    const target = `shot-ref-${ref.dataset.shotRef}`;
    if (!document.getElementById(target)) ref.id = target;
  }

  const highlightTargets = (id: string) =>
    document.querySelectorAll<HTMLElement>(
      `.nh-shots__pin[data-shot-ref="${id}"], .nh-shots__key [data-shot-ref="${id}"] .nh-shots__chip, .nh-shot-ref[data-shot-ref="${id}"]`,
    );

  const setActive = (id: string, active: boolean) =>
    highlightTargets(id).forEach((el) => el.classList.toggle("is-active", active));

  const flash = (id: string) => {
    setActive(id, true);
    setTimeout(() => setActive(id, false), 1600);
  };

  const linked = document.querySelectorAll<HTMLElement>("[data-shot-ref]");
  for (const el of linked) {
    const id = el.dataset.shotRef;
    if (!id) continue;
    el.addEventListener("mouseenter", () => setActive(id, true));
    el.addEventListener("mouseleave", () => setActive(id, false));
    el.addEventListener("focus", () => setActive(id, true));
    el.addEventListener("blur", () => setActive(id, false));
    el.addEventListener("click", (event) => {
      event.preventDefault();
      const toFigure = el.classList.contains("nh-shot-ref");
      const destination = toFigure ? figure : document.getElementById(`shot-ref-${id}`);
      destination?.scrollIntoView({ behavior: smooth, block: toFigure ? "start" : "center" });
      flash(id);
    });
  }
</script>
