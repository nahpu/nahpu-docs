    crates: { x: 12, y: 656, w: 336, h: 104 },
  },
  edges: [
    { x1: l, y1: 96, x2: l, y2: 128 },
    { x1: 172, y1: 161, x2: 188, y2: 161 },
    { x1: l, y1: 194, x2: l, y2: 226 },
    { x1: l, y1: 292, x2: l, y2: 324 },
    { x1: l, y1: 428, x2: l, y2: 460 },
    { x1: r, y1: 428, x2: r, y2: 460 },
    { x1: l, y1: 526, x2: l, y2: 558 },
    { x1: r, y1: 526, x2: r, y2: 558 },
    { x1: r, y1: 624, x2: r, y2: 656 },
  ],
  boundary: { x1: 180, x2: 356, y: 542 },
  legend: { x: 20, y: 782, vertical: false },
};

const legendItems: { tone: Tone; label: string }[] = [
  { tone: "dart", label: "Flutter / Dart" },
  { tone: "rust", label: "Rust" },
  { tone: "data", label: "On-device data" },
];

interface Chip {
  label: string;
  x: number;
  y: number;
  w: number;
}

// Lay chips out left to right, wrapping when a row runs past maxW.
function wrapChips(labels: string[], x: number, y: number, maxW: number, charW: number): Chip[] {
  const chips: Chip[] = [];
  let cx = x;
  let cy = y;
  for (const label of labels) {
    const w = Math.round(label.length * charW + 16);
    if (cx + w > x + maxW && cx > x) {
      cx = x;
      cy += 26;
    }
    chips.push({ label, x: cx, y: cy, w });
    cx += w + 6;
  }
  return chips;
}

// Triangle at the end of a straight connector pointing from (x1,y1) to (x2,y2).
function arrowHead(x1: number, y1: number, x2: number, y2: number, size = 6): string {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p = (da: number) =>
    `${(x2 - size * Math.cos(a + da)).toFixed(1)},${(y2 - size * Math.sin(a + da)).toFixed(1)}`;
  return `${x2},${y2} ${p(0.5)} ${p(-0.5)}`;
}

// Resolve text, badge width, and chip positions for each node in a layout.
function place(layout: Layout) {
  return nodes.map((n) => {
    const b = layout.boxes[n.id];
    const text: NodeText = { title: n.title, path: n.path, sub: n.sub, chips: n.chips, ...b.text };
    const badge =
      layout.badges && n.badge
        ? { label: n.badge.toUpperCase(), w: Math.round(n.badge.length * 6.6 + 14) }
        : null;
    let chips = text.chips
      ? wrapChips(text.chips, b.x + 14, b.y + 50, b.w - 24, layout.chipCharW)
      : [];
    if (n.id === "app" && chips.length) {
      // Platform chips: right-aligned on wide, below the title on narrow.
      if (layout.name === "wide") {
        const last = chips[chips.length - 1];
        const shift = b.x + b.w - 16 - (last.x + last.w);
        chips = chips.map((c) => ({ ...c, x: c.x + shift, y: b.y + (b.h - 22) / 2 }));
      } else {
        chips = chips.map((c) => ({ ...c, y: b.y + 52 }));
      }
    }
    return { ...n, ...b, text, badge, chips };
  });
}

const layouts = [wide, narrow].map((layout) => ({ ...layout, placed: place(layout) }));
---

<figure class="nahpu-arch not-content">
  <div class="card">
    {
      layouts.map((layout) => (
        <svg
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          class={`diagram ${layout.name}`}
          role="img"
          aria-label="NAHPU software architecture: Flutter screens, providers, and services over a Drift SQLite database and a Rust API bridged with flutter_rust_bridge"
        >
          <g>
            {layout.edges.map((e) => (
              <g>
                <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="edge" stroke-width="1.75" />
                <polygon points={arrowHead(e.x1, e.y1, e.x2, e.y2)} class="arrow" />
                {e.label && (
                  <text x={e.x1 + 12} y={(e.y1 + e.y2) / 2 + 4} font-size="11.5" class="edge-label">
                    {e.label}
                  </text>
                )}
              </g>
            ))}
            <line
              x1={layout.boundary.x1}
              x2={layout.boundary.x2}
              y1={layout.boundary.y}
              y2={layout.boundary.y}
              class="boundary"
              stroke-width="1.25"
              stroke-dasharray="2 5"
              stroke-linecap="round"
            />
            <text
              x={layout.boundary.x2 - 2}
              y={layout.boundary.y - 5}
              text-anchor="end"
              font-size={layout.name === "wide" ? 11 : 9.5}
              letter-spacing="0.08em"
              class="boundary-label"
            >
              DART ⇄ RUST · FFI
            </text>
          </g>

          {layout.placed.map((n) => (
            <g class={`node tone-${n.tone}`}>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="14" class="box" stroke-width="1.5" />
              <text
                x={n.x + (n.id === "app" ? 18 : 14)}
                y={n.y + (n.id === "app" ? 26 : 24)}
                font-size={n.id === "app" ? 18 : layout.name === "wide" ? 15 : 14}
                class="title"
              >
                {n.text.title}
              </text>
              {n.text.path && (
                <text
                  x={n.x + 14}
                  y={n.y + 41}
                  font-size={layout.name === "wide" ? 11.5 : 10}
                  class="path"
                >
                  {n.text.path}
                </text>
              )}
              {n.text.sub && (
                <text
                  x={n.x + (n.id === "app" ? 18 : 14)}
                  y={n.y + (n.id === "app" ? 45 : 57)}
                  font-size={layout.name === "wide" ? 12 : 11}
                  class="sub"
                >
                  {n.text.sub}
                </text>
              )}
              {n.badge && (
                <g>
                  <rect
                    x={n.x + n.w - n.badge.w - 12}
                    y={n.y + 11}
                    width={n.badge.w}
                    height="18"
                    rx="9"
                    class="badge"
                  />
                  <text
                    x={n.x + n.w - n.badge.w / 2 - 12}
                    y={n.y + 23.5}
                    text-anchor="middle"
                    font-size="9.5"
                    letter-spacing="0.06em"
                    class="badge-text"
                  >
                    {n.badge.label}
                  </text>
                </g>
              )}
              {n.chips.map((c) => (
                <g>
                  <rect x={c.x} y={c.y} width={c.w} height="20" rx="10" class="chip" stroke-width="1" />
                  <text
                    x={c.x + c.w / 2}
                    y={c.y + 14}
                    text-anchor="middle"
                    font-size={layout.name === "wide" ? 11 : 10}
                    class="chip-text"
                  >
                    {c.label}
                  </text>
                </g>
              ))}
            </g>
          ))}

          <g font-size={layout.name === "wide" ? 12 : 11}>
            {legendItems.map((item, k) => {
              const x = layout.legend.vertical ? layout.legend.x : layout.legend.x + [0, 124, 196][k];
              const y = layout.legend.vertical ? layout.legend.y + k * 24 : layout.legend.y;
              return (
                <g class={`tone-${item.tone}`}>
                  <rect x={x} y={y - 10} width="12" height="12" rx="3.5" class="swatch" />
                  <text x={x + 20} y={y} class="legend-label">
                    {item.label}
                  </text>
                </g>
              );
            })}
          </g>
        </svg>
      ))
    }
  </div>
  <figcaption>
    Screens stay thin, workflows live in services, and heavy lifting goes to Rust.
  </figcaption>
</figure>

