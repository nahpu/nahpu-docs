---
// Static NAHPU architecture diagram for the contributing "Architecture" page.
// The design matches the architecture figure on hhandika.com, without motion
// or interaction. Two layouts share one node list: a wide one for larger
// screens and a stacked one for phones.

type Tone = "dart" | "rust" | "data" | "app";

interface NodeText {
  title: string;
  path?: string;
  sub?: string;
  chips?: string[];
}

interface NodeDef extends NodeText {
  id: string;
  tone: Tone;
  badge?: string;
}

