---
/// A hand-drawn tres leches cake for the About page. The cake is shown in
/// three-quarter view with a wedge cut away, so NAHPU's four architecture
/// layers appear on the cut face. A bowl of dough beside it stands for the
/// student scratch repository. Wobbly outlines come from SVG displacement
/// filters, and colours use the site's silver-tree and golden-grass tokens so
/// the drawing adapts to light and dark modes.
---

<figure class="nh-cake-figure">
  <svg
    class="nh-cake-svg"
    viewBox="0 0 460 440"
    fill="none"
    role="img"
    aria-label="Hand-drawn tres leches cake with a slice cut away to reveal four layers: 1. User interface (Flutter), 2. Workflows (Dart services), 3. Core engine (Rust, NAHPU API), and 4. Local storage (SQLite and files). Beside it, a bowl of dough represents the student scratch repository for practice and prototyping."
  >
    <defs>
      <!-- Hand-drawn wobble: two seeds so the double strokes never align. -->
      <filter id="nh-sketch" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.035"
          numOctaves="2"
          seed="3"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="3"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
      <filter id="nh-sketch-alt" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.05"
          numOctaves="2"
          seed="11"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="4"
          xChannelSelector="G"
          yChannelSelector="R"></feDisplacementMap>
      </filter>

      <!-- Pencil hatching for shading -->
      <pattern
        id="nh-hatch"
        width="6"
        height="6"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(40)"
      >
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="6"
          stroke="var(--cake-stroke)"
          stroke-width="1.1"
          stroke-linecap="round"></line>
      </pattern>

      <!-- Cake geometry: centre (165, 92), radii 130 x 36, height 150. -->
      <path
        id="nh-plate"
        d="M7 246 C 9 222, 90 200, 165 200 C 244 200, 325 220, 323 246 C 321 272, 240 292, 165 292 C 86 292, 5 272, 7 246 Z"
      ></path>
      <path
        id="nh-wall-r"
        d="M295 92 A130 36 0 0 1 239.6 121.5 L239.6 271.5 A130 36 0 0 0 295 242 Z"
      ></path>
      <path
        id="nh-wall-l"
        d="M90.4 121.5 A130 36 0 0 1 35 92 L35 242 A130 36 0 0 0 90.4 271.5 Z"
      ></path>
      <path id="nh-top" d="M165 92 L90.4 121.5 A130 36 0 1 1 239.6 121.5 Z"
      ></path>
      <path id="nh-face-r" d="M165 92 L239.6 121.5 L239.6 271.5 L165 242 Z"
      ></path>
      <path id="nh-face-l" d="M165 92 L90.4 121.5 L90.4 271.5 L165 242 Z"
      ></path>
      <path id="nh-r1" d="M165 92 L239.6 121.5 L239.6 145.5 L165 116 Z"></path>
      <path id="nh-r2" d="M165 116 L239.6 145.5 L239.6 189.5 L165 160 Z"
      ></path>
      <path id="nh-r3" d="M165 160 L239.6 189.5 L239.6 229.5 L165 200 Z"
      ></path>
      <path id="nh-r4" d="M165 200 L239.6 229.5 L239.6 271.5 L165 242 Z"
      ></path>
      <path id="nh-l1" d="M165 92 L90.4 121.5 L90.4 145.5 L165 116 Z"></path>
      <path id="nh-l2" d="M165 116 L90.4 145.5 L90.4 189.5 L165 160 Z"></path>
      <path id="nh-l3" d="M165 160 L90.4 189.5 L90.4 229.5 L165 200 Z"></path>
      <path id="nh-l4" d="M165 200 L90.4 229.5 L90.4 271.5 L165 242 Z"></path>

      <path
        id="nh-bowl"
        d="M42 372 C 44 408, 82 430, 118 430 C 156 430, 192 408, 196 372 Z"
      ></path>
      <path
        id="nh-dough"
        d="M54 374 C 52 358, 70 344, 90 348 C 100 332, 128 330, 140 344 C 158 338, 182 350, 184 374 Z"
      ></path>

      <clipPath id="nh-clip-face-r"><use href="#nh-face-r"></use></clipPath>
      <clipPath id="nh-clip-face-l"><use href="#nh-face-l"></use></clipPath>
      <clipPath id="nh-clip-walls">
        <use href="#nh-wall-r"></use>
        <use href="#nh-wall-l"></use>
      </clipPath>
      <clipPath id="nh-clip-bowl"><use href="#nh-bowl"></use></clipPath>
    </defs>

    <!-- Serving plate -->
    <use
      href="#nh-plate"
      fill="var(--cake-plate)"
      filter="url(#nh-sketch-alt)"
      transform="translate(2.5 2.5)"></use>
    <g
      filter="url(#nh-sketch)"
      stroke="var(--cake-stroke)"
      stroke-width="1.8"
      stroke-linecap="round"
    >
      <use href="#nh-plate"></use>
      <path
        d="M24 250 C 40 274, 110 286, 165 286 C 230 286, 300 272, 308 250"
        stroke-width="1"
        opacity="0.45"></path>
    </g>

    <!-- Colour washes, slightly off-register like marker under ink -->
    <g filter="url(#nh-sketch-alt)" transform="translate(2 2)">
      <use href="#nh-wall-r" fill="var(--cake-frosting)"></use>
      <use href="#nh-wall-l" fill="var(--cake-frosting)"></use>
      <use href="#nh-r1" fill="var(--cake-cream)"></use>
      <use href="#nh-l1" fill="var(--cake-cream)"></use>
      <use href="#nh-r2" fill="var(--cake-sponge)"></use>
      <use href="#nh-l2" fill="var(--cake-sponge)"></use>
      <use href="#nh-r3" fill="var(--cake-soak)"></use>
      <use href="#nh-l3" fill="var(--cake-soak)"></use>
      <use href="#nh-r4" fill="var(--cake-base)"></use>
      <use href="#nh-l4" fill="var(--cake-base)"></use>
      <use href="#nh-top" fill="var(--cake-frosting)"></use>
      <use href="#nh-bowl" fill="var(--cake-bowl)"></use>
      <use href="#nh-dough" fill="var(--cake-dough)"></use>
    </g>

    <!-- Shading and texture -->
    <g filter="url(#nh-sketch)">
      <!-- Shadowed side of the cake and the left cut face -->
      <rect
        x="258"
        y="80"
        width="44"
        height="200"
        fill="url(#nh-hatch)"
        clip-path="url(#nh-clip-walls)"
        opacity="0.35"></rect>
      <rect
        x="80"
        y="90"
        width="90"
        height="190"
        fill="url(#nh-hatch)"
        clip-path="url(#nh-clip-face-l)"
        opacity="0.22"></rect>
      <rect
        x="40"
        y="396"
        width="160"
        height="40"
        fill="url(#nh-hatch)"
        clip-path="url(#nh-clip-bowl)"
        opacity="0.3"></rect>

      <!-- Spatula marks in the frosting -->
      <g
        stroke="var(--cake-frosting-mark)"
        stroke-width="1.4"
        stroke-linecap="round"
      >
        <path d="M48 150 C 47 176, 49 204, 48 228"></path>
        <path d="M66 162 C 65 186, 67 214, 66 240"></path>
        <path d="M274 150 C 275 178, 273 206, 274 232"></path>
      </g>

      <!-- Whipped cream band: soft swirls on the cut face -->
      <g
        stroke="var(--cake-cream-mark)"
        stroke-width="1.2"
        stroke-linecap="round"
      >
        <path d="M176 108 C 186 106, 194 114, 204 114"></path>
        <path d="M212 120 C 220 118, 226 126, 234 126"></path>
        <path d="M152 108 C 142 108, 134 116, 122 116"></path>
      </g>

      <!-- Sponge crumb holes -->
      <g
        stroke="var(--cake-sponge-pore)"
        stroke-width="1.3"
        stroke-linecap="round"
      >
        <circle cx="180" cy="136" r="2.2"></circle>
        <circle cx="198" cy="150" r="2.8"></circle>
        <circle cx="222" cy="152" r="2"></circle>
        <circle cx="214" cy="168" r="2.6"></circle>
        <circle cx="186" cy="160" r="1.8"></circle>
        <circle cx="232" cy="176" r="2.2"></circle>
        <circle cx="150" cy="138" r="2.4"></circle>
        <circle cx="128" cy="154" r="2.8"></circle>
        <circle cx="104" cy="164" r="2"></circle>
        <circle cx="140" cy="166" r="1.8"></circle>
        <circle cx="112" cy="178" r="2.2"></circle>
      </g>

      <!-- Milk soak: wavy lines and droplets -->
      <g
        stroke="var(--cake-soak-stroke)"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <path d="M168 182 C 182 180, 190 194, 204 192 S 226 202, 236 206"
        ></path>
        <path d="M162 182 C 148 180, 140 194, 126 192 S 104 202, 94 206"
        ></path>
      </g>
      <g fill="var(--cake-soak-stroke)" opacity="0.75">
        <circle cx="190" cy="206" r="1.8"></circle>
        <circle cx="220" cy="214" r="1.5"></circle>
        <circle cx="136" cy="208" r="1.8"></circle>
        <circle cx="110" cy="216" r="1.4"></circle>
      </g>

      <!-- Biscuit base: storage ticks -->
      <g
        stroke="var(--cake-base-accent)"
        stroke-width="2.4"
        stroke-linecap="round"
      >
        <path d="M176 230 L 200 239"></path>
        <path d="M208 242 L 220 247" opacity="0.6"></path>
        <path d="M154 230 L 130 239"></path>
        <path d="M122 242 L 110 247" opacity="0.6"></path>
      </g>

      <!-- Cinnamon dusting on top -->
      <g fill="var(--cake-cinnamon)">
        <circle cx="120" cy="96" r="1.2"></circle>
        <circle cx="146" cy="84" r="1"></circle>
        <circle cx="190" cy="80" r="1.2"></circle>
        <circle cx="214" cy="94" r="1"></circle>
        <circle cx="236" cy="86" r="1.3"></circle>
        <circle cx="96" cy="88" r="1"></circle>
        <circle cx="170" cy="74" r="1"></circle>
        <circle cx="128" cy="76" r="1.1"></circle>
      </g>

      <!-- Dough folds and flour specks -->
      <g
        stroke="var(--cake-dough-stroke)"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <path d="M78 362 C 86 354, 98 354, 104 360"></path>
        <path d="M118 348 C 126 344, 134 346, 138 352"></path>
        <path d="M146 364 C 154 358, 166 360, 170 366"></path>
      </g>
      <g fill="var(--cake-flour)">
        <circle cx="96" cy="368" r="1.4"></circle>
        <circle cx="126" cy="360" r="1.2"></circle>
        <circle cx="160" cy="354" r="1.4"></circle>
        <circle cx="70" cy="366" r="1.1"></circle>
      </g>
      <path
        d="M52 390 C 96 398, 142 398, 188 390"
        stroke="var(--cake-bowl-accent)"
        stroke-width="3"
        stroke-linecap="round"></path>
    </g>

    <!-- Ink outlines: a primary pass and a lighter second pass -->
    <g
      stroke="var(--cake-stroke)"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <g filter="url(#nh-sketch)" stroke-width="1.8">
        <use href="#nh-wall-r"></use>
        <use href="#nh-wall-l"></use>
        <use href="#nh-face-r"></use>
        <use href="#nh-face-l"></use>
        <use href="#nh-top"></use>
        <!-- Layer seams on the cut faces -->
        <g stroke-width="1.2">
          <path d="M90.4 145.5 L165 116 L239.6 145.5"></path>
          <path d="M90.4 189.5 L165 160 L239.6 189.5"></path>
          <path
            d="M90.4 229.5 L165 200 L239.6 229.5"
            stroke="var(--cake-soak-stroke)"></path>
        </g>
        <use href="#nh-bowl"></use>
        <use href="#nh-dough" stroke="var(--cake-dough-stroke)"></use>
        <path
          d="M38 372 C 40 366, 196 365, 200 372 C 198 378, 42 379, 38 372 Z"
          fill="var(--cake-bowl-rim)"></path>
      </g>
      <g
        filter="url(#nh-sketch-alt)"
        stroke-width="1.1"
        opacity="0.4"
        transform="translate(-1.2 1)"
      >
        <use href="#nh-wall-r"></use>
        <use href="#nh-wall-l"></use>
        <use href="#nh-top"></use>
        <use href="#nh-bowl"></use>
      </g>
    </g>

    <!-- Piped cream border along the base -->
    <g
      filter="url(#nh-sketch)"
      fill="var(--cake-frosting)"
      stroke="var(--cake-stroke)"
      stroke-width="1.2"
    >
      <circle cx="294.7" cy="242.5" r="5"></circle>
      <circle cx="291.7" cy="248.1" r="5"></circle>
      <circle cx="285.5" cy="253.5" r="5.2"></circle>
      <circle cx="276.4" cy="258.5" r="5.4"></circle>
      <circle cx="264.6" cy="263.1" r="5.4"></circle>
      <circle cx="250.3" cy="267.2" r="5.6"></circle>
      <circle cx="36.3" cy="245" r="5"></circle>
      <circle cx="40.7" cy="250.5" r="5"></circle>
      <circle cx="48.2" cy="255.8" r="5.2"></circle>
      <circle cx="58.5" cy="260.6" r="5.4"></circle>
      <circle cx="71.5" cy="265" r="5.4"></circle>
      <circle cx="86.8" cy="268.8" r="5.6"></circle>
    </g>

    <!-- Whipped cream dollops with golden berries on top -->
    <g
      filter="url(#nh-sketch)"
      stroke="var(--cake-stroke)"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <g fill="var(--cake-frosting)">
        <path
          d="M64 108 C 62 98, 72 94, 76 96 C 80 92, 90 96, 86 106 C 82 112, 66 112, 64 108 Z"
        ></path>
        <path
          d="M50 94 C 48 84, 58 80, 62 82 C 66 78, 76 82, 72 92 C 68 98, 52 98, 50 94 Z"
        ></path>
        <path
          d="M64 79 C 62 69, 72 65, 76 67 C 80 63, 90 67, 86 77 C 82 83, 66 83, 64 79 Z"
        ></path>
        <path
          d="M102 69 C 100 59, 110 55, 114 57 C 118 53, 128 57, 124 67 C 120 73, 104 73, 102 69 Z"
        ></path>
        <path
          d="M206 69 C 204 59, 214 55, 218 57 C 222 53, 232 57, 228 67 C 224 73, 208 73, 206 69 Z"
        ></path>
        <path
          d="M244 79 C 242 69, 252 65, 256 67 C 260 63, 270 67, 266 77 C 262 83, 246 83, 244 79 Z"
        ></path>
        <path
          d="M258 94 C 256 84, 266 80, 270 82 C 274 78, 284 82, 280 92 C 276 98, 260 98, 258 94 Z"
        ></path>
        <path
          d="M244 108 C 242 98, 252 94, 256 96 C 260 92, 270 96, 266 106 C 262 112, 246 112, 244 108 Z"
        ></path>
      </g>
      <g fill="var(--cake-berry)" stroke-width="1.1">
        <circle cx="76" cy="94" r="3.4"></circle>
        <circle cx="114" cy="55" r="3.4"></circle>
        <circle cx="256" cy="65" r="3.4"></circle>
        <circle cx="256" cy="94" r="3.4"></circle>
        <circle cx="62" cy="80" r="3"></circle>
      </g>
    </g>

    <!-- Mint leaf garnish at the back -->
    <g
      filter="url(#nh-sketch)"
      stroke="var(--cake-stroke)"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M165 66 C 165 50, 181 41, 194 43 C 192 56, 180 66, 165 66 Z"
        fill="var(--cake-leaf)"></path>
      <path d="M167 64 C 175 56, 183 50, 191 46" stroke-width="0.9"></path>
      <path
        d="M165 66 C 159 53, 147 47, 136 50 C 139 60, 151 67, 165 66 Z"
        fill="var(--cake-leaf-light)"></path>
      <path d="M163 64 C 155 58, 147 54, 139 52" stroke-width="0.9"></path>
      <circle cx="165" cy="68" r="4" fill="var(--cake-berry)"></circle>
    </g>

    <!-- Wooden spoon resting in the dough -->
    <path
      d="M146 356 L 202 318 C 206 316, 210 321, 207 324 L 152 362"
      fill="var(--cake-spoon)"
      stroke="var(--cake-stroke)"
      stroke-width="1.6"
      stroke-linejoin="round"
      filter="url(#nh-sketch)"></path>

    <!-- Callouts from the cut face to the labels -->
    <g filter="url(#nh-sketch)" stroke-linecap="round">
      <g fill="var(--cake-leader-dot)" stroke="var(--cake-stroke)">
        <circle cx="209.8" cy="121.7" r="3"></circle>
        <circle cx="209.8" cy="155.7" r="3"></circle>
        <circle cx="209.8" cy="197.7" r="3"></circle>
        <circle cx="209.8" cy="238.7" r="3"></circle>
      </g>
      <g stroke="var(--cake-leader)" stroke-width="1.4" stroke-dasharray="4 3">
        <path d="M214 121.7 C 260 120, 290 123, 324 121.7"></path>
        <path d="M214 155.7 C 260 154, 290 157, 324 155.7"></path>
        <path
          d="M214 197.7 C 260 196, 290 199, 324 197.7"
          stroke="var(--cake-soak-stroke)"></path>
        <path d="M214 238.7 C 260 237, 290 240, 324 238.7"></path>
      </g>
      <g stroke="var(--cake-stroke)" stroke-width="1.4">
        <circle cx="338" cy="121.7" r="11.5" fill="var(--cake-badge-bg)"
        ></circle>
        <circle cx="338" cy="155.7" r="11.5" fill="var(--cake-badge-bg)"
        ></circle>
        <circle cx="338" cy="197.7" r="11.5" fill="var(--cake-badge-gold)"
        ></circle>
        <circle cx="338" cy="238.7" r="11.5" fill="var(--cake-badge-bg)"
        ></circle>
      </g>
    </g>

    <g>
      <text x="338" y="125.7" text-anchor="middle" class="nh-cake-num">1</text>
      <text x="356" y="118.7" class="nh-cake-label">User interface</text>
      <text x="356" y="132.7" class="nh-cake-sub">Flutter</text>

      <text x="338" y="159.7" text-anchor="middle" class="nh-cake-num">2</text>
      <text x="356" y="152.7" class="nh-cake-label">Workflows</text>
      <text x="356" y="166.7" class="nh-cake-sub">Dart services</text>

      <text x="338" y="201.7" text-anchor="middle" class="nh-cake-num-gold"
        >3</text
      >
      <text x="356" y="194.7" class="nh-cake-label">Core engine</text>
      <text x="356" y="208.7" class="nh-cake-sub">Rust · NAHPU API</text>

      <text x="338" y="242.7" text-anchor="middle" class="nh-cake-num">4</text>
      <text x="356" y="235.7" class="nh-cake-label">Local storage</text>
      <text x="356" y="249.7" class="nh-cake-sub">SQLite &amp; files</text>
    </g>

    <!-- Student scratch repository: the bowl of dough -->
    <g
      filter="url(#nh-sketch)"
      stroke="var(--cake-leader)"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M224 352 C 248 346, 268 330, 280 304" stroke-dasharray="4 4"
      ></path>
      <path d="M271 308 L 281 302 L 284 313"></path>
    </g>
    <text x="222" y="376" class="nh-cake-label">Student scratch repository</text>
    <text x="222" y="393" class="nh-cake-sub">
      Practice, experiments, and prototypes
    </text>
    <text x="222" y="407" class="nh-cake-sub">
      that can be baked into any layer
    </text>
  </svg>
</figure>

<style>
  .nh-cake-figure {
    --cake-frosting: #fdfcf7;
    --cake-frosting-mark: var(--color-silver-tree-200);
    --cake-cream: var(--color-golden-grass-50);
    --cake-cream-mark: var(--color-golden-grass-300);
    --cake-sponge: var(--color-silver-tree-200);
    --cake-sponge-pore: var(--color-silver-tree-500);
    --cake-soak: var(--color-golden-grass-100);
    --cake-soak-stroke: var(--color-golden-grass-600);
    --cake-base: var(--color-silver-tree-600);
    --cake-base-accent: var(--color-silver-tree-100);
    --cake-cinnamon: var(--color-golden-grass-700);
    --cake-berry: var(--color-golden-grass-400);
    --cake-plate: var(--color-silver-tree-50);
    --cake-stroke: var(--color-silver-tree-800);
    --cake-leaf: var(--color-silver-tree-600);
    --cake-leaf-light: var(--color-silver-tree-400);
    --cake-leader: var(--color-silver-tree-500);
    --cake-leader-dot: #ffffff;
    --cake-badge-bg: var(--color-silver-tree-700);
    --cake-badge-text: var(--color-silver-tree-50);
    --cake-badge-gold: var(--color-golden-grass-600);
    --cake-badge-gold-text: #ffffff;
    --cake-label: var(--color-silver-tree-950);
    --cake-sub: var(--color-silver-tree-700);
    --cake-bowl: var(--color-silver-tree-300);
    --cake-bowl-rim: var(--color-silver-tree-200);
    --cake-bowl-accent: var(--color-silver-tree-500);
    --cake-dough: var(--color-golden-grass-50);
    --cake-dough-stroke: var(--color-golden-grass-700);
    --cake-flour: var(--color-golden-grass-400);
    --cake-spoon: color-mix(
      in srgb,
      var(--color-golden-grass-300) 60%,
      #a0703c
    );

    margin: 0;
  }

  :global([data-theme="dark"]) .nh-cake-figure {
    --cake-frosting: var(--color-silver-tree-100);
    --cake-frosting-mark: var(--color-silver-tree-300);
    --cake-cream: var(--color-golden-grass-100);
    --cake-cream-mark: var(--color-golden-grass-500);
    --cake-sponge: var(--color-silver-tree-600);
    --cake-sponge-pore: var(--color-silver-tree-200);
    --cake-soak: var(--color-golden-grass-700);
    --cake-soak-stroke: var(--color-golden-grass-300);
    --cake-base: var(--color-silver-tree-900);
    --cake-base-accent: var(--color-silver-tree-300);
    --cake-cinnamon: var(--color-golden-grass-800);
    --cake-berry: var(--color-golden-grass-400);
    --cake-plate: var(--color-silver-tree-800);
    --cake-stroke: var(--color-silver-tree-950);
    --cake-leaf: var(--color-silver-tree-500);
    --cake-leaf-light: var(--color-silver-tree-300);
    --cake-leader: var(--color-silver-tree-400);
    --cake-leader-dot: var(--color-silver-tree-100);
    --cake-badge-bg: var(--color-silver-tree-400);
    --cake-badge-text: var(--color-silver-tree-950);
    --cake-badge-gold: var(--color-golden-grass-400);
    --cake-badge-gold-text: var(--color-golden-grass-950);
    --cake-label: var(--color-silver-tree-50);
    --cake-sub: var(--color-silver-tree-300);
