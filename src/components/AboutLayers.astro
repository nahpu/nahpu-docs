---
/// A lay-friendly, layered-cake (tres leches) illustration of NAHPU's
/// architecture and student scratch repository for the About page. Uses the
/// site's silver-tree and golden-grass theme tokens so it adapts cleanly to
/// light and dark modes.
---

<figure class="nh-cake-figure">
  <svg
    class="nh-cake-svg"
    viewBox="0 0 460 392"
    fill="none"
    role="img"
    aria-label="Illustration of NAHPU built in four stacked layers like a tres leches cake: 1. User interface (Flutter), 2. Application workflows (Dart), 3. Core engine (Rust), and 4. Local storage (SQLite and files), supported by a student scratch repository for practice and prototyping."
  >
    <defs>
      <linearGradient id="nh-cake-topping" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--cake-topping-top)"></stop>
        <stop offset="100%" stop-color="var(--cake-topping-bottom)"></stop>
      </linearGradient>
      <linearGradient id="nh-cake-sponge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--cake-sponge-top)"></stop>
        <stop offset="100%" stop-color="var(--cake-sponge-bottom)"></stop>
      </linearGradient>
      <linearGradient id="nh-cake-soak" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--cake-soak-top)"></stop>
        <stop offset="100%" stop-color="var(--cake-soak-bottom)"></stop>
      </linearGradient>
      <linearGradient id="nh-cake-base" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--cake-base-top)"></stop>
        <stop offset="100%" stop-color="var(--cake-base-bottom)"></stop>
      </linearGradient>
    </defs>

    <!-- Serving plate -->
    <ellipse
      cx="178"
      cy="288"
      rx="156"
      ry="20"
      fill="var(--cake-plate-shadow)"
      opacity="0.45"
    ></ellipse>
    <ellipse
      cx="178"
      cy="283"
      rx="150"
      ry="17"
      fill="var(--cake-plate)"
      stroke="var(--cake-stroke)"
      stroke-width="1.6"
    ></ellipse>
    <ellipse
      cx="178"
      cy="283"
      rx="126"
      ry="11"
      fill="none"
      stroke="var(--cake-stroke)"
      stroke-width="1"
      opacity="0.45"
    ></ellipse>

    <!-- Layer 4: Local storage (base resting on the plate) -->
    <path
      d="M54 234 H302 V271 C302 278 296 283 288 283 H68 C60 283 54 278 54 271 Z"
      fill="url(#nh-cake-base)"
      stroke="var(--cake-stroke)"
      stroke-width="1.6"
    ></path>
    <!-- Subtle storage disk lines -->
    <line
      x1="74"
      y1="258"
      x2="132"
      y2="258"
      stroke="var(--cake-base-accent)"
      stroke-width="3"
      stroke-linecap="round"
      opacity="0.7"
    ></line>
    <line
      x1="144"
      y1="258"
      x2="178"
      y2="258"
      stroke="var(--cake-base-accent)"
      stroke-width="3"
      stroke-linecap="round"
      opacity="0.45"
    ></line>
    <circle cx="282" cy="258" r="4" fill="var(--cake-base-accent)" opacity="0.8"
    ></circle>

    <!-- Layer 3: Core engine (Rust) -->
    <rect
      x="54"
      y="180"
      width="248"
      height="50"
      rx="8"
      fill="url(#nh-cake-soak)"
      stroke="var(--cake-soak-stroke)"
      stroke-width="1.6"
    ></rect>
    <!-- Milk-soak wave inside layer 3 -->
    <path
      d="M56 205 C 94 195, 132 214, 174 204 C 216 194, 254 213, 300 202 V226 C300 228 298 229 295 229 H61 C58 229 56 228 56 226 Z"
      fill="var(--cake-soak-wave)"
      opacity="0.45"
    ></path>
    <circle cx="96" cy="216" r="2.5" fill="var(--cake-soak-stroke)" opacity="0.5"
    ></circle>
    <circle
      cx="148"
      cy="218"
      r="2"
      fill="var(--cake-soak-stroke)"
      opacity="0.45"
    ></circle>
    <circle
      cx="222"
      cy="215"
      r="2.6"
      fill="var(--cake-soak-stroke)"
      opacity="0.5"
    ></circle>
    <circle
      cx="266"
      cy="219"
      r="2"
      fill="var(--cake-soak-stroke)"
      opacity="0.45"
    ></circle>

    <!-- Layer 2: Application workflows -->
    <rect
      x="54"
      y="122"
      width="248"
      height="54"
      rx="8"
      fill="url(#nh-cake-sponge)"
      stroke="var(--cake-stroke)"
      stroke-width="1.6"
    ></rect>
    <!-- Sponge pores -->
    <g fill="var(--cake-sponge-pore)" opacity="0.55">
      <circle cx="82" cy="142" r="2.4"></circle>
      <circle cx="116" cy="156" r="3"></circle>
      <circle cx="152" cy="138" r="2.2"></circle>
      <circle cx="188" cy="154" r="2.8"></circle>
      <circle cx="224" cy="140" r="2.4"></circle>
      <circle cx="264" cy="156" r="2.8"></circle>
      <circle cx="282" cy="138" r="2"></circle>
      <circle cx="96" cy="164" r="1.8"></circle>
      <circle cx="206" cy="164" r="1.8"></circle>
    </g>

    <!-- Layer 1: User interface -->
    <path
      d="M54 96
         C54 78, 72 68, 94 72
         C108 58, 134 56, 152 68
         C168 54, 198 54, 214 68
         C232 58, 258 60, 270 72
         C290 70, 302 80, 302 96
         V116
         C294 123, 282 123, 272 116
         C262 124, 246 124, 236 116
         C224 124, 206 124, 194 116
         C182 124, 164 124, 152 116
         C140 124, 122 124, 110 116
         C98 124, 82 124, 72 116
         C64 121, 58 120, 54 116 Z"
      fill="url(#nh-cake-topping)"
      stroke="var(--cake-stroke)"
      stroke-width="1.6"
      stroke-linejoin="round"
    ></path>
    <!-- Topping gloss -->
    <path
      d="M84 82 C104 72, 132 72, 148 80"
      stroke="var(--cake-gloss)"
      stroke-width="2.5"
      stroke-linecap="round"
      opacity="0.7"
    ></path>

    <!-- Botanical leaf garnish on top -->
    <path
      d="M178 58 C178 42, 194 34, 206 36 C204 49, 192 58, 178 58 Z"
      fill="var(--cake-leaf)"
    ></path>
    <path
      d="M178 58 C172 46, 160 40, 150 43 C153 53, 165 59, 178 58 Z"
      fill="var(--cake-leaf-light)"
    ></path>

    <!-- Layer callouts on the right -->
    <g>
      <!-- 1: User interface -->
      <line
        x1="306"
        y1="94"
        x2="328"
        y2="94"
        stroke="var(--cake-leader)"
        stroke-width="1.4"
        stroke-dasharray="3 3"
      ></line>
      <circle cx="342" cy="94" r="11.5" fill="var(--cake-badge-bg)"></circle>
      <text x="342" y="98" text-anchor="middle" class="nh-cake-num">1</text>
      <text x="361" y="91" class="nh-cake-label">User interface</text>
      <text x="361" y="105" class="nh-cake-sub">Flutter</text>

      <!-- 2: Workflows -->
      <line
        x1="306"
        y1="149"
        x2="328"
        y2="149"
        stroke="var(--cake-leader)"
        stroke-width="1.4"
        stroke-dasharray="3 3"
      ></line>
      <circle cx="342" cy="149" r="11.5" fill="var(--cake-badge-bg)"></circle>
      <text x="342" y="153" text-anchor="middle" class="nh-cake-num">2</text>
      <text x="361" y="146" class="nh-cake-label">Workflows</text>
      <text x="361" y="160" class="nh-cake-sub">Dart services</text>

      <!-- 3: Core engine -->
      <line
        x1="306"
        y1="205"
        x2="328"
        y2="205"
        stroke="var(--cake-soak-stroke)"
        stroke-width="1.4"
        stroke-dasharray="3 3"
      ></line>
      <circle cx="342" cy="205" r="11.5" fill="var(--cake-badge-gold)"></circle>
      <text x="342" y="209" text-anchor="middle" class="nh-cake-num-gold"
        >3</text
      >
      <text x="361" y="202" class="nh-cake-label">Core engine</text>
      <text x="361" y="216" class="nh-cake-sub">Rust · NAHPU API</text>

      <!-- 4: Local storage -->
      <line
        x1="306"
        y1="259"
        x2="328"
        y2="259"
        stroke="var(--cake-leader)"
        stroke-width="1.4"
        stroke-dasharray="3 3"
      ></line>
      <circle cx="342" cy="259" r="11.5" fill="var(--cake-badge-bg)"></circle>
      <text x="342" y="263" text-anchor="middle" class="nh-cake-num">4</text>
      <text x="361" y="256" class="nh-cake-label">Local storage</text>
      <text x="361" y="270" class="nh-cake-sub">SQLite &amp; files</text>
    </g>

    <!-- Student scratch repository below the plate -->
    <line
      x1="178"
      y1="328"
      x2="178"
      y2="306"
      stroke="var(--cake-leader)"
      stroke-width="1.5"
      stroke-dasharray="3 3"
    ></line>
    <polygon points="178,302 173,310 183,310" fill="var(--cake-leader)"
    ></polygon>

    <rect
      x="28"
      y="330"
      width="404"
      height="50"
      rx="12"
      fill="var(--cake-sandbox-bg)"
      stroke="var(--cake-leader)"
      stroke-width="1.4"
      stroke-dasharray="5 4"
    ></rect>
    <text x="46" y="352" class="nh-cake-label">
      Student scratch repository
    </text>
    <text x="46" y="369" class="nh-cake-sub">
      Practice, experimentation, and feature prototyping across any layer
    </text>
  </svg>
</figure>

<style>
  .nh-cake-figure {
    --cake-topping-top: #fdfcf7;
    --cake-topping-bottom: var(--color-silver-tree-100);
    --cake-sponge-top: var(--color-silver-tree-200);
    --cake-sponge-bottom: var(--color-silver-tree-300);
    --cake-sponge-pore: var(--color-silver-tree-500);
    --cake-soak-top: var(--color-golden-grass-100);
    --cake-soak-bottom: var(--color-golden-grass-200);
    --cake-soak-wave: var(--color-golden-grass-300);
    --cake-soak-stroke: var(--color-golden-grass-600);
    --cake-base-top: var(--color-silver-tree-600);
    --cake-base-bottom: var(--color-silver-tree-700);
    --cake-base-accent: var(--color-silver-tree-100);
    --cake-plate: var(--color-silver-tree-50);
    --cake-plate-shadow: var(--color-silver-tree-300);
    --cake-stroke: var(--color-silver-tree-600);
    --cake-gloss: #ffffff;
    --cake-leaf: var(--color-silver-tree-600);
    --cake-leaf-light: var(--color-silver-tree-400);
    --cake-leader: var(--color-silver-tree-500);
    --cake-badge-bg: var(--color-silver-tree-700);
    --cake-badge-text: var(--color-silver-tree-50);
    --cake-badge-gold: var(--color-golden-grass-600);
    --cake-badge-gold-text: #ffffff;
    --cake-label: var(--color-silver-tree-950);
    --cake-sub: var(--color-silver-tree-700);
    --cake-sandbox-bg: color-mix(
      in srgb,
      var(--color-silver-tree-50) 80%,
      transparent
    );

    margin: 0;
  }

  :global([data-theme="dark"]) .nh-cake-figure {
    --cake-topping-top: var(--color-silver-tree-200);
    --cake-topping-bottom: var(--color-silver-tree-300);
    --cake-sponge-top: var(--color-silver-tree-700);
    --cake-sponge-bottom: var(--color-silver-tree-800);
    --cake-sponge-pore: var(--color-silver-tree-400);
    --cake-soak-top: var(--color-golden-grass-800);
    --cake-soak-bottom: var(--color-golden-grass-900);
    --cake-soak-wave: var(--color-golden-grass-600);
    --cake-soak-stroke: var(--color-golden-grass-400);
    --cake-base-top: var(--color-silver-tree-800);
    --cake-base-bottom: var(--color-silver-tree-950);
    --cake-base-accent: var(--color-silver-tree-300);
    --cake-plate: var(--color-silver-tree-800);
    --cake-plate-shadow: var(--color-silver-tree-950);
    --cake-stroke: var(--color-silver-tree-400);
    --cake-gloss: var(--color-silver-tree-50);
    --cake-leaf: var(--color-silver-tree-400);
    --cake-leaf-light: var(--color-silver-tree-300);
    --cake-leader: var(--color-silver-tree-400);
    --cake-badge-bg: var(--color-silver-tree-400);
    --cake-badge-text: var(--color-silver-tree-950);
    --cake-badge-gold: var(--color-golden-grass-400);
    --cake-badge-gold-text: var(--color-golden-grass-950);
    --cake-label: var(--color-silver-tree-50);
    --cake-sub: var(--color-silver-tree-300);
    --cake-sandbox-bg: color-mix(
      in srgb,
      var(--color-silver-tree-950) 65%,
      transparent
    );
  }

  .nh-cake-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .nh-cake-num {
    fill: var(--cake-badge-text);
    font-size: 11px;
    font-weight: 700;
  }

  .nh-cake-num-gold {
    fill: var(--cake-badge-gold-text);
    font-size: 11px;
    font-weight: 700;
  }

  .nh-cake-label {
    fill: var(--cake-label);
    font-size: 12px;
    font-weight: 600;
  }

  .nh-cake-sub {
    fill: var(--cake-sub);
    font-size: 10.5px;
  }
</style>
