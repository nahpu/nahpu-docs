---
interface Props {
  /// Letter of a `{% pin /%}` in the page's `{% screenshots %}` figure.
  id: string;
}

const { id } = Astro.props;
---

<a class="nh-shot-ref" href="#usage-screenshots" data-shot-ref={id}>{id}</a>

<style>
  .nh-shot-ref {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    margin-inline: 0.125rem;
    padding-inline: 0.3rem;
    vertical-align: 0.125rem;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--color-silver-tree-50, #f3faf7);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 6rem);
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .nh-shot-ref:hover,
  .nh-shot-ref:focus-visible,
  .nh-shot-ref:global(.is-active) {
    background: var(--sl-color-orange);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-orange) 30%, transparent);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nh-shot-ref {
      transition: none;
    }
  }
</style>
