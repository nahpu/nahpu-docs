---
import cntl from "cntl";
import { profileLinks, type ProfileIcon } from "../data/team";
import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"team">["data"];
  /// Announced by screen readers so a page full of cards is navigable.
  ownerName: string;
}

const { data, ownerName } = Astro.props as Props;
const links = profileLinks(data);

const linkClasses = cntl`
  inline-flex h-9 w-9 items-center justify-center
  rounded-lg
  text-silver-tree-600 dark:text-silver-tree-400
  transition-colors duration-200
  hover:bg-silver-tree-200/70 hover:text-silver-tree-900
  dark:hover:bg-silver-tree-800/70 dark:hover:text-silver-tree-50
  focus-visible:outline-2 focus-visible:outline-offset-2
  focus-visible:outline-silver-tree-600
  dark:focus-visible:outline-silver-tree-400
`;

/// Single-path glyphs, drawn on a 24x24 grid to match the arrow icon already
/// used elsewhere in the team card.
const strokeIcons: Partial<Record<ProfileIcon, string>> = {
  website:
    "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18M3 12h18M12 3c2.4 2.5 3.7 5.6 3.7 9s-1.3 6.5-3.7 9c-2.4-2.5-3.7-5.6-3.7-9S9.6 5.5 12 3",
  scholar: "M12 4 2 9l10 5 10-5-10-5M6 11.5V17c0 1.66 2.69 3 6 3s6-1.34 6-3v-5.5",
};

const filledIcons: Partial<Record<ProfileIcon, string>> = {
  github:
    "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z",
  linkedin:
    "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.65h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.65c0-1.35-.03-3.08-1.9-3.08-1.9 0-2.19 1.46-2.19 2.98V21h-4V9z",
  researchgate:
    "M13.9 3.5c1.9 0 3.3.4 4.2 1.3.9.9 1.4 2.1 1.4 3.6 0 1.4-.4 2.6-1.3 3.5-.7.7-1.6 1.2-2.7 1.4l4 6.7h-3.2l-3.6-6.3h-1.6v6.3H8.4V3.5h5.5zm-2.8 2.3v5.6h2.3c1 0 1.8-.2 2.3-.7.5-.5.8-1.2.8-2.1s-.3-1.6-.8-2.1c-.5-.5-1.3-.7-2.3-.7h-2.3zM4.6 3.5v3.1H2.3V3.5h2.3zm0 5.2v12.3H2.3V8.7h2.3z",
  orcid:
    "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8.2 6.1a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM7.3 9.5h1.8v8.2H7.3V9.5zm3.6 0h3.2c3 0 4.4 2.1 4.4 4.1 0 2.2-1.7 4.1-4.4 4.1h-3.2V9.5zm1.8 1.6v5h1.3c1.9 0 2.7-1.1 2.7-2.5 0-1.5-.9-2.5-2.7-2.5h-1.3z",
};
---

{
  links.length > 0 && (
    <ul class="mt-auto flex flex-wrap items-center gap-1 pt-4 -mb-1 -ml-2 list-none p-0">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClasses}
            aria-label={`${ownerName} on ${link.label}`}
            title={link.label}
          >
            {strokeIcons[link.icon] ? (
              <svg
                class="h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={strokeIcons[link.icon]} />
              </svg>
            ) : (
              <svg
                class="h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={filledIcons[link.icon]} />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
