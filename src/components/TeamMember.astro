---
import { Image } from "astro:assets";
import "../styles/global.css";
import cntl from "cntl";
import ProfileLinks from "./ProfileLinks.astro";
import { nameInitials, primaryUrl } from "../data/team";
import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"team">["data"];
  photoSrc?: string | null;
}

const { data, photoSrc } = Astro.props as Props;
const { name, institution, featured } = data;
const roles = data.role ? [data.role].flat() : [];
const href = primaryUrl(data);
const hasPhoto = !!photoSrc;
const initials = nameInitials(name);

const cardClasses = cntl`
  nh-reveal
  group
  relative flex flex-col
  rounded-2xl
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-50/70 dark:bg-silver-tree-900/50
  p-6
  transition-all duration-300
  hover:-translate-y-0.5
  hover:border-silver-tree-500
  hover:shadow-lg hover:shadow-silver-tree-500/10
  focus-within:border-silver-tree-500
`;

const avatarClasses = cntl`
  flex h-14 w-14 shrink-0 items-center justify-center
  rounded-2xl
  bg-linear-to-br from-silver-tree-400 via-silver-tree-500 to-golden-grass-400
  text-base font-bold text-white
  shadow-md
  transition-transform duration-300
  group-hover:scale-105
`;

const nameClasses = cntl`
  text-lg font-semibold
  text-silver-tree-900 dark:text-silver-tree-50
  no-underline
`;

const nameLinkClasses = cntl`
  text-silver-tree-900 dark:text-silver-tree-50
  no-underline
  transition-colors
  hover:text-silver-tree-700 dark:hover:text-silver-tree-200
`;

const institutionClasses = cntl`
  mt-0.5 text-sm
  text-silver-tree-700 dark:text-silver-tree-300
`;

const bioClasses = cntl`
  mt-4 text-sm leading-relaxed
  text-silver-tree-700 dark:text-silver-tree-300
  [&_p]:m-0 [&_p+p]:mt-3
  [&_a]:text-silver-tree-800 dark:[&_a]:text-silver-tree-100
  [&_a]:underline [&_a]:underline-offset-2
`;

const roleBadgeClasses = cntl`
  mt-3 inline-flex w-fit items-center gap-1.5
  rounded-full
  bg-golden-grass-100 dark:bg-golden-grass-950
  px-2.5 py-0.5
  text-[11px] font-medium
  text-golden-grass-900 dark:text-golden-grass-200
`;
---

<article class={`${cardClasses} ${featured ? "sm:col-span-2" : ""}`}>
  <div class="flex items-start gap-4">
    {
      hasPhoto ? (
        <Image
          src={photoSrc!}
          alt=""
          width={112}
          height={112}
          class="h-14 w-14 shrink-0 rounded-2xl object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class={avatarClasses} aria-hidden="true">
          {initials}
        </span>
      )
    }

    <div class="min-w-0">
      <h3 class={nameClasses}>
        {
          href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class={nameLinkClasses}
            >
              {name}
            </a>
          ) : (
            name
          )
        }
      </h3>
      <p class={institutionClasses}>{institution}</p>
      {
        roles.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {roles.map((label) => (
              <span class={roleBadgeClasses}>
                <span class="h-1.5 w-1.5 rounded-full bg-golden-grass-500" />
                {label}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <div class={bioClasses}>
    <slot />
  </div>

  <ProfileLinks data={data} ownerName={name} />
</article>
