---
import { getImage } from "astro:assets";
import landscape from "../../assets/images/landscapes/handika-mt-bandahara.webp";

/// Blurred NAHPU colour field with the field landscape overlaid on top of it,
/// and a contour map of Gede-Pangrango along the foot of the hero.
///
/// The map is the mountain the Get Started page carries as a skyline, seen
/// from above and north-up: Pangrango, the higher and steeper cone, to the
/// north-west, Gede to the south-east with its crater notched out of the
/// summit, and the saddle between them low enough that the pair only join
/// under 2400 m. Ridges on either side keep the two from sitting alone in the
/// middle of the sheet.
///
/// It fills the width at the foot of the hero and carries up towards the copy,
/// where a fade takes the lines out rather than an edge cutting them: the
/// sheet is whole along its top, and only the bottom and the two sides run off
/// the frame. The interval is 200 m and the 2000 and 3000 m lines are heavier
/// as index contours, but this is decoration, not a survey — the scale is one
/// where only part of the pair fits the screen.

const wide = await getImage({
    src: landscape,
    width: 2400,
    format: "webp",
    quality: 78,
});
const narrow = await getImage({
    src: landscape,
    width: 1200,
    format: "webp",
    quality: 72,
});
---

<div class="nh-hero-bg" aria-hidden="true">
    <div class="nh-blob nh-blob-teal"></div>
    <div class="nh-blob nh-blob-gold"></div>
    <div class="nh-blob nh-blob-deep"></div>

    <img
        class="nh-hero-photo"
        src={wide.src}
        srcset={`${narrow.src} 1200w, ${wide.src} 2400w`}
        sizes="100vw"
        width={wide.attributes?.width ?? 2400}
        height={wide.attributes?.height ?? 1170}
        alt=""
        loading="eager"
        decoding="async"
    />

    <div class="nh-hero-scrim"></div>

    <svg
        class="nh-hero-contours"
        viewBox="0 0 1200 420"
        preserveAspectRatio="xMidYMin slice"
        fill="none"
    >
        <defs>
            <linearGradient id="nh-contour" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--nh-contour-1)"></stop>
                <stop offset="55%" stop-color="var(--nh-contour-2)"></stop>
                <stop offset="100%" stop-color="var(--nh-contour-3)"></stop>
            </linearGradient>
        </defs>

        <g
            stroke="url(#nh-contour)"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
