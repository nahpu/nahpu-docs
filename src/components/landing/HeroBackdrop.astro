            <!-- Three elevations, each set at the angle of the line it
                 belongs to and in the gap beside it, so that nothing crosses a
                 contour. They sit low on the sheet, where the fade has let the
                 lines come up to full strength, and come out about the 12px of
                 the capability text above. -->
            <g
                class="nh-hero-elev"
                stroke="none"
                font-size="11"
                letter-spacing="0.8"
                text-anchor="middle"
                dominant-baseline="central"
