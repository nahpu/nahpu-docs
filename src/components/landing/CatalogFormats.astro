---
import cntl from "cntl";

/// Catalog formats NAHPU ships, plus the ones still being built.
type Format = {
    name: string;
    color: string;
    status: "available" | "development";
    glyph: "mammal" | "bird" | "herp" | "insect" | "fish" | "fossil";
};

const formats: Format[] = [
    {
        name: "Mammalogy",
        color: "#2f9e7d",
        status: "available",
        glyph: "mammal",
    },
    {
        name: "Ornithology",
        color: "#3f9fd6",
        status: "available",
        glyph: "bird",
    },
    {
        name: "Herpetology",
        color: "#7c72d8",
        status: "available",
        glyph: "herp",
    },
    {
        name: "Entomology",
        color: "#e0913a",
        status: "available",
        glyph: "insect",
    },
    {
        name: "Ichthyology",
        color: "#3c8fa8",
        status: "development",
        glyph: "fish",
    },
    {
        name: "Paleontology",
        color: "#b07a56",
        status: "development",
        glyph: "fossil",
    },
];

const cardClasses = cntl`
  nh-taxon-card
  nh-reveal
  relative
  flex items-center gap-4
  rounded-2xl
  border border-silver-tree-300/70 dark:border-silver-tree-700/70
  bg-silver-tree-50/70 dark:bg-silver-tree-900/50
  p-5
  transition-all duration-300
  hover:-translate-y-0.5
  hover:border-silver-tree-500
  hover:shadow-lg hover:shadow-silver-tree-500/10
`;

const statusClasses = cntl`
  inline-flex items-center gap-1.5
  rounded-full
  px-2.5 py-0.5
  text-[11px] font-medium
  whitespace-nowrap
`;

const availableClasses = cntl`
  bg-silver-tree-200 text-silver-tree-800
  dark:bg-silver-tree-800 dark:text-silver-tree-100
`;

const developmentClasses = cntl`
  bg-golden-grass-100 text-golden-grass-900
  dark:bg-golden-grass-950 dark:text-golden-grass-200
`;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
        formats.map((format, index) => (
            <article
                class={cardClasses}
                style={`transition-delay: ${index * 60}ms`}
            >
                <span
                    class="nh-taxon-glyph flex h-12 w-12 shrink-0 items-center justify-center rounded-xl"
                    style={`background: color-mix(in srgb, ${format.color} 16%, transparent); color: ${format.color}`}
                >
                    <svg
                        viewBox="0 0 24 24"
                        class="h-8 w-8"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        {format.glyph === "mammal" && (
                            <g>
                                <ellipse cx="9.8" cy="15" rx="6.2" ry="4.2" />
                                <circle cx="16.4" cy="12.2" r="3.2" />
                                <circle cx="14.8" cy="8.2" r="2.4" />
                                <path d="M19.2 11.4 22.8 12.8 19.2 14.2z" />
                                <path
                                    d="M4 15.4c-2.6.4-3.2 4.8.6 5.1"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </g>
                        )}
                        {format.glyph === "bird" && (
                            <g>
                                <path d="M1.6 17.8 8 12.6l1.4 3.4z" />
                                <ellipse
                                    cx="11.8"
                                    cy="13.2"
                                    rx="5.4"
                                    ry="4.4"
                                />
                                <circle cx="16.6" cy="8.2" r="3" />
                                <path d="M19.2 7.4 22.8 8.6 19.2 9.8z" />
                                <path
                                    d="M11.4 17.4v3.2M14 17v3.6"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </g>
                        )}
                        {format.glyph === "herp" && (
                            <g>
                                <path d="M3.6 17.6c0-4 3.7-7 8.4-7s8.4 3 8.4 7c0 1.1-.5 1.9-1.4 1.9H5c-.9 0-1.4-.8-1.4-1.9z" />
                                <circle cx="8.2" cy="8.4" r="3" />
                                <circle cx="15.8" cy="8.4" r="3" />
                                <path
                                    d="M4.6 19.5 2.4 21.6M19.4 19.5l2.2 2.1"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </g>
                        )}
                        {format.glyph === "insect" && (
                            <g>
                                <ellipse cx="12" cy="14" rx="4.6" ry="6.6" />
                                <circle cx="12" cy="6.4" r="2.6" />
                                <path
                                    d="M10.4 4.4 8.4 2.2M13.6 4.4l2-2.2M7.4 10.4 3.6 8.6M7.2 14H3M7.4 17.6l-3.6 2M16.6 10.4l3.8-1.8M16.8 14H21M16.6 17.6l3.6 2"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </g>
                        )}
                        {format.glyph === "fish" && (
                            <g>
                                <path d="M6.6 12c2.9-3.8 6.9-5.4 10.1-5.4 2.8 0 4.6 2.4 5.3 5.4-.7 3-2.5 5.4-5.3 5.4-3.2 0-7.2-1.6-10.1-5.4z" />
                                <path d="M6.2 12 2 7.8v8.4z" />
                                <circle
                                    cx="18.4"
                                    cy="10.6"
                                    r="1"
                                    opacity="0.4"
                                />
                            </g>
                        )}
                        {format.glyph === "fossil" && (
                            <g
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                            >
                                <path d="M12 21a9 9 0 1 0-8.5-12" />
                                <path d="M12 16.6a4.6 4.6 0 1 0-4.2-6.5" />
                                <path d="M3.5 9 1.4 7.8M6.6 6.2 5.4 4.2M10.4 4.4 10 2.2" />
                            </g>
                        )}
                    </svg>
                </span>

                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base font-semibold text-silver-tree-900 dark:text-silver-tree-50">
                        {format.name}
                    </h3>
                    <span
                        class={`${statusClasses} ${format.status === "available" ? availableClasses : developmentClasses}`}
                    >
                        <span
                            class="h-1.5 w-1.5 rounded-full"
                            style={`background:${format.status === "available" ? format.color : "var(--color-golden-grass-500)"}`}
                        />
                        {format.status === "available"
                            ? "Available"
                            : "In development"}
                    </span>
                </div>
            </article>
        ))
    }
</div>
