---
// Day One record map: how a paper field catalog maps to a NAHPU project, its
// narrative, sites, events, and specimens, and which records are shared across
// projects. The artwork and node geometry are shared with the NAHPU app
// (see `src/assets/day-one/`); the page supplies every word, so translations
// stay in the Day One source.
import art from "../../assets/day-one/record-map.svg?raw";
import figures from "../../assets/day-one/figures.json";

interface RecordNode {
  id: string;
  title: string;
  summary: string;
  detail: string;
  paper?: string;
}

interface Props {
  label: string;
  hint: string;
  nodes: RecordNode[];
}

const { label, hint, nodes } = Astro.props;
const { width, height } = figures.recordMap;
const text = new Map(nodes.map((n) => [n.id, n]));
const placed = figures.recordMap.nodes.flatMap((box) => {
  const words = text.get(box.id);
  return words ? [{ ...box, ...words }] : [];
});
const pct = (value: number, total: number) => `${(value / total) * 100}%`;
const detailId = "day-one-record-detail";
---

<figure class="day-one-figure not-content" data-record-map aria-label={label}>
  <div class="card">
    <div class="stage" style={`aspect-ratio: ${width} / ${height}`}>
      <Fragment set:html={art} />
      {
        placed.map((n) => (
          <button
            type="button"
            class={`hotspot tone-${n.tone}`}
            style={`left: ${pct(n.x, width)}; top: ${pct(n.y, height)}; width: ${pct(n.w, width)}; height: ${pct(n.h, height)}`}
            aria-pressed="false"
            aria-controls={detailId}
            data-id={n.id}
            data-title={n.title}
            data-detail={n.detail}
            data-paper={n.paper ?? ""}
          >
            <span class="title">{n.title}</span>
            <span class="sub">{n.summary}</span>
          </button>
        ))
      }
    </div>
    <div class="detail" id={detailId} aria-live="polite">{hint}</div>
  </div>
</figure>

<style>
  .day-one-figure {
    margin: 1.5rem 0;
  }

  .card {
    display: grid;
    gap: 1rem;
    align-items: center;
    border: 1px solid rgb(28 43 33 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.7);
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  @media (min-width: 56rem) {
    .card {
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      padding: 1.25rem;
    }
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
  }

  .stage :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stage :global(.art-paper-section) {
    cursor: pointer;
    transition: filter 150ms ease;
  }
  .stage :global(.art-paper-section.active .art-paper-page) {
    stroke: #8c7355;
    stroke-width: 2;
  }

  .hotspot {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.1rem;
    padding: 0 0.4rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: var(--title);
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: box-shadow 150ms ease;
  }
  .hotspot:hover,
  .hotspot:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--ring);
  }
  .hotspot[aria-pressed="true"] {
    box-shadow: 0 0 0 3px var(--ring);
  }
  .hotspot .title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.2;
  }
  .hotspot .sub {
    max-width: 100%;
    overflow: hidden;
    color: var(--muted);
    font-size: var(--sl-text-xs);
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tone-project,
  .tone-paper {
    justify-content: center;
    align-items: flex-start;
    text-align: left;
  }

  .detail {
    margin: 0;
    min-height: 5.5rem;
    border-radius: 0.75rem;
    background: rgb(243 246 244 / 0.9);
    padding: 0.75rem 1rem;
    color: #283a2e;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .detail :global(strong) {
    display: block;
    color: #1c2b21;
  }
  .detail :global(.paper-note) {
    display: block;
    margin-top: 0.5rem;
    border-top: 1px dashed rgb(140 115 85 / 0.35);
    padding-top: 0.45rem;
    color: #5c4732;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  /* "Canopy" palette: warm parchment for the paper field catalog, forest for
     the project and its places, moss for specimens, and mist for shared data. */
  .tone-paper {
    --title: #3d2e1e;
    --muted: #5c4732;
    --ring: #8c7355;
  }
  .tone-project,
  .tone-place {
    --title: #1c2b21;
    --muted: #33473a;
    --ring: #405847;
  }
  .tone-record {
    --title: #37481f;
    --muted: #415522;
    --ring: #688a2c;
  }
  .tone-shared {
    --title: #323c41;
    --muted: #42535a;
    --ring: #637c86;
  }

  :global([data-theme="dark"]) .card {
    border-color: rgb(226 233 227 / 0.1);
    background: rgb(14 26 18 / 0.4);
  }
  :global([data-theme="dark"]) .detail {
    background: rgb(28 43 33 / 0.8);
    color: #c5d3c8;
  }
  :global([data-theme="dark"]) .detail :global(strong) {
    color: #f3f6f4;
  }
  :global([data-theme="dark"]) .detail :global(.paper-note) {
    border-top-color: rgb(196 173 141 / 0.3);
    color: #d5c7b2;
  }
  :global([data-theme="dark"]) .tone-paper {
    --title: #f5efe2;
    --muted: #d5c7b2;
    --ring: #c4ad8d;
  }
  :global([data-theme="dark"]) .tone-project,
  :global([data-theme="dark"]) .tone-place {
    --title: #f3f6f4;
    --muted: #9db3a3;
    --ring: #9db3a3;
  }
  :global([data-theme="dark"]) .tone-record {
    --title: #f5f9eb;
    --muted: #d3e4a9;
    --ring: #9bbf4f;
  }
  :global([data-theme="dark"]) .tone-shared {
    --title: #f4f7f8;
    --muted: #cdd9dd;
    --ring: #a9bcc2;
  }
  :global([data-theme="dark"]) .stage :global(.art-paper) {
    fill: #262019;
    stroke: #8c7355;
  }
  :global([data-theme="dark"]) .stage :global(.art-paper-page) {
    fill: #1d1812;
    stroke: #5c4732;
  }
  :global([data-theme="dark"]) .stage :global(.art-paper-section.active .art-paper-page) {
    stroke: #c4ad8d;
  }
  :global([data-theme="dark"]) .stage :global(.art-paper-rule) {
    stroke: #5c4732;
  }
  :global([data-theme="dark"]) .stage :global(.art-paper-stroke),
  :global([data-theme="dark"]) .stage :global(.art-paper-bridge),
  :global([data-theme="dark"]) .stage :global(.art-paper-bridge-head) {
    stroke: #c4ad8d;
  }
  :global([data-theme="dark"]) .stage :global(.art-project) {
    fill: #1c2b21;
    stroke: #53705b;
  }
  :global([data-theme="dark"]) .stage :global(.art-shared) {
    fill: #1e2629;
    stroke: #4f646d;
  }
  :global([data-theme="dark"]) .stage :global(.art-leader) {
    stroke: #637c86;
  }
  :global([data-theme="dark"]) .stage :global(.art-arrow),
  :global([data-theme="dark"]) .stage :global(.art-arrow-head) {
    stroke: #9db3a3;
  }
  :global([data-theme="dark"]) .stage :global(.art-place) {
    fill: #283a2e;
    stroke: #718e78;
  }
  :global([data-theme="dark"]) .stage :global(.art-record) {
    fill: #1c270c;
    stroke: #9bbf4f;
  }
  :global([data-theme="dark"]) .stage :global(.art-shared-node) {
    fill: #323c41;
    stroke: #8199a2;
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-record-map]")) {
    const detail = figure.querySelector<HTMLElement>(".detail");
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>(".hotspot")];
    const paperSections = [...figure.querySelectorAll<SVGGElement>("[data-paper-for]")];

    const selectButton = (button: HTMLButtonElement) => {
      const id = button.dataset.id ?? "";
      for (const other of buttons) {
        other.setAttribute("aria-pressed", String(other === button));
      }
      for (const section of paperSections) {
        section.classList.toggle(
          "active",
          id === "paper" || section.dataset.paperFor === id,
        );
      }
      if (!detail) return;
      const title = document.createElement("strong");
      title.textContent = button.dataset.title ?? "";
      const children: (Node | string)[] = [title, button.dataset.detail ?? ""];
      if (button.dataset.paper) {
        const paper = document.createElement("span");
        paper.className = "paper-note";
        paper.textContent = button.dataset.paper;
        children.push(paper);
      }
      detail.replaceChildren(...children);
    };

    for (const button of buttons) {
      button.addEventListener("click", () => selectButton(button));
    }
    for (const section of paperSections) {
      section.addEventListener("click", () => {
        const target = buttons.find((b) => b.dataset.id === section.dataset.paperFor);
        if (target) selectButton(target);
      });
    }
  }
</script>
