---
// NAHPU architecture diagram for the contributing "Architecture" page.
import LayeredDiagram from "./LayeredDiagram.astro";
import type { Layout, NodeDef } from "./diagram";

const nodes: NodeDef[] = [
    {
        id: "app",
        tone: "app",
        title: "NAHPU app",
        sub: "Flutter + Dart UI · offline-first · one codebase",
        chips: ["iOS", "Android", "macOS", "Windows", "Linux"],
    },
    {
        id: "screens",
        tone: "dart",
        badge: "Dart",
        title: "Screens",
        path: "lib/screens/",
        sub: "Page-level UI",
    },
    {
        id: "shared",
        tone: "dart",
        badge: "Dart",
        title: "Shared widgets",
        path: "lib/screens/shared/",
        sub: "Reusable controls",
    },
    {
        id: "providers",
        tone: "dart",
        badge: "Riverpod",
        title: "Providers",
        path: "lib/services/providers/",
        sub: "Riverpod providers and AsyncNotifiers",
    },
    {
        id: "services",
        tone: "dart",
        badge: "Dart",
        title: "Services",
        path: "lib/services/",
        chips: [
            "database queries",
            "validation",
            "media",
            "maps",
            "transfers",
            "imports",
            "exports",
            "templates",
            "platform IO",
        ],
    },
    {
        id: "drift",
        tone: "data",
        badge: "SQLite",
        title: "Drift + SQLite",
        path: "lib/services/database/",
        sub: "Canonical project database",
    },
    {
        id: "bindings",
        tone: "dart",
        badge: "FRB",
        title: "Bridge bindings",
        path: "lib/src/rust/",
        sub: "Generated by flutter_rust_bridge",
    },
    {
        id: "storage",
        tone: "data",
        badge: "Device",
        title: "Local storage",
        path: "nahpu.db · media · backups",
        sub: "Works without a network",
    },
    {
        id: "wrappers",
        tone: "rust",
        badge: "Rust",
        title: "Rust wrappers",
        path: "rust/src/api/",
        sub: "Thin, bridge-facing layer",
    },
    {
        id: "crates",
        tone: "rust",
        badge: "Rust",
        title: "NAHPU API workspace",
        path: "nahpu_api · reusable crates",
        chips: ["archive", "configs", "db", "dp", "dwc", "export", "gis"],
    },
];

const L = 240; // left column centre (wide)
const R = 720; // right column centre (wide)
const wide: Layout = {
    name: "wide",
    width: 960,
    height: 716,
    badges: true,
    chipCharW: 6.4,
    boxes: {
        app: { x: 40, y: 16, w: 880, h: 60 },
        screens: { x: 40, y: 108, w: 400, h: 66 },
        shared: { x: 520, y: 108, w: 400, h: 66 },
        providers: { x: 40, y: 206, w: 880, h: 66 },
        services: { x: 40, y: 304, w: 880, h: 84 },
        drift: { x: 40, y: 420, w: 400, h: 66 },
        bindings: { x: 520, y: 420, w: 400, h: 66 },
        storage: { x: 40, y: 518, w: 400, h: 66 },
        wrappers: { x: 520, y: 518, w: 400, h: 66 },
        crates: { x: 520, y: 616, w: 400, h: 84 },
    },
    edges: [
        { x1: L, y1: 76, x2: L, y2: 108, label: "render & dispatch actions" },
        { x1: 440, y1: 141, x2: 520, y2: 141 },
        { x1: L, y1: 174, x2: L, y2: 206, label: "watch & update state" },
        { x1: L, y1: 272, x2: L, y2: 304, label: "call domain services" },
        { x1: L, y1: 388, x2: L, y2: 420, label: "Drift queries" },
        { x1: R, y1: 388, x2: R, y2: 420, label: "generated FRB calls" },
        { x1: L, y1: 486, x2: L, y2: 518, label: "canonical project data" },
        { x1: R, y1: 486, x2: R, y2: 518 },
        { x1: R, y1: 584, x2: R, y2: 616, label: "delegate reusable behavior" },
    ],
    boundary: { x1: 520, x2: 920, y: 502 },
    legend: { x: 56, y: 640, vertical: true },
};

const l = 92; // left column centre (narrow)
const r = 268; // right column centre (narrow)
const narrow: Layout = {
    name: "narrow",
    width: 360,
    height: 800,
    badges: false,
    chipCharW: 6,
    boxes: {
        app: {
            x: 12,
            y: 12,
            w: 336,
            h: 84,
            text: { sub: "Flutter + Dart UI · offline-first" },
        },
        screens: { x: 12, y: 128, w: 160, h: 66 },
        shared: { x: 188, y: 128, w: 160, h: 66 },
        providers: { x: 12, y: 226, w: 336, h: 66 },
        services: {
            x: 12,
            y: 324,
            w: 336,
            h: 104,
            text: {
                chips: [
                    "queries",
                    "validation",
                    "media",
                    "maps",
                    "transfers",
                    "imports",
                    "exports",
                    "templates",
                    "IO",
                ],
            },
        },
        drift: {
            x: 12,
            y: 460,
            w: 160,
            h: 66,
            text: { sub: "Canonical store" },
        },
        bindings: {
            x: 188,
            y: 460,
            w: 160,
            h: 66,
            text: { title: "Bindings", sub: "Generated by FRB" },
        },
        storage: {
            x: 12,
            y: 558,
            w: 160,
            h: 66,
            text: { path: "nahpu.db · media", sub: "Works offline" },
        },
        wrappers: {
            x: 188,
            y: 558,
            w: 160,
            h: 66,
            text: { sub: "Thin bridge layer" },
        },
        crates: { x: 12, y: 656, w: 336, h: 104 },
    },
    edges: [
        { x1: l, y1: 96, x2: l, y2: 128 },
        { x1: 172, y1: 161, x2: 188, y2: 161 },
        { x1: l, y1: 194, x2: l, y2: 226 },
        { x1: l, y1: 292, x2: l, y2: 324 },
        { x1: l, y1: 428, x2: l, y2: 460 },
        { x1: r, y1: 428, x2: r, y2: 460 },
        { x1: l, y1: 526, x2: l, y2: 558 },
        { x1: r, y1: 526, x2: r, y2: 558 },
        { x1: r, y1: 624, x2: r, y2: 656 },
    ],
    boundary: { x1: 180, x2: 356, y: 542 },
    legend: { x: 20, y: 782, vertical: false },
};
---

<LayeredDiagram
    nodes={nodes}
    wide={wide}
    narrow={narrow}
    label="NAHPU software architecture: Flutter screens, providers, and services over a Drift SQLite database and a Rust API bridged with flutter_rust_bridge"
    caption="The diagram of the NAHPU modular architecture showing the Flutter/Dart UI and services, data storage, and the Rust API workspace with bridge bindings."
/>
