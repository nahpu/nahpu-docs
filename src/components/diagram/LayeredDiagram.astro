---
// Static layered diagram shared by the contributing pages. Pass the node list
// and its wide and narrow layouts; the wide layout shows on larger screens.
import { arrowHead, legendItems, place, type Layout, type NodeDef } from "./diagram";

interface Props {
  nodes: NodeDef[];
  wide: Layout;
  narrow: Layout;
  label: string;
  caption: string;
}

const { nodes, wide, narrow, label, caption } = Astro.props;
const layouts = [wide, narrow].map((layout) => ({ ...layout, placed: place(nodes, layout) }));
---

<figure class="nahpu-diagram not-content">
  <div class="card">
    {
      layouts.map((layout) => (
        <svg
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          class={`diagram ${layout.name}`}
          role="img"
          aria-label={label}
        >
          <g>
            {layout.edges.map((e) => (
              <g>
                <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="edge" stroke-width="1.75" />
                {e.arrow !== false && (
                  <polygon points={arrowHead(e.x1, e.y1, e.x2, e.y2)} class="arrow" />
                )}
                {e.label && (
                  <text x={e.x1 + 12} y={(e.y1 + e.y2) / 2 + 4} font-size="11.5" class="edge-label">
                    {e.label}
                  </text>
                )}
              </g>
            ))}
            {layout.boundary && (
              <g>
                <line
                  x1={layout.boundary.x1}
                  x2={layout.boundary.x2}
                  y1={layout.boundary.y}
                  y2={layout.boundary.y}
                  class="boundary"
                  stroke-width="1.25"
                  stroke-dasharray="2 5"
                  stroke-linecap="round"
                />
                <text
                  x={layout.boundary.x2 - 2}
                  y={layout.boundary.y - 5}
                  text-anchor="end"
                  font-size={layout.name === "wide" ? 11 : 9.5}
                  letter-spacing="0.08em"
                  class="boundary-label"
                >
                  DART ⇄ RUST · FFI
                </text>
              </g>
            )}
          </g>

          {layout.placed.map((n) => (
            <g class={`node tone-${n.tone}`}>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="14" class="box" stroke-width="1.5" />
              <text
                x={n.x + (n.tone === "app" ? 18 : 14)}
                y={n.y + (n.tone === "app" ? 26 : 24)}
                font-size={n.tone === "app" ? 18 : layout.name === "wide" ? 15 : 14}
                class="title"
              >
                {n.text.title}
              </text>
              {n.text.path && (
                <text
                  x={n.x + 14}
                  y={n.y + 41}
                  font-size={layout.name === "wide" ? 11.5 : 10}
                  class="path"
                >
                  {n.text.path}
                </text>
              )}
              {n.text.sub && (
                <text
                  x={n.x + (n.tone === "app" ? 18 : 14)}
                  y={n.y + (n.tone === "app" ? 45 : 57)}
                  font-size={layout.name === "wide" ? 12 : 11}
                  class="sub"
                >
                  {n.text.sub}
                </text>
              )}
              {n.badge && (
                <g>
                  <rect
                    x={n.x + n.w - n.badge.w - 12}
                    y={n.y + 11}
                    width={n.badge.w}
                    height="18"
                    rx="9"
                    class="badge"
                  />
                  <text
                    x={n.x + n.w - n.badge.w / 2 - 12}
                    y={n.y + 23.5}
                    text-anchor="middle"
                    font-size="9.5"
                    letter-spacing="0.06em"
                    class="badge-text"
                  >
                    {n.badge.label}
                  </text>
                </g>
              )}
              {n.chips.map((c) => (
                <g>
                  <rect x={c.x} y={c.y} width={c.w} height="20" rx="10" class="chip" stroke-width="1" />
                  <text
                    x={c.x + c.w / 2}
                    y={c.y + 14}
                    text-anchor="middle"
                    font-size={layout.name === "wide" ? 11 : 10}
                    class="chip-text"
                  >
                    {c.label}
                  </text>
                </g>
              ))}
            </g>
          ))}

          <g font-size={layout.name === "wide" ? 12 : 11}>
            {legendItems.map((item, k) => {
              const x = layout.legend.vertical ? layout.legend.x : layout.legend.x + [0, 124, 196][k];
              const y = layout.legend.vertical ? layout.legend.y + k * 24 : layout.legend.y;
              return (
                <g class={`tone-${item.tone}`}>
                  <rect x={x} y={y - 10} width="12" height="12" rx="3.5" class="swatch" />
                  <text x={x + 20} y={y} class="legend-label">
                    {item.label}
                  </text>
                </g>
              );
            })}
          </g>
        </svg>
      ))
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* "Canopy" palette, shared with the software figures on hhandika.com. */
  .nahpu-diagram {
    --forest-50: #f3f6f4;
    --forest-100: #e2e9e3;
    --forest-200: #c5d3c8;
    --forest-300: #9db3a3;
    --forest-400: #718e78;
    --forest-500: #53705b;
    --forest-600: #405847;
    --forest-700: #33473a;
    --forest-800: #283a2e;
    --forest-900: #1c2b21;
    --forest-950: #0e1a12;
    --moss-50: #f5f9eb;
    --moss-100: #e8f1d2;
    --moss-200: #d3e4a9;
    --moss-300: #b5d177;
    --moss-400: #9bbf4f;
    --moss-600: #688a2c;
    --moss-700: #506a25;
    --moss-800: #415522;
    --moss-900: #37481f;
    --moss-950: #1c270c;
    --mist-50: #f4f7f8;
    --mist-100: #e4ecee;
    --mist-200: #cdd9dd;
    --mist-300: #a9bcc2;
    --mist-400: #8199a2;
    --mist-500: #637c86;
    --mist-600: #4f646d;
    --mist-700: #42535a;
    --mist-900: #323c41;
    --mist-950: #1e2629;

    margin: 1.5rem 0;
  }

  .card {
    border: 1px solid rgb(28 43 33 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.7);
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  .diagram {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sl-font, sans-serif);
  }

  .diagram.wide {
    display: none;
  }

  @media (min-width: 48rem) {
    .card {
      padding: 1.25rem;
    }
    .diagram.wide {
      display: block;
    }
    .diagram.narrow {
      display: none;
    }
  }

  figcaption {
    margin: 0.75rem auto 0;
    max-width: 48rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .edge {
    stroke: var(--forest-400);
    stroke-dasharray: 4 5;
  }
  .arrow {
    fill: var(--forest-400);
  }
  .edge-label {
    fill: var(--forest-700);
    font-style: italic;
  }
  .boundary {
    stroke: var(--moss-600);
  }
  .boundary-label {
    fill: var(--moss-700);
    font-weight: 600;
  }
  .legend-label {
    fill: var(--forest-800);
  }

  .title {
    font-weight: 600;
  }
  .path,
  .chip-text {
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
  }
  .sub {
    opacity: 0.9;
  }
  .badge-text {
    font-weight: 700;
  }

  /* Tones: box borders and badges reach 3:1 against the card, and text
     reaches 4.5:1 against its fill, in light and dark themes. */
  .tone-dart {
    --box-fill: var(--forest-50);
    --box-stroke: var(--forest-800);
    --title: var(--forest-900);
    --muted: var(--forest-700);
    --badge: var(--forest-600);
    --badge-text: #fff;
    --chip-fill: var(--forest-100);
    --chip-stroke: var(--forest-300);
    --chip-text: var(--forest-800);
    --swatch: var(--forest-800);
  }
  .tone-rust {
    --box-fill: var(--moss-100);
    --box-stroke: var(--moss-600);
    --title: var(--moss-900);
    --muted: var(--moss-800);
    --badge: var(--moss-700);
    --badge-text: #fff;
    --chip-fill: var(--moss-50);
    --chip-stroke: var(--moss-300);
    --chip-text: var(--moss-900);
    --swatch: var(--moss-600);
  }
  .tone-data {
    --box-fill: var(--mist-100);
    --box-stroke: var(--mist-500);
    --title: var(--mist-900);
    --muted: var(--mist-700);
    --badge: var(--mist-600);
    --badge-text: #fff;
    --chip-fill: var(--mist-50);
    --chip-stroke: var(--mist-300);
    --chip-text: var(--mist-900);
    --swatch: var(--mist-500);
  }
  .tone-app {
    --box-fill: var(--forest-700);
    --box-stroke: var(--forest-700);
    --title: #fff;
    --muted: var(--forest-100);
    --badge: var(--moss-400);
    --badge-text: var(--moss-950);
    --chip-fill: var(--forest-600);
    --chip-stroke: var(--forest-500);
    --chip-text: #fff;
    --swatch: var(--forest-700);
  }

  .box {
    fill: var(--box-fill);
    stroke: var(--box-stroke);
  }
  .title {
    fill: var(--title);
  }
  .path,
  .sub {
    fill: var(--muted);
  }
  .badge {
    fill: var(--badge);
  }
  .badge-text {
    fill: var(--badge-text);
  }
  .chip {
    fill: var(--chip-fill);
    stroke: var(--chip-stroke);
  }
  .chip-text {
    fill: var(--chip-text);
  }
  .swatch {
    fill: var(--swatch);
  }

  :global([data-theme="dark"]) .card {
    border-color: rgb(226 233 227 / 0.1);
    background: rgb(14 26 18 / 0.4);
  }
  :global([data-theme="dark"]) .edge {
    stroke: var(--forest-500);
  }
  :global([data-theme="dark"]) .arrow {
    fill: var(--forest-500);
  }
  :global([data-theme="dark"]) .edge-label {
    fill: var(--forest-300);
  }
  :global([data-theme="dark"]) .boundary-label {
    fill: var(--moss-300);
  }
  :global([data-theme="dark"]) .legend-label {
    fill: var(--forest-200);
  }
  :global([data-theme="dark"]) .tone-dart {
    --box-fill: var(--forest-900);
    --box-stroke: var(--forest-500);
    --title: var(--forest-50);
    --muted: var(--forest-300);
    --badge: var(--forest-400);
    --badge-text: var(--forest-950);
    --chip-fill: var(--forest-800);
    --chip-stroke: var(--forest-600);
    --chip-text: var(--forest-100);
    --swatch: var(--forest-500);
  }
  :global([data-theme="dark"]) .tone-rust {
    --box-fill: var(--moss-950);
    --box-stroke: var(--moss-400);
    --title: var(--moss-50);
    --muted: var(--moss-200);
    --badge: var(--moss-400);
    --badge-text: var(--moss-950);
    --chip-fill: var(--moss-900);
    --chip-stroke: var(--moss-700);
    --chip-text: var(--moss-100);
    --swatch: var(--moss-400);
  }
  :global([data-theme="dark"]) .tone-data {
    --box-fill: var(--mist-950);
    --box-stroke: var(--mist-300);
    --title: var(--mist-50);
    --muted: var(--mist-200);
    --badge: var(--mist-400);
    --badge-text: var(--mist-950);
    --chip-fill: var(--mist-900);
    --chip-stroke: var(--mist-700);
    --chip-text: var(--mist-100);
    --swatch: var(--mist-300);
  }
  :global([data-theme="dark"]) .tone-app {
    --box-fill: var(--forest-800);
    --box-stroke: var(--forest-400);
    --chip-fill: var(--forest-700);
    --swatch: var(--forest-400);
  }
</style>
