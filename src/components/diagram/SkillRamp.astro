---
// A training ramp: the roles a new team member takes on, from easiest to
// hardest, and the NAHPU records each role fills. Each row is a button; the
// selected row's detail shows below. Bars grow with the step, echoing a rising
// difficulty curve. The page supplies every word through `skillstep` tags.
interface Step {
  title: string;
  week: string;
  detail: string;
}

interface Props {
  label: string;
  hint: string;
  weekLabel: string;
  steps: Step[];
}

const { label, hint, weekLabel, steps } = Astro.props;
const detailId = "skill-ramp-detail";
const fraction = (index: number) => ((index + 1) / steps.length).toFixed(3);
---

<figure class="ramp not-content" data-skill-ramp aria-label={label}>
  <p class="ramp__hint">{hint}</p>
  <ol class="ramp__rows">
    {
      steps.map((step, index) => (
        <li class="ramp__row">
          <span class="ramp__week">
            {weekLabel} {step.week}
          </span>
          <div class="ramp__track">
            <button
              type="button"
              class="ramp__bar"
              style={`--f: ${fraction(index)}`}
              aria-pressed={String(index === 0)}
              aria-controls={detailId}
              data-week={`${weekLabel} ${step.week}`}
              data-title={step.title}
              data-detail={step.detail}
            >
              <span class="ramp__pill">{step.title}</span>
            </button>
          </div>
        </li>
      ))
    }
  </ol>
  <div class="ramp__detail" id={detailId} aria-live="polite">
    {
      steps[0] && (
        <>
          <div class="ramp__detail-head">
            <span class="ramp__detail-week">{weekLabel} {steps[0].week}</span>
            <strong>{steps[0].title}</strong>
          </div>
          <p class="ramp__detail-body">{steps[0].detail}</p>
        </>
      )
    }
  </div>
</figure>

<style>
  .ramp {
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0 2rem;
    border: 1px solid color-mix(in srgb, var(--color-silver-tree-500) 22%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-silver-tree-50) 78%, white);
    padding: 0.9rem;
    box-shadow: 0 4px 18px rgb(14 37 31 / 0.06);
  }

  @media (min-width: 56rem) {
    .ramp {
      padding: 1.25rem;
    }
  }

  .ramp__hint {
    margin: 0;
    color: var(--color-silver-tree-800);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    line-height: 1.4;
  }

  .ramp__rows {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ramp__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: center;
    margin: 0;
  }

  .ramp__week {
    color: var(--color-silver-tree-800);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .ramp__track {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-silver-tree-200) 42%, transparent);
    padding: 2px;
  }

  .ramp__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    /* Every bar fits the longest label, then grows with the step. */
    --min: min(100%, 15.5rem);
    width: calc(var(--min) + (100% - var(--min)) * var(--f));
    min-height: 2.2rem;
    padding: 0.2rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-silver-tree-300) 65%, white),
      var(--color-silver-tree-500)
    );
    font: inherit;
    cursor: pointer;
    transition:
      box-shadow 150ms ease,
      transform 150ms ease,
      filter 150ms ease;
  }

  .ramp__pill {
    padding: 0.24rem 0.8rem;
    border-radius: 999px;
    background: var(--color-silver-tree-800);
    color: var(--color-silver-tree-50);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .ramp__bar:hover,
  .ramp__bar:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-silver-tree-700);
  }

  .ramp__bar[aria-pressed="true"] {
    background: linear-gradient(
      90deg,
      var(--color-golden-grass-300),
      var(--color-golden-grass-500)
    );
    box-shadow: 0 2px 10px rgb(165 96 3 / 0.25);
  }

  .ramp__bar[aria-pressed="true"] .ramp__pill {
    background: var(--color-golden-grass-900);
    color: var(--color-golden-grass-50);
  }

  .ramp__detail {
    min-height: 4.75rem;
    border: 1px solid color-mix(in srgb, var(--color-silver-tree-500) 20%, transparent);
    border-left: 3.5px solid var(--color-golden-grass-500);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.85);
    padding: 0.8rem 1rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }

  .ramp__detail :global(.ramp__detail-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .ramp__detail :global(.ramp__detail-week) {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-golden-grass-100);
    color: var(--color-golden-grass-900);
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }

  .ramp__detail :global(strong) {
    color: var(--color-silver-tree-950);
  }

  .ramp__detail :global(.ramp__detail-body) {
    margin: 0;
  }

  :global([data-theme="dark"]) .ramp {
    border-color: color-mix(in srgb, var(--color-silver-tree-400) 22%, transparent);
    background: color-mix(in srgb, var(--color-silver-tree-950) 68%, #17181c);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
  }

  :global([data-theme="dark"]) .ramp__hint,
  :global([data-theme="dark"]) .ramp__week {
    color: var(--color-silver-tree-200);
  }

  :global([data-theme="dark"]) .ramp__track {
    background: color-mix(in srgb, var(--color-silver-tree-800) 40%, transparent);
  }

  :global([data-theme="dark"]) .ramp__bar {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-silver-tree-700) 80%, transparent),
      var(--color-silver-tree-500)
    );
  }

  :global([data-theme="dark"]) .ramp__pill {
    background: var(--color-silver-tree-950);
    color: var(--color-silver-tree-100);
  }

  :global([data-theme="dark"]) .ramp__bar:hover,
  :global([data-theme="dark"]) .ramp__bar:focus-visible {
    box-shadow: 0 0 0 2px var(--color-silver-tree-300);
  }

  :global([data-theme="dark"]) .ramp__bar[aria-pressed="true"] {
    background: linear-gradient(
      90deg,
      var(--color-golden-grass-700),
      var(--color-golden-grass-500)
    );
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
  }

  :global([data-theme="dark"]) .ramp__bar[aria-pressed="true"] .ramp__pill {
    background: var(--color-golden-grass-950);
    color: var(--color-golden-grass-100);
  }

  :global([data-theme="dark"]) .ramp__detail {
    border-color: color-mix(in srgb, var(--color-silver-tree-400) 18%, transparent);
    border-left-color: var(--color-golden-grass-400);
    background: rgb(14 37 31 / 0.55);
    color: var(--sl-color-gray-2);
  }

  :global([data-theme="dark"]) .ramp__detail :global(.ramp__detail-week) {
    background: color-mix(in srgb, var(--color-golden-grass-800) 70%, transparent);
    color: var(--color-golden-grass-100);
  }

  :global([data-theme="dark"]) .ramp__detail :global(strong) {
    color: var(--color-silver-tree-50);
  }

  @media (prefers-reduced-motion: reduce) {
    .ramp__bar {
      transition: none;
    }
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-skill-ramp]")) {
    const detail = figure.querySelector<HTMLElement>(".ramp__detail");
    const bars = [...figure.querySelectorAll<HTMLButtonElement>(".ramp__bar")];

    const select = (bar: HTMLButtonElement, focus = false) => {
      for (const other of bars) other.setAttribute("aria-pressed", String(other === bar));
      if (focus) bar.focus();
      if (!detail) return;
      const head = document.createElement("div");
      head.className = "ramp__detail-head";
      const week = document.createElement("span");
      week.className = "ramp__detail-week";
      week.textContent = bar.dataset.week ?? "";
      const title = document.createElement("strong");
      title.textContent = bar.dataset.title ?? "";
      head.append(week, title);

      const body = document.createElement("p");
      body.className = "ramp__detail-body";
      body.textContent = bar.dataset.detail ?? "";

      detail.replaceChildren(head, body);
    };

    for (const [index, bar] of bars.entries()) {
      bar.addEventListener("click", () => select(bar));
      bar.addEventListener("keydown", (event) => {
        let next: number | null = null;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          next = (index + 1) % bars.length;
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          next = (index - 1 + bars.length) % bars.length;
        } else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = bars.length - 1;
        if (next !== null) {
          event.preventDefault();
          select(bars[next], true);
        }
      });
    }
  }
</script>
